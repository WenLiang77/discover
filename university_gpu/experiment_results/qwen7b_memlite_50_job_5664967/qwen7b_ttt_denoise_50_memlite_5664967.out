def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    
    # Normalize raw counts
    scaler = StandardScaler(with_mean=False)
    X_normalized = scaler.fit_transform(X + 1)
    
    # Apply square root transformation for variance stabilization
    X_sqrt = np.sqrt(X_normalized)
    
    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=100, svd_solver='full')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Reconstruct data using inverse PCA
    X_reconstructed = pca.inverse_transform(X_pca)
    
    # Apply exponential to get back to count space
    denoised_X = np.exp(X_reconstructed)
    
    # Ensure non-negativity and finiteness
    denoised_X = np.maximum(denoised_X, 0.0)
    denoised_X = np.nan_to_num(denoised_X, nan=0.0, posinf=np.inf)
    
    return denoised_X
