def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Square root transform to stabilize variance
    X_sqrt = np.sqrt(X + 1)

    # Normalize data
    X_normalized = normalize(X_sqrt, norm='l1', axis=1)

    # Apply SVD for dimensionality reduction
    svd = TruncatedSVD(n_components=min(50, X.shape[1]), random_state=kwargs.get('random_state'))
    X_svd = svd.fit_transform(X_normalized)

    # Reconstruct data using SVD
    X_reconstructed = svd.inverse_transform(X_svd)

    # Square root inverse transformation
    X_denoised = np.square(X_reconstructed)

    # Ensure non-negativity and finite values
    X_denoised = np.maximum(X_denoised, 0.0)

    # Push values < 1 toward zero
    X_denoised[X_denoised < 1] = 0.0

    # Clip values to prevent overflow
    X_denoised = np.clip(X_denoised, 0.0, np.inf)

    # Calculate Poisson loss
    poisson_loss = np.mean(poisson.logpmf(X, mu=X_denoised))

    # Check Poisson constraint
    if poisson_loss < 0.97:
        raise ValueError("Poisson loss does not meet the requirement.")

    return X_denoised
