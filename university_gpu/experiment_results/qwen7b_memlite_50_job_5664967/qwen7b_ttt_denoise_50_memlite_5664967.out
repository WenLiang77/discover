def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)
    
    # Reverse normalization order
    scaler = StandardScaler(with_mean=False, with_std=True)
    X_log = np.log(X + 1)
    X_normalized = scaler.fit_transform(X_log)
    
    # Define the objective function for minimization
    def objective(x, X):
        return np.mean((x - X)**2)
    
    # Constraints
    def constraint(x):
        return x
    
    # Bounds
    bounds = [(0, None) for _ in range(X.shape[1])]
    
    # Initial guess
    x0 = X_normalized.flatten()
    
    # Minimize the objective function with constraints
    result = minimize(objective, x0, method='SLSQP', args=(X_normalized), bounds=bounds, constraints=[{'type': 'ineq', 'fun': constraint}])
    
    # Reshape the result back to the original shape
    denoised_X = result.x.reshape(X.shape)
    
    return denoised_X
