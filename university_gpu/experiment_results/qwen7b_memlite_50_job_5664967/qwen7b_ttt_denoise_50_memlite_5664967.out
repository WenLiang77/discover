def magic_denoise(X, budget_s=400, random_state=None, knn=20, t=1.0, n_pca=50, solver='lbfgs', decay=0.1, knn_max=None, n_jobs=-1):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    scaler = StandardScaler(with_mean=False, with_std=True)
    X_scaled = scaler.fit_transform(X)

    pca = PCA(n_components=n_pca, svd_solver='full', random_state=random_state)
    X_pca = pca.fit_transform(X_scaled)

    nbrs = NearestNeighbors(n_neighbors=knn, radius=t, algorithm='auto', metric='minkowski', p=2, metric_params=None, n_jobs=n_jobs)
    nbrs.fit(X_pca)

    def poisson_loss(params):
        X_pred = np.exp(np.dot(params, X_pca.T))
        return np.sum(poisson.logpmf(X, X_pred))

    initial_guess = np.ones_like(X_pca).flatten()
    result = minimize(poisson_loss, initial_guess, method=solver, jac=None, hess=None, bounds=None, constraints=None, tol=None, callback=None, options={'maxiter': int(budget_s)})
    
    X_pred_pca = np.reshape(result.x, X_pca.shape)
    X_pred_scaled = np.dot(X_pred_pca, pca.components_)
    X_pred = scaler.inverse_transform(X_pred_scaled)
    
    X_pred[X_pred < 0] = 0
    return X_pred
