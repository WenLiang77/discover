def magic_denoise(X, budget_s=400, random_state=None, knn=10, t=1.0, n_pca=10, solver='lbfgs', decay=0.1, knn_max=50, n_jobs=2):
    X = np.asarray(X, dtype=float)
    X[X < 0] = 0
    
    # Reverse normalization order
    X_lognorm = np.log(1 + X)
    
    # Apply square root transformation
    X_sqrt = np.sqrt(X_lognorm)
    
    # Perform PCA
    pca = PCA(n_components=n_pca, svd_solver='full')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Reconstruct data
    X_recon = pca.inverse_transform(X_pca)
    
    # Apply inverse square root transformation
    X_inv_sqrt = X_recon ** 2
    
    # Apply inverse log transformation
    X_hat = np.exp(X_inv_sqrt) - 1
    
    # Clip negative values
    X_hat[X_hat < 0] = 0
    
    # Ensure finiteness and non-negativity
    X_hat[np.isinf(X_hat)] = 0
    X_hat[np.isnan(X_hat)] = 0
    
    # Evaluate Poisson constraint
    poisson_loss = np.mean([poisson.pmf(x, x_hat[i]) for i, x in enumerate(X.flatten())])
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint not met")
    
    return X_hat
