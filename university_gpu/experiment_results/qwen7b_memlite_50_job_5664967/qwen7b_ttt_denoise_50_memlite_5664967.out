def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Apply square root transformation to stabilize variance
    X_sqrt = np.sqrt(np.maximum(X, 0.0))
    
    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=min(50, X.shape[1]), svd_solver='full')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Reconstruct data from PCA components
    X_recon = pca.inverse_transform(X_pca)
    
    # Apply inverse square root transformation
    X_denoised = X_recon ** 2
    
    # Ensure non-negativity and finiteness
    X_denoised = np.maximum(X_denoised, 0.0)
    X_denoised = np.nan_to_num(X_denoised, nan=0.0, posinf=0.0, neginf=0.0)
    
    return X_denoised
