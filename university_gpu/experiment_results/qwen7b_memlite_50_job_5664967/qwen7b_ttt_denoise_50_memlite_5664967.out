def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)
    
    # Reverse normalization order
    X_log = np.log1p(X)
    
    # Apply PCA for dimensionality reduction
    pca = TruncatedSVD(n_components=min(20, X.shape[1]), random_state=kwargs.get('random_state', None))
    X_pca = pca.fit_transform(X_log)
    
    # Reconstruct the data
    X_recon = pca.inverse_transform(X_pca)
    
    # Apply square root transformation for variance stabilization
    X_sqrt = np.sqrt(X_recon)
    
    # Ensure non-negativity
    X_sqrt = np.maximum(X_sqrt, 0.0)
    
    # Normalize back to the original scale
    X_denoised = np.expm1(X_sqrt)
    
    # Clip negative values
    X_denoised = np.clip(X_denoised, a_min=0, a_max=None)
    
    return X_denoised
