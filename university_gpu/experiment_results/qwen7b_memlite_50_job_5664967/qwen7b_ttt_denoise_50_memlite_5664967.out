    pca = TruncatedSVD(n_components=min(100, X_sqrt.shape[1]), random_state=kwargs.get('random_state', None))
    X_pca = pca.fit_transform(X_sqrt)
    
    # Denoise via optimization
    def objective(x, A, b, gamma):
        return np.mean((x - A @ x - b)**2) + gamma * np.sum(np.abs(x))
    
    def constraints(x, A, b):
        return {'type': 'eq', 'fun': lambda x: A @ x + b - x}
    
    denoised_counts = []
    for i in range(X_sqrt.shape[0]):
        A = np.eye(X_sqrt.shape[1]) - pca.components_
        b = X_pca[i]
        res = minimize(objective, np.zeros_like(b), args=(A, b, 0.1), method='SLSQP', constraints=constraints(A, b))
        denoised_counts.append(res.x)
    
    denoised_counts = np.array(denoised_counts)
    
    # Inverse square root transformation
    denoised_counts = denoised_counts**2
    
    # Exponential transformation back to original scale
    denoised_counts = np.expm1(denoised_counts)
    
 
