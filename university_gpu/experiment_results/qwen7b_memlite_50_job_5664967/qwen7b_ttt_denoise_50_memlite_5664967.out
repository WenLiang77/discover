Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)

    # Reverse normalization order
    X_log = np.log1p(X)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_log)
    pca = PCA(n_components=0.95, svd_solver='full')
    X_reduced = pca.fit_transform(X_scaled)

    # Reconstruct using PCA components
    X_reconstructed = pca.inverse_transform(X_reduced)
    X_reconstructed_scaled = scaler.inverse_transform(X_reconstructed)
    X_denoised = np.expm1(X_reconstructed_scaled)

    # Ensure non-negative values and apply soft thresholding
    X_denoised = np.maximum(X_denoised, 0.0)
    threshold = 0.01
    X_denoised[X_denoised < threshold] = threshold

    return X_denoised
