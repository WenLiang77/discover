def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    
    # Reverse normalization order
    X_log = np.log1p(X)
    
    # Apply square root transformation
    X_sqrt = np.sqrt(X_log)
    
    # Perform PCA for dimensionality reduction
    pca = PCA(n_components=min(100, X_sqrt.shape[1]), svd_solver='full')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Reconstruct data from PCA components
    X_reconstructed = pca.inverse_transform(X_pca)
    
    # Apply inverse square root transformation
    X_inverse_sqrt = X_reconstructed ** 2
    
    # Exponentiate back to original scale
    X_denoised = np.expm1(X_inverse_sqrt)
    
    # Ensure non-negative values
    X_denoised = np.maximum(X_denoised, 0.0)
    
    # Clip values to prevent overflow
    X_denoised = np.clip(X_denoised, 0, 1e6)
    
    return X_denoised.astype(np.float32)
