def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)

    # Square root transformation to stabilize variance
    pt = PowerTransformer(method='yeo-johnson')
    X_sqrt = pt.fit_transform(X + 1e-6)

    # Apply Poisson shrinkage
    lambda_ = np.mean(X_sqrt, axis=0)
    X_shrinked = np.clip(lambda_, 0, None)

    # Inverse square root transformation
    X_denoised = pt.inverse_transform(X_shrinked)

    return X_denoised
