def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X[X < 0] = 0
    
    # Normalize raw counts
    X_log = np.log1p(X)
    
    # Center the data
    scaler = StandardScaler()
    X_centered = scaler.fit_transform(X_log)
    
    # Perform PCA
    pca = PCA(n_components=50)
    X_pca = pca.fit_transform(X_centered)
    
    # Find nearest neighbors
    nbrs = NearestNeighbors(n_neighbors=10).fit(X_pca)
    distances, indices = nbrs.kneighbors(X_pca)
    
    # Interpolate missing values based on nearest neighbors
    for i in range(X.shape[0]):
        mask = X[i] == 0
        if np.any(mask):
            nn_indices = indices[i]
            nn_distances = distances[i]
            nn_values = X_log[nn_indices][~mask]
            nn_weights = 1 / (nn_distances + 1e-6)
            nn_weights /= nn_weights.sum()
            X[i, mask] = np.dot(nn_weights, nn_values)
    
    # Exponentiate back to count space
    X_denoised_log = X
    X_denoised_raw = np.expm1(X_denoised_log)
    
    # Apply Poisson smoothing
    lambda_ = np.mean(X_denoised_raw, axis=0)
    X_denoised_raw = np.clip(poisson.pmf(range(1, int(np.max(X_denoised_raw)) + 2), mu=lambda_), 0, None)
    
