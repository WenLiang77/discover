def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Step 1: Reverse normalization order
    X_log = np.log(X + 1)
    
    # Step 2: Apply square root transform
    X_sqrt = np.sqrt(X_log)
    
    # Step 3: Perform PCA
    pca = PCA(n_components=100, svd_solver='arpack')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Step 4: Reconstruct data using inverse PCA
    X_recon_pca = pca.inverse_transform(X_pca)
    
    # Step 5: Apply inverse square root transform
    X_inv_sqrt = X_recon_pca ** 2
    
    # Step 6: Exponentiate back to original scale
    X_exp = np.exp(X_inv_sqrt) - 1
    
    # Ensure non-negativity
    X_denoised = np.maximum(X_exp, 0.0)
    
    return X_denoised
