def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    scaler = StandardScaler(with_mean=False)
    X_normalized = scaler.fit_transform(X)

    # Apply square root transformation for variance stabilization
    X_sqrt = np.sqrt(np.clip(X_normalized, 0, None))

    # Perform PCA for dimensionality reduction
    pca = PCA(n_components=50, svd_solver='arpack')
    X_pca = pca.fit_transform(X_sqrt)

    # Perform nearest neighbor imputation
    nbrs = NearestNeighbors(n_neighbors=10).fit(X_pca)
    distances, indices = nbrs.kneighbors(X_pca)
    imputed_X_pca = X_pca.copy()
    for i in range(len(distances)):
        if np.any(distances[i] > 0):
            imputed_X_pca[i] += np.mean(X_pca[indices[i]], axis=0)

    # Inverse PCA
    X_imputed_sqrt = pca.inverse_transform(imputed_X_pca)

    # Back-transform to original scale
    X_imputed = np.square(X_imputed_sqrt)
    X_imputed = scaler.inverse_transform(X_imputed)

    # Ensure non-negativity
    X_imputed = np.maximum(X_imputed, 0.0)

    return X_imputed
