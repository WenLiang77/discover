def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization order
    X_log = np.log1p(X)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_log)

    # Apply PCA
    pca = PCA(n_components=min(100, X_scaled.shape[1]))
    X_reduced = pca.fit_transform(X_scaled)

    # Reconstruct using nearest neighbors
    nbrs = NearestNeighbors(n_neighbors=10).fit(X_reduced)
    distances, indices = nbrs.kneighbors(X_reduced)

    # Push low values towards zero
    X_reconstructed = X_reduced.copy()
    mask = distances < 0.5
    X_reconstructed[mask] *= distances[mask]

    # Inverse PCA
    X_inverted = pca.inverse_transform(X_reconstructed)

    # Inverse scaling and exponentiation
    X_denormalized = scaler.inverse_transform(X_inverted)
    X_denoised = np.expm1(X_denormalized)

    # Clip negative values
    X_denoised = np.clip(X_denoised, 0.0, None)

    return X_denoised
