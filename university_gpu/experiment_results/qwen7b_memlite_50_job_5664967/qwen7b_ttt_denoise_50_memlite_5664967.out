def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization order
    X_log = np.log1p(X)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_log)
    pca = PCA(n_components=50)
    X_pca = pca.fit_transform(X_scaled)

    # Denoise via nearest neighbors
    nbrs = NearestNeighbors(n_neighbors=10).fit(X_pca)
    distances, indices = nbrs.kneighbors(X_pca)
    denoised_pca = np.mean([X_pca[indices[:, i]] for i in range(10)], axis=0)

    # Inverse transformations
    X_inverse_pca = pca.inverse_transform(denoised_pca)
    X_inverse_scaled = scaler.inverse_transform(X_inverse_pca)
    X_denorm = np.expm1(X_inverse_scaled)

    # Ensure non-negativity
    X_denorm = np.maximum(X_denorm, 0.0)

    return X_denorm
