def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Reverse normalization order
    X_log = np.log1p(X)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_log)
    
    # PCA for dimensionality reduction
    pca = PCA(n_components=min(50, X_scaled.shape[1]))
    X_pca = pca.fit_transform(X_scaled)
    
    # Nearest neighbors for denoising
    nn = NearestNeighbors(n_neighbors=10)
    nn.fit(X_pca)
    distances, indices = nn.kneighbors(X_pca)
    
    # Weighted average based on distances
    weights = np.exp(-distances / 10)
    weights /= weights.sum(axis=1, keepdims=True)
    denoised_pca = np.dot(weights, X_pca[indices])
    
    # Inverse PCA
    X_inv_pca = pca.inverse_transform(denoised_pca)
    
    # Inverse scaling and exponential transformation
    X_inv_scaled = scaler.inverse_transform(X_inv_pca)
    denoised_log = np.expm1(X_inv_scaled)
    
    # Ensure non-negativity and finite values
    denoised_log = np.maximum(denoised_log, 0.0)
    denoised_log[np.isinf(denoised_log)] = 0.0
    
    # Poisson clipping
    clip_value = 0.05 * denoised_log.mean()
    denoised_log
