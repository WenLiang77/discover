def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Apply square root transformation for variance stabilization
    X_sqrt = np.sqrt(X_normalized + 1)

    # Perform PCA for dimensionality reduction
    pca = PCA(n_components=min(10, X_sqrt.shape[1]), svd_solver='full')
    X_pca = pca.fit_transform(X_sqrt)

    # Reconstruct the data using PCA components
    X_reconstructed = pca.inverse_transform(X_pca)

    # Apply inverse square root transformation
