def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Reverse normalization order: denoise raw counts first
    X_log = np.log1p(X)
    X_sqrt = np.sqrt(X_log)
    
    # Apply PCA for dimensionality reduction
    pca = PCA(n_components=min(100, X.shape[1]), svd_solver='arpack')
    X_pca = pca.fit_transform(X_sqrt)
    
    # Reconstruct using inverse PCA
    X_reconstructed = pca.inverse_transform(X_pca)
    
    # Push low values towards zero
    X_denoised = np.where(X_reconstructed < 1, 0, X_reconstructed)
    
    # Ensure non-negativity
    X_denoised = np.maximum(X_denoised, 0.0)
    
    # Convert back to raw counts
    X_denoised = np.expm1(X_denoised)
    
    return X_denoised.astype(float)
