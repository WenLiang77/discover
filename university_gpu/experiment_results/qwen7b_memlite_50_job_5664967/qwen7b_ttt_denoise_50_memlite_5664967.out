def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.maximum(X, 0.0)

    # Apply square root transformation for stability
    X_sqrt = np.sqrt(X + 1e-6)

    # Scale the data between 0 and 1
    scaler = MinMaxScaler()
    X_scaled = scaler.fit_transform(X_sqrt)

    # Apply a soft thresholding step to push low values towards zero
    X_thresholded = np.clip(X_scaled, 0.05, None)

    # Transform back to the original scale
    X_denoised = np.square(X_thresholded) - 1e-6

    # Ensure non-negativity
    X_denoised = np.maximum(X_denoised, 0.0)

    return X_denoised.astype(int)
