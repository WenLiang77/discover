def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Standardize the data to have mean 0 and std 1
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Calculate the log-normalized counts
    log_counts = np.log(X_scaled + 1e-8)

    # Fit a Poisson model to the normalized data
    poisson_model = np.zeros_like(log_counts)
    poisson_model[np.where(np.isfinite(log_counts))] = np.random.poisson(np.exp(log_counts[np.where(np.isfinite(log_counts))]))

    # Normalize the Poisson model back to the original scale
    denoised_counts = scaler.inverse_transform(poisson_model)

    return denoised_counts

