def magic_denoise(X, **kwargs):
    """
    Magic denoising for scRNA-seq count data.
    
    Parameters:
    - X: numpy array of shape (n_cells, n_genes) - raw count data
    - **kwargs: additional keyword arguments
    
    Returns:
    - numpy array of same shape - denoised counts
    """
    # Convert to float and handle NaNs
    X = np.asanyarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Apply square root transformation to stabilize Poisson likelihood
    X = np.sqrt(X)
    
    # Apply Gaussian noise removal
    noise_std = np.std(X)
    noise_mean = np.mean(X)
    X_noisy = X + np.random.normal(noise_mean, noise_std, size=X.shape)
    
    # Reapply square root transformation
    X_denoised = np.sqrt(X_noisy)
    
    # Check Poisson loss
    poisson_loss = np.mean(np.log(X_denoised) - X)
    if poisson_loss < 0.97:
        raise ValueError("Poisson loss below the threshold.")
    
    return X_denoised
