def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation
    X = np.sqrt(X)

    # Normalize to log-normal distribution
    mu = np.mean(X, axis=1, keepdims=True)
    sigma = np.std(X, axis=1, keepdims=True)
    Z = (X - mu) / sigma
    Z = np.exp(Z)

    # Fit Poisson distribution to each cell
    poisson_dist = poisson.fit(Z.ravel())
    Z = poisson.rvs(poisson_dist, size=X.shape)

    # Apply inverse square root transformation
    Z = np.sqrt(Z)

    # Back to log-normal distribution
    Z = Z * sigma + mu

    return Z

