def magic_denoise(X, budget_s=400, random_state=None, knn=5, t=0.9, n_pca=100, solver='lsqr', decay=0.0, knn_max=None, n_jobs=-1):
    # Initialize scaler
    scaler = MinMaxScaler()
    
    # Normalize the raw count data
    normalized_X = scaler.fit_transform(X)
    
    # Apply square root transformation
    sqrt_normalized_X = np.sqrt(normalized_X)
    
    # Apply Poisson noise correction
    poisson_noise = np.random.poisson(sqrt_normalized_X * t, size=sqrt_normalized_X.shape)
    corrected_X = sqrt_normalized_X + poisson_noise
    
    # Denoise the corrected data
    denoised_X = corrected_X * np.sqrt(scaler.scale_)
    
    # Clip the result to ensure non-negativity
    denoised_X = np.clip(denoised_X, 0, None)
    
    return denoised_X
