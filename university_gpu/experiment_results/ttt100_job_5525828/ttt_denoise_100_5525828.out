def magic_denoise(X, budget_s, random_state, knn, t, n_pca, solver, decay, knn_max, n_jobs):
    np.random.seed(random_state)

    # Reverse normalization
    X = np.maximum(X, 0.0)
    
    # Square root transform
    X = np.sqrt(X)

    # Apply KNN denoising
    denoised_X = np.zeros_like(X)
    for i in range(X.shape[0]):
        indices = np.argsort(X[i])[::-1][:knn]
        neighbors = X[indices]
        means = np.mean(neighbors, axis=0)
        stds = np.std(neighbors, axis=0)
        denoised_X[i] = means + stds * np.random.normal(size=X.shape[1])

    # Apply decay
    denoised_X = np.exp(denoised_X / decay)

    # Normalize
    denoised_X = np.max(denoised_X) / denoised_X

    # Apply thresholding
    denoised_X[denoised_X < 1e-4] = 0.0

    # Check Poisson constraint
    poisson_norm = (0.257575 - np.sum(np.log(denoised_X + 1))) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint not satisfied")

    return denoised_X

