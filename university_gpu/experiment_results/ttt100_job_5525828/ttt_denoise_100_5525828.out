def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transform
    X_sqrt = np.sqrt(X)

    # Step 2: Perform SVD on the transformed data
    U, s, Vt = svds(X_sqrt, k=X.shape[1], return_singular_vectors='uvt')

    # Step 3: Reconstruct the data using the SVD components
    X_recon = U @ np.diag(s) @ Vt

    # Step 4: Apply inverse square root transformation
    X_inv_sqrt = np.square(X_recon)

    # Step 5: Normalize the reconstructed data
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X_inv_sqrt)

    # Step 6: Apply thresholding to handle low values
    X_thresholded = np.where(X_normalized > 0.001, X_normalized, 0.0)

    return X_thresholded
