def magic_denoise(X, **kwargs):
    # Normalize raw data
    X = X / X.sum(axis=1, keepdims=True)
    
    # Reorder genes to improve denoising
    _, reorder_indices = np.unique(np.argsort(X, axis=1), axis=0)
    X = X[:, reorder_indices]
    
    # Square root transformation
    X = np.sqrt(X)
    
    # Apply magic denoising technique
    denoised_X = np.where(X > 1e-6, X, 0.0)
    
    # Apply Poisson loss constraint
    poisson_loss = np.mean(poisson.pmf(denoised_X.ravel(), np.mean(denoised_X)))
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    
    if poisson_norm < 0.97:
        raise ValueError("Poisson norm is below the threshold.")
    
    return denoised_X
