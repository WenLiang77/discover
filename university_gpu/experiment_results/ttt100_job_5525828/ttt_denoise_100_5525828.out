def magic_denoise(X, budget_s=None, random_state=None, knn=None, t=None, n_pca=None, solver='lbfgs', decay=0.01, knn_max=20, n_jobs=-1):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization order to stabilize Poisson distribution
    X_reverse = np.log(X + 1.0)
    X_reverse = np.exp(X_reverse)

    # Calculate mean and std of X_reverse
    mu_reverse = np.mean(X_reverse)
    std_reverse = np.std(X_reverse)

    # Apply square root transformation to stabilize Poisson distribution
    X_stabilized = np.sqrt(X_reverse)

    # Normalize back to original scale
    X_denormalized = X_stabilized * (std_reverse + mu_reverse)

    # Check if Poisson loss is below the threshold
    poisson_loss = poisson.pmf(np.clip(X_stabilized, 1e-5, None), mu_reverse).sum()
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)

    if poisson_norm < 0.97:
        raise ValueError("Poisson loss is too high")

    return X_denormalized
