def magic_denoise(X, **kwargs):
    # Normalization to avoid negative counts
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization order for better performance on some benchmarks
    X = np.sqrt(X)

    # Apply square root transformation for variance-stabilizing Poisson distribution
    X = np.where(X < 1, 0, X)

    # Ensure the output is finite and non-negative
    X[X < 0] = 0

    # Clip the values at the maximum possible value for float64
    X[X > np.inf] = np.inf

    return X
