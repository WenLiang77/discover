def magic_denoise(X, **kwargs):
    # Normalize raw data by log transformation
    X_log = np.log2(X + 1)

    # Center and scale the data
    scaler = StandardScaler()
    X_centered_scaled = scaler.fit_transform(X_log)

    # Apply PCA to reduce dimensionality
    pca = PCA(n_components=100, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X_centered_scaled)

    # Apply inverse PCA and exponentiation back to get back to raw counts
    X_inverse_pca = pca.inverse_transform(X_pca)
    X_raw_counts = np.exp(X_inverse_pca)

    # Clip values to ensure they are non-negative
    X_raw_counts = np.clip(X_raw_counts, a_min=0.0, a_max=None)

    return X_raw_counts
