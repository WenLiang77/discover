def magic_denoise(X, **kwargs):
    """
    Perform denoising on single-cell RNA-seq count data using the MAGIC algorithm.
    
    Parameters:
    X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
    
    Returns:
    numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    def objective(denominator):
        return np.mean((denominator - X)**2), denominator
    
    result = minimize_scalar(objective, bounds=(1e-6, 10000), method='bounded', options={'maxiter': 1000})
    denoised_X = result.x * X
    return denoised_X

