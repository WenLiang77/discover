import numpy as np
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler, LogTransformer, MinMaxScaler
from scipy.optimize import minimize

def gaussian_kernel_matrix(X, sigma=1.0):
    """Compute the Gaussian kernel matrix."""
    K = np.exp(-0.5 * np.sum((X[:, None] - X[None, :])**2, axis=-1) / (sigma**2))
    return K / K.max()

def optimize_gaussian_kernel(K, labels):
    """Optimize the sigma hyperparameter for the Gaussian kernel."""
    initial_sigma = 1.0
    bounds = [(1e-6, None)]
    result = minimize(lambda sigma: np.mean(np.square(labels - np.dot(K, labels))), initial_sigma, bounds=bounds)
    return result.x[0]

