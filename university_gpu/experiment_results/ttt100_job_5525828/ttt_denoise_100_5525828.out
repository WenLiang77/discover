def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Denoise raw counts
    denoised_counts = np.where(X > 0, X, 0)

    # Apply square root transformation
    denoised_counts = np.sqrt(denoised_counts)

    # Normalize to Poisson distribution
    normalized_counts = np.exp(-denoised_counts)

    # Adjust for potential underflow
    normalized_counts[np.isnan(normalized_counts)] = 0.0
    normalized_counts[np.isinf(normalized_counts)] = 0.0

    # Reapply Poisson transformation
    denoised_counts = poisson.rvs(normalized_counts)

    return denoised_counts

