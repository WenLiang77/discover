    X = X / np.sum(X, axis=-1, keepdims=True)

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)

    # Set non-positive values to 0
    X[X <= 0] = 0

    # Clip values to [1e-6, 1000] to avoid numerical issues
    X = np.clip(X, 1e-6, 1000)

    return X
