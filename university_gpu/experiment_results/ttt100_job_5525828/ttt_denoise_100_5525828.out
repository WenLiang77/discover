def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize using square root transformation
    X_sqrt = np.sqrt(X)

    # Apply Gaussian noise model to simulate dropout
    sigma = 0.1 * np.std(X_sqrt)  # Scale sigma according to data's variance
    noise = np.random.normal(0, sigma, X_sqrt.shape)
    X_noisy = X_sqrt + noise

    # Convert back to Poisson distribution
    X_poisson = np.exp(-X_noisy)

    # Apply inverse square root transformation
    X_denoised = np.sqrt(X_poisson)

    # Apply thresholding to remove small values
    X_denoised[X_denoised < 0.0] = 0.0

    return X_denoised
