        raw_counts = np.exp(0.5 * denoised)
        
        # Calculate Poisson negative log-likelihood
        poisson_loss = poisson.logpmf(raw_counts, np.mean(denoised)).sum()
        
        # Calculate MSE
        mse = np.mean((raw_counts - denoised)**2)
        
        # Apply Poisson constraint
