def magic_denoise(X, **kwargs):
    """
    Denoise single-cell RNA-seq count data using a novel approach.

    Parameters:
        X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
    
    Returns:
        numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    # Normalize raw count data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Apply square root transformation
    X_scaled = np.sqrt(X_scaled + 1e-8)

    # Apply poisson noise correction
    X_corrected = np.exp(np.log(X_scaled).clip(min=0.0))

    # Clip and ensure non-negative
    X_denoised = np.clip(X_corrected, min=0.0)

    # Check Poisson constraint
    poisson_loss = poisson.pmf(X_denoised.flatten(), np.mean(X_denoised.flatten()))
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson loss < 0.97. Solution rejected.")

    return X_denoised
