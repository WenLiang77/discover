def magic_denoise(X, **kwargs):
    # Normalize raw counts
    X_norm = np.log2(X + 1)

    # Fit a Poisson distribution to normalized counts
    mean = np.mean(X_norm)
    var = np.var(X_norm)
    poisson_dist = norm(mean, np.sqrt(var))

    # Denoise counts
    denoised_X = np.random.poisson(poisson_dist.cdf(X_norm))
    denoised_X = denoised_X.clip(min=0)

    # Check Poisson constraint
    poisson_norm = ((0.257575 - poisson_dist.cdf(np.mean(denoised_X))) /
                     (0.257575 - 0.031739))
    if poisson_norm < 0.97:
        raise ValueError("Denoised counts do not satisfy Poisson constraint")

    return denoised_X

