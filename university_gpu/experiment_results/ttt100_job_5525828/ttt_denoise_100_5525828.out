def magic_denoise(X, **kwargs):
    # Step 1: Normalize the raw data to have mean 0 and variance 1
    normalized_X = (X - np.mean(X)) / np.std(X)

    # Step 2: Apply a square root transformation to stabilize Poisson distribution
    stable_X = np.sqrt(normalized_X + 1e-6)

    # Step 3: Apply a threshold to reduce low non-zero values
    thresholded_X = np.clip(stable_X, 0.0, None)

    # Step 4: Rescale to match the original scale
    denoised_X = thresholded_X * np.std(X) + np.mean(X)

    return denoised_X
