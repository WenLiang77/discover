def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Define objective function
    def objective(denoised_counts):
        # Calculate MSE on log-normalized data
        log_normalized_data = np.log2(denoised_counts + 1e-6)  # Add small epsilon to avoid log(0)
        mse = np.mean((log_normalized_data - np.log2(X))**2)
        return mse

    # Initial guess for denoised counts
    initial_guess = X.copy()

    # Minimize objective function
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=[(0, None)]*X.shape[1])

    # Ensure the result is finite and non-negative
    if not result.success or not np.all(np.isfinite(result.x)):
        raise ValueError("Denoising failed")

    denoised_counts = result.x.astype(int)  # Convert back to integers

    # Apply square root transformation
    denoised_counts = np.sqrt(denoised_counts)

    return denoised_counts

