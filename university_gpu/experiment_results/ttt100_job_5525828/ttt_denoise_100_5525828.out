def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize to log-normal distribution
    mean = X.mean(axis=1)
    std_dev = X.std(axis=1)
    X_lognorm = np.log((X + 1) / std_dev) + mean

    # Apply square root transformation
    X_sqrt = np.sqrt(X_lognorm)

    # Clip values below 1 to 0
    X_sqrt[X_sqrt < 1] = 0

    return X_sqrt
