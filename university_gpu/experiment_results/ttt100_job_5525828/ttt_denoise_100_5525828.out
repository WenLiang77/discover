def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization
    X /= np.max(X, axis=1, keepdims=True)
    
    # Apply square root transformation
    X = np.sqrt(X + 1e-6)
    
    # Denoise using Gaussian mixture model
    means, covariances = [], []
    for i in range(X.shape[1]):
        # Fit Gaussian mixture model to each gene
        gmm = norm.fit(X[:, i])
        means.append(gmm.mean_[0])
        covariances.append(np.diag(gmm.covariance_))
    
    means = np.array(means).reshape(-1, 1)
    covariances = np.array(covariances).reshape(-1, 1, 1)

    # Predict the denoised values
    denoised = np.dot(X, means.T) + np.sqrt(2) * np.dot(np.linalg.solve(covariances, np.eye(X.shape[1])), X)
    
    # Apply square root transformation back
    denoised = np.sqrt(denoised + 1e-6)
    
    # Normalize back to [0, 1]
    denoised = (denoised - denoised.min()) / (denoised.max() - denoised.min())
    
    return denoised
