def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(params):
        denoised = X * params.reshape(-1, 1)
        poisson_norm = np.mean((denoised ** 2) / X) - 1
        mse = np.mean((np.log(denoised) - np.log(X)) ** 2)
        return mse + 1e-6 * poisson_norm

    initial_guess = np.ones_like(X.flatten())
    result = minimize(objective, initial_guess)

    if result.fun > 0.97:
        raise ValueError("Poission constraint not met")

    denoised = X * result.x.reshape(-1, 1)
    return denoised
