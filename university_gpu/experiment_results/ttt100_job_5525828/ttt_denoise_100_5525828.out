    normalized_data = X ** (-1/2)

    # Apply Gaussian noise removal
    gaussian_noise = np.random.normal(loc=0, scale=0.1, size=X.shape)
    denoised_data = normalized_data + gaussian_noise

    # Reapply reverse normalization
    denoised_data = denoised_data ** 2

    # Clip to prevent negative values
    denoised_data = np.clip(denoised_data, 0, None)

    # Normalize back to log-scale
    denoised_data = np.log(denoised_data)

    # Apply Poisson regularization
    poisson_loss = np.mean(np.exp(-denoised_data))
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
