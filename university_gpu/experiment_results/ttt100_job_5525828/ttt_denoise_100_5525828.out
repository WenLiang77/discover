def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply log transformation
    log_counts = np.log2(X + 1e-8)

    # Step 2: Normalize the log counts
    scaler = StandardScaler()
    normalized_log_counts = scaler.fit_transform(log_counts)

    # Step 3: Compute the covariance matrix
    cov_matrix = np.cov(normalized_log_counts.T)

    # Step 4: Solve for the noise covariance matrix
    noise_cov_matrix = (cov_matrix + np.eye(cov_matrix.shape[0])) / cov_matrix.shape[0]

    # Step 5: Solve for the denoised counts
    denoised_log_counts = spsolve(noise_cov_matrix, cov_matrix @ normalized_log_counts.T)

    # Step 6: Convert back to counts
    denoised_counts = np.exp(denoised_log_counts) - 1e-8

    return denoised_counts
