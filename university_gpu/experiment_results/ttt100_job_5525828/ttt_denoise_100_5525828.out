def magic_denoise(X, **kwargs):
    # Step 1: Convert raw counts to log-normalized space
    log_X = np.log(np.clip(X + 1e-5, 1e-5, None))
    
    # Step 2: Apply square root transformation to stabilize Poisson distribution
    sqrt_log_X = np.sqrt(log_X)
    
    # Step 3: Fit a Poisson distribution to the transformed data
    mean = np.mean(sqrt_log_X)
    std_dev = np.std(sqrt_log_X)
    mu = mean + std_dev * np.random.randn(len(sqrt_log_X))
    
    # Step 4: Invert the Poisson distribution to get back to the original scale
    inv_sqrt_log_X = np.exp(mu - sqrt_log_X)
    inv_log_X = inv_sqrt_log_X - 1
    
    # Step 5: Add one to avoid negative counts
    denoised_X = inv_log_X + 1
    
    # Apply the inverse square root transformation again
    denoised_X = np.sqrt(denoised_X)
    
    # Clip and round to ensure finite and non-negative values
    denoised_X = np.clip(denoised_X, 0.0, None)
    denoised_X = np.round(denoised_X)
    
    return denoised_X
