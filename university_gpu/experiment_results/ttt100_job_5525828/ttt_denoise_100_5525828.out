Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization
    X_reversed = X ** (-0.5)

    # Estimate lambda parameter
    def objective(lambda_val):
        return np.sum(poisson.pmf(X_reversed, lambda_val) * X_reversed) + lambda_val * np.sum(np.log(X_reversed))

    result = minimize_scalar(objective, bounds=(1e-10, 1e+10), method='bounded')
    lambda_estimated = result.x

    # Reverse normalization with estimated lambda
    denoised_X = X ** (-0.5) * np.exp(-lambda_estimated * X_reversed)

    return denoised_X
