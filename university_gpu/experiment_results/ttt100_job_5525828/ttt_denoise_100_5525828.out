def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Square root transform is variance-stabilizing for Poisson distributions
    X = np.sqrt(X)

    # Normalize to mean 0 and std 1
    X -= np.mean(X)
    X /= np.std(X)

    # Apply Poisson loss penalty
    poisson_loss = np.sum(np.maximum(0, X - np.random.poisson(np.exp(X), size=X.shape)) * X)
    
    # Calculate Poisson normalization
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)

    if poisson_norm < 0.97:
        raise ValueError("Poisson loss is below the threshold, re-run with appropriate settings.")

    return X

