def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for single-cell RNA-seq data.
    
    Args:
    X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
    
    Returns:
    numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    n_cells, n_genes = X.shape
    
    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X + 1e-8)  # Add a small constant to avoid division by zero
    
    # Step 2: Normalize the transformed data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_sqrt)
    
    # Step 3: Apply square root transformation again
    X_final = np.sqrt(X_scaled + 1e-8)  # Add a small constant to avoid division by zero
    
    # Step 4: Revert to natural logarithm for Poisson distribution
    X_denoised = np.log(X_final)
    
    return X_denoised

# Check function to verify correctness
def evaluate_mse(X, y):
    mse = np.mean((y - X)**2)
    return mse

def evaluate_poisson(X, y):
    poisson_loss = np.sum(np.where(y > 0, -np.log(y), 0))
    return poisson_loss

