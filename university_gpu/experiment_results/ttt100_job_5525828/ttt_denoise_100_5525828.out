def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X)

    # Step 2: Apply PCA for dimensionality reduction
    pca = PCA(n_components=min(10, X_sqrt.shape[1]), random_state=42)
    X_pca = pca.fit_transform(X_sqrt)

    # Step 3: Fit logistic regression model
    lr = LogisticRegressionCV(cv=5, solver='liblinear', max_iter=1000, penalty='l1', C=10)
    lr.fit(X_pca, np.zeros_like(X_sqrt))

    # Step 4: Predict probabilities
    probas = lr.predict_proba(X_pca)

    # Step 5: Reconstruct the normalized expression levels
    denoised_X = np.square(probas[:, 0]) * X_sqrt

    # Step 6: Apply inverse square root transformation
    denoised_X = np.sqrt(denoised_X)

    return denoised_X
