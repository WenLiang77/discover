def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Denoise raw counts using a simple thresholding method
    threshold = np.median(X) * 0.1  # Adjust this threshold based on the data distribution
    denoised_X = np.clip(X, threshold, None)

    return denoised_X
