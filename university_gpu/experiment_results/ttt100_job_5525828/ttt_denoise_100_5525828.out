def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Normalize counts
    X_normalized = X / np.sqrt(np.sum(X, axis=1))

    # Step 2: Perform PCA on normalized data
    U, s, Vh = np.linalg.svd(X_normalized.T @ X_normalized, full_matrices=False)

    # Step 3: Apply principal components to reverse normalization
    X_reversed = U @ np.diag(1 / s) @ Vh

    # Step 4: Denoise counts
    denoised_counts = X_reversed + np.random.normal(loc=0, scale=np.sqrt(s), size=X.shape)

    return denoised_counts
