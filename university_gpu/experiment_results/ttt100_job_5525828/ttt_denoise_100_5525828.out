# Improved version
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(denoised_X):
        log_counts = np.log1p(denoised_X)
        poisson_loss = np.mean(np.sum(poisson.pmf(log_counts, X), axis=1))
        mse = np.mean((log_counts - np.log1p(X)) ** 2)
        return poisson_loss + mse

    initial_guess = np.array(X)
    result = minimize(objective, initial_guess, bounds=(0.0, None))

    if not result.success or result.fun > 0.97 * poisson_log_likelihood(X):
        raise ValueError("Denoising failed")

    denoised_X = np.exp(result.x)

    return denoised_X

def poisson_log_likelihood(X):
    return np.mean(np.sum(poisson.pmf(np.log1p(X), X), axis=1))

