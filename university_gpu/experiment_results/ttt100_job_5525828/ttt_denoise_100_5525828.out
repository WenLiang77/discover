def magic_denoise(X, **kwargs):
    """
    Denoise single-cell RNA-seq count data using the Magic denoising algorithm.

    Parameters:
    - X: numpy array of shape (n_cells, n_genes) - raw count data
    - **kwargs: additional keyword arguments for tuning the denoising process

    Returns:
    - numpy array of same shape - denoised counts
    """
    # Step 1: Apply square root transform to stabilize Poisson distribution
    X = np.sqrt(X)

    # Step 2: Normalize the data using PCA
    pca = PCA(n_components=None)
    X_normalized = pca.fit_transform(X)
    X_normalized = np.log2(X_normalized + 1)  # Convert to log2 scale

    # Step 3: Fit a Poisson distribution to the normalized data
    poisson_dist = norm.fit(X_normalized)

    # Step 4: Transform the data back to its original scale
    X_denoised = np.exp(poisson_dist.pdf(X_normalized))

    # Step 5: Reapply square root transform and log2 transformation
    X_denoised = np.sqrt(X_denoised)
    X_denoised = np.log2(X_denoised + 1)

    # Step 6: Clip the denoised data to ensure non-negativity
    X_denoised = np.clip(X_denoised, 0.0, None)

    return X_denoised
