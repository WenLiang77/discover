def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reorder normalization
    max_val = np.max(X)
    min_val = np.min(X)
    X = (X - min_val) / (max_val - min_val)

    # Square root transform
    X = np.sqrt(X + 1e-6)

    # Poisson loss
    poisson_loss = np.zeros_like(X)
    for i in range(X.shape[0]):
        for j in range(X.shape[1]):
            if X[i][j] > 1:
                poisson_loss[i][j] = poisson.logpmf(1, X[i][j])

    # Denoise
    denoised_X = np.exp(-poisson_loss)

    # Apply thresholding
    denoised_X = np.clip(denoised_X, 0.0, None)

    return denoised_X

