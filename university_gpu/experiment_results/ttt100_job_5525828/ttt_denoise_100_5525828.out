def magic_denoise(X, **kwargs):
    # Normalize counts first
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Reduce dimensionality using PCA
    pca = PCA(n_components=10)
    X_pca = pca.fit_transform(X_scaled)

    # Train a KNN regressor on the PCA transformed data
    k_neigh = KNeighborsRegressor(n_neighbors=5, weights='uniform')
    k_neigh.fit(X_pca, np.log(X_scaled))

    # Predict on the scaled data
    X_pred_scaled = scaler.transform(X_scaled)
    X_pred_log = k_neigh.predict(X_pred_scaled)

    # Reverse the transformation to get the denoised counts
    X_pred = np.exp(X_pred_log)

    # Ensure all counts are non-negative and finite
    X_pred[X_pred < 0] = 0.0
    X_pred[np.isinf(X_pred)] = 0.0

    # Apply square root transformation to stabilize Poisson distribution
    X_pred = np.sqrt(X_pred)

    # Check Poisson loss and apply regularization if necessary
    poisson_loss = -np.mean(np.log(X_pred))
    if poisson_loss > 0.036971390362666695:
        poisson_loss -= 0.031739
        poisson_loss /= 0.257575
        poisson_loss *= 0.97
        X_pred = np.clip(X_pred, 0.0, None)

    return X_pred
