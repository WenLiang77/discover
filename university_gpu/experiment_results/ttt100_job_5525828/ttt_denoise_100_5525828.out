def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transform to stabilize Poisson distribution
    X = np.sqrt(X)

    # Fit a Poisson model to the transformed data
    fitted_model = poisson.fit_transform(X)

    # Calculate the predicted expression levels
    predicted_counts = fitted_model.max(axis=1)

    # Normalize the predicted counts to ensure they are non-negative and finite
    predicted_counts = np.clip(predicted_counts, 0.0, np.inf)

    # Convert the predicted counts back to their original scale
    predicted_counts = X * np.sqrt(predicted_counts)

    # Apply inverse square root transformation to reverse the stabilization effect
    predicted_counts = np.sqrt(predicted_counts)

    # Ensure all values are finite and non-negative
    predicted_counts = np.clip(predicted_counts, 0.0, np.inf)

    return predicted_counts
