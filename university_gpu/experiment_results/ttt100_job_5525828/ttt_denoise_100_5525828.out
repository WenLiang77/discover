    mean_counts = np.mean(X, axis=1, keepdims=True)
    std_counts = np.std(X, axis=1, keepdims=True)
    normalized_counts = (X - mean_counts) / std_counts

    # Step 2: Apply square root transformation
    sqrt_normalized_counts = np.sqrt(normalized_counts)

    # Step 3: Calculate Poisson normalization factor
    poisson_factor = np.minimum(1.0, sqrt_normalized_counts + 1.0)

    # Step 4: Apply Poisson normalization
    denoised_counts = sqrt_normalized_counts * poisson_factor

