def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for single-cell RNA-seq count data.
    
    Parameters:
    - X: numpy array of shape (n_cells, n_genes) - raw count data
    
    Returns:
    - numpy array of same shape - denoised counts
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize counts using square root transformation
    X_sqrt = np.sqrt(X)
    
    # Apply Poisson noise correction
    lambda_ = np.mean(X_sqrt)
    mu = lambda_
    sigma = np.sqrt(lambda_)
    z_scores = (X_sqrt - mu) / sigma
    p_values = norm.cdf(z_scores)
    X_denoised = np.random.poisson(mu, size=X.shape) * sigma + mu
    
    # Ensure denoised counts are positive and finite
    X_denoised[X_denoised < 0] = 0
    X_denoised[X_denoised == np.inf] = 0
    
    return X_denoised
