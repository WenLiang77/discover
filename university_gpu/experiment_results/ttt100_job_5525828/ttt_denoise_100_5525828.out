def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize the data first
    scaler = StandardScaler()
    normalized_X = scaler.fit_transform(X)

    # Define the objective function for minimizing the Poisson loss
    def objective(poisson_loss):
        denoised_X = normalized_X + poisson_loss * np.random.normal(size=normalized_X.shape)
        return poisson.pmf(normalized_X.flatten(), denoised_X.flatten()).sum()

    # Find the optimal Poisson loss
    result = minimize_scalar(objective, bounds=(0, 1), method='bounded')
    poisson_loss = result.x

    # Apply the denoising with the found Poisson loss
    denoised_X = normalized_X + poisson_loss * np.random.normal(size=normalized_X.shape)

    # Ensure the denoised data is finite and non-negative
    denoised_X[denoised_X < 0] = 0

    return denoised_X
