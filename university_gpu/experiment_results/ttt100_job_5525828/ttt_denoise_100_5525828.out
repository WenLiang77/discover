def magic_denoise(X, **kwargs):
    # Normalization step (logarithm)
    X_log = np.log(np.clip(X + 1e-6, 1e-6, None))
    
    # Principal Component Analysis (PCA)
    pca = PCA(n_components=min(X.shape[0], 100), svd_solver='randomized')
    X_pca = pca.fit_transform(X_log)
    
    # Logistic Regression for denoising
    clf = LogisticRegressionCV(Cs=np.logspace(-5, 1, 100), cv=5, solver='lbfgs', multi_class='multinomial')
    clf.fit(X_pca, X_log)
    denoised = clf.predict_proba(X_pca)[:, 1]
    
    # Postprocessing to ensure non-negativity and finite values
    denoised = np.maximum(denoised, 0.0)
    denoised = np.where(denoised == 0.0, 1e-6, denoised)
    
    return denoised
