def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    X_norm = np.log(X + 1e-8)

    # Calculate mean expression per gene
    means = np.mean(X_norm, axis=0)

    # Calculate covariance matrix
    cov = np.cov(X_norm.T)

    # Solve linear regression problem to get the denoised counts
    A = np.hstack([cov, np.eye(X.shape[1])])
    b = np.hstack([means, np.zeros(X.shape[1])])

    result = minimize(lambda x: np.sum((x - b)**2), x0=np.zeros(X.shape[1]))
    denoised_counts = result.x.reshape(-1, 1)

    # Apply inverse transformation to get the final denoised counts
    denoised_counts = np.exp(denoised_counts - means)

    return denoised_counts

