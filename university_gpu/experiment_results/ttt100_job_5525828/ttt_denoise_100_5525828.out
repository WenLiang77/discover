def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(params):
        denoised = np.exp(-params).clip(0.0, None)
        poisson_norm = np.sum(np.log(denoised)) / len(denoised)
        mse_loss = np.mean((X - denoised) ** 2)
        return mse_loss + (1 - poisson_norm) * 0.031739

    initial_guess = np.zeros_like(X)
    bounds = [(0.0, None) for _ in range(len(X))]
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, options={'maxiter': 1000})

    if result.fun > 0.97:
        return result.x
    else:
        raise ValueError("Poisson constraint not satisfied")

