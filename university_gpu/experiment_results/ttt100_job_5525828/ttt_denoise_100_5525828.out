def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X = np.sqrt(X)

    # Step 2: Normalize the data
    row_sums = np.sum(X, axis=1)
    X /= row_sums[:, np.newaxis]

    # Step 3: Apply Poisson noise correction
    X = np.exp(X)
    X /= np.mean(X, axis=1)[:, np.newaxis]
    X = np.minimum(X, 10**5)  # Clamp to prevent underflow

    # Step 4: Reapply square root transformation
    X = np.sqrt(X)

    return X
