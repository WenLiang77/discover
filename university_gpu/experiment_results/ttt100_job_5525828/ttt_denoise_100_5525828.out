def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X_stabilized = np.sqrt(X)

    # Normalize the stabilized counts
    mean = np.mean(X_stabilized)
    std_dev = np.std(X_stabilized)
    X_normalized = (X_stabilized - mean) / std_dev

    # Reapply square root transformation
    X_denoised = np.square(X_normalized)

    # Ensure the denoised counts are finite and non-negative
    X_denoised[X_denoised < 0] = 0.0
    X_denoised = np.clip(X_denoised, 0.0, None)

    return X_denoised
