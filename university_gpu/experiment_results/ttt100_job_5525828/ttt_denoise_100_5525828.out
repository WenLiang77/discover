def magic_denoise(X, budget_s=400, random_state=None, knn=10, t=0.5, n_pca=10, solver='lbfgsb', decay=0.01, knn_max=100, n_jobs=-1):
    # Normalize counts by square root transform
    X = np.sqrt(X + 1)

    # Apply KNN normalization
    if knn > 0:
        X = apply_knn_normalization(X, knn, t, n_pca, solver, decay, knn_max, n_jobs)

    # Perform principal component analysis to reduce noise
    if n_pca > 0:
        X = PCA(n_components=n_pca).fit_transform(X)

    # Define objective function for minimizing Poisson loss
    def objective(denoised):
        return sum((denoised - X)**2)

    # Initial guess for denoised counts
    initial_guess = X.mean(axis=1)

    # Minimize the objective function
    result = minimize(objective, initial_guess, bounds=(0, None), method=solver, options={'maxiter': budget_s})

    # Ensure the result is within the valid range
    denoised = np.clip(result.x, 0, None)

    # Check if the Poisson constraint is satisfied
    poisson_norm = (0.257575 - result.fun) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint not satisfied")

    return denoised

