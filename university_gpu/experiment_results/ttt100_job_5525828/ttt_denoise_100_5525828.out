def magic_denoise(X, **kwargs):
    X = normalize_counts(X)
    X = sqrt_transform(X)
    X = reverse_normalization(X)
    
    # Ensure the output is finite and non-negative
    X[X < 0] = 0
    
    # Define the objective function
    def objective_function(denoised_X):
        mse = ((denoised_X - X) ** 2).mean()
        poisson_norm = (0.257575 - poisson_loss(denoised_X)) / (0.257575 - 0.031739)
        return mse + 0.03 * poisson_norm
    
    # Initial guess for denoised counts
    initial_guess = X.copy()
    
    # Minimize the objective function
    result = minimize(objective_function, initial_guess, bounds=[(0, None)]*len(X))
    
    # Check if the optimization was successful
    if result.success:
        denoised_X = result.x
    else:
        raise ValueError("Optimization failed")
    
    return denoised_X
