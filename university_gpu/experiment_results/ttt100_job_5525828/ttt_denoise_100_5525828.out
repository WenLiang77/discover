def magic_denoise(X, **kwargs):
    """
    Denoise raw count data using a novel approach.
    
    Parameters:
        X (numpy.ndarray): Raw count data (shape: (n_cells, n_genes))
        **kwargs: Additional keyword arguments (not used)
        
    Returns:
        numpy.ndarray: Denoised count data
    """
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize data first
    normalized_data = log_normalize(X)
    
    # Find optimal lambda
    optimal_lambda = find_optimal_lambda(normalized_data)
    
    # Denoise using the optimal lambda
    denoised_data = log_normalize(normalized_data / optimal_lambda)
    
    # Apply Poisson regularization
    def poisson_regularization(x):
        return x * (x - 1) / (x + 1)
    
    # Apply Poisson regularization
    denoised_data = np.where(denoised_data <= 1, denoised_data, poisson_regularization(denoised_data))
    
    return denoised_data
