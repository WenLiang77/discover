Generated code preview:
def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.
    
    Args:
        X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
        
    Returns:
        numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X)

    # Step 2: Calculate mean and std dev of sqrt-transformed data
    mean_sqrt = np.mean(X_sqrt)
    std_dev_sqrt = np.std(X_sqrt)

    # Step 3: Apply inverse square root transformation
    X_inv_sqrt = (X_sqrt - mean_sqrt) / std_dev_sqrt

    # Step 4: Apply Poisson normalization
    poisson_counts = np.exp(-X_inv_sqrt)
    poisson_norm = np.sum(poisson_counts) / np.sum(X)

    # Step 5: Apply square root transformation back to original scale
    X_denoised = np.sqrt(poisson_counts)

    return X_denoised

