def magic_denoise(X, **kwargs):
    def objective(denoised_data):
        X_log = np.log2(denoised_data + 1)
        X_renorm = (X_log - X_log.mean(axis=1, keepdims=True)) / X_log.std(axis=1, keepdims=True)
        poisson_loss = -np.sum(X * np.log2(np.clip(X_renorm, 0.001, None)) + np.exp(-X_renorm))
        return poisson_loss
    
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    initial_guess = np.random.rand(X.shape[0], X.shape[1])
    constraints = [{'type': 'ineq', 'fun': lambda x: x}]

    result = minimize(objective, initial_guess, method='SLSQP', constraints=constraints)
    denoised_data = result.x

    return denoised_data
