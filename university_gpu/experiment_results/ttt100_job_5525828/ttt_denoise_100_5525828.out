def magic_denoise(X, budget_s=None, random_state=None, knn=None, t=None, n_pca=None, solver='lbfgsb', decay=None, knn_max=None, n_jobs=None):
    # Initialize parameters
    if random_state is None:
        random_state = np.random.RandomState(42)
    
    if budget_s is not None:
        # Apply thresholding based on budget
        threshold = np.percentile(X.flatten(), budget_s * 100)
        X[X < threshold] = 0
    
    # Denoise using Poisson regression
    if knn is not None:
        # Perform KNN denoising
        denoised_X = k_nearest_neighbors_denoise(X, knn, solver=solver, decay=decay, n_jobs=n_jobs)
    else:
        # Perform regular denoising
        denoised_X = regular_denoise(X, t=t, n_pca=n_pca, solver=solver, decay=decay, n_jobs=n_jobs)
    
    # Normalize the denoised counts
    normalized_denoised_X = denoised_X / np.sum(denoised_X, axis=-1, keepdims=True)
    
    return normalized_denoised_X

