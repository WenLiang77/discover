Generated code preview:
def magic_denoise(X, **kwargs):
    # Apply square root transformation to stabilize the distribution of counts
    X = np.sqrt(X)

    # Remove zeros from the counts to avoid underflow issues
    X[X == 0] = 0.0001

    # Estimate the expected number of reads per cell for each gene
    read_counts = np.sum(X, axis=0, keepdims=True)

    # Fit a Poisson model to estimate the expected counts
    poisson_model = poisson(read_counts.squeeze())
    expected_counts = poisson_model.pmf(X)

    # Calculate the denominator for the normalized counts
    denominator = np.sum(expected_counts)

    # Normalize the counts
    denoised_X = X * (expected_counts / denominator)

    # Add a small constant to avoid division by zero
    denoised_X += 1e-10

    return denoised_X
