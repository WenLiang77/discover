def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    
    # Step 1: Initialize the solution
    X_denoised = np.copy(X)
    
    # Step 2: Define the objective function
    def objective_function(X):
        return np.mean((X - X_denoised)**2)
    
    # Step 3: Minimize the objective function
    result = minimize(objective_function, X_denoised.flatten(), method='L-BFGS-B')
    
    # Step 4: Update the denoised matrix
    X_denoised = result.x.reshape(X.shape)
    
    # Step 5: Apply transformations to achieve Poisson distribution
    X_denoised_log = np.log(np.clip(X_denoised, 1e-6, None))
    X_denoised_poisson = np.exp(-X_denoised_log + np.max(X_denoised_log))
    
    # Step 6: Normalize the denoised data
    X_denoised_poisson /= np.sum(X_denoised_poisson)
    
