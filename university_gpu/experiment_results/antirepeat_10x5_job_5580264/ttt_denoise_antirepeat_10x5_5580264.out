def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Revert from normalized data back to raw count data
    raw_data = normalize(X.T, norm='l2', axis=1).T
    
    # Apply the MAGIC transformation to revert from normal count data to raw count data
    denoised_X = np.exp(raw_data - np.log(np.sqrt(2 * np.pi)))
    
    # Apply the second step of the MAGIC transformation to reverse the square root transform
    denoised_X = np.square(denoised_X)
    
    # Apply Poisson loss penalty to ensure the counts remain positive
    poisson_loss = np.zeros_like(denoised_X)
    poisson_loss[denoised_X < 1] = -np.log(poisson.pmf(denoised_X[denoised_X < 1], 1))
    poisson_loss += np.max(poisson_loss)
    
    # Ensure Poisson loss does not drop below 0.97
    poisson_loss = np.maximum(poisson_loss, 0.97)
    
    # Solve the optimization problem to find the new denoised counts
    _, denoised_X = spsolve(poisson_loss, denoised_X)
    
    # Clip negative values to zero
    denoised_X[denoised_X < 0] = 0
    
    # Clip very large values
    denoised_X[denoised_X > 2000000] = 2000000
    
    return denoised_X
