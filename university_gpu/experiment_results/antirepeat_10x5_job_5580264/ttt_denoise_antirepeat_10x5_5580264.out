def magic_denoise(X: np.ndarray, **kwargs: Dict) -> np.ndarray:
    """
    Denoises single-cell RNA-seq data by normalizing, applying principal component analysis,
    and then applying maximum likelihood estimation (MLE) for Poisson loss.

    Parameters:
    X (np.ndarray): Input count data with shape (n_cells, n_genes).
    
    Returns:
    np.ndarray: Denoised count data with shape (n_cells, n_genes).
