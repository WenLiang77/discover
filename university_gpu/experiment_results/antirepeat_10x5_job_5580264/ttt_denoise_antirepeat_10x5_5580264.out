def magic_denoise(X, **kwargs):
    # Normalization
    X_normalized = StandardScaler().fit_transform(np.log1p(X))

    # Principal Component Analysis (PCA)
    pca = PCA(n_components=2, random_state=42)
    X_pca = pca.fit_transform(X_normalized)

    # Nearest Neighbors (KNN) to find nearest neighbors
    knn = NearestNeighbors(n_neighbors=5, metric='euclidean', algorithm='auto')
    _, indices = knn.fit_predict(X_pca)

    # Poisson noise calculation
    poisson_noise = (0.257575 - minimize(lambda x: sum(poisson.pmf(y, x)), np.mean(X_normalized.flatten())).x) / (0.257575 - 0.031739)

    # Denoised data
    denoised_data = X_normalized.copy()
    denoised_data[indices] *= 1 / (1 + poisson_noise * np.exp(-X_normalized[indices]))

    # Postprocessing
    denoised_data = normalize(denoised_data, axis=0)
    
    return denoised_data

