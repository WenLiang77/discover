def magic_denoise(X, **kwargs):
    """
    Denoise scRNA-seq count data using a combination of PCA, nearest neighbors, and Poisson regression.

    Args:
        X (np.ndarray): Raw count data of shape (n_cells, n_genes).
        **kwargs: Optional keyword arguments:
            budget_s (float): Time budget in seconds.
            random_state (int): Random seed for reproducibility.
            knn (int): Number of nearest neighbors for neighborhood search.
            t (float): Threshold for detecting outlier points.
            n_pca (int): Number of principal components to retain.
            solver (str): Optimization solver for Poisson regression.
            decay (float): Decay factor for Poisson regression.
            knn_max (int): Maximum number of neighbors to consider in the neighborhood search.
            n_jobs (int): Number of jobs for parallel processing.

    Returns:
        np.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    # Step 1: Center and normalize count data
    scaler = StandardScaler(with_mean=True, with_std=False)
    X_normalized = scaler.fit_transform(X)

