Generated code preview:
def magic_denoise(X, **kwargs):
    # Normalize count data
    X_mean = X.mean(axis=1, keepdims=True)
    X_std = X.std(axis=1, keepdims=True)
    X_normalized = (X - X_mean) / X_std
    
    # Fit a Gaussian Mixture Model (GMM) to the normalized data
    from sklearn.mixture import GaussianMixture
    gmm = GaussianMixture(n_components=X_normalized.shape[1], covariance_type='full')
    gmm.fit(X_normalized)
    
    # Reconstruct the original counts using the GMM means
    reconstructions = gmm.means_ + np.zeros_like(X_normalized).T
    
    # Denoise the reconstructed counts
    denoised_counts = np.clip(reconstructions, 0, None)
    
    # Evaluate MSE and Poisson loss
    mse_score = calculate_mse(denoised_counts, X)
    poisson_loss_val = evaluate_poisson_loss(denoised_counts, X)
    
    return denoised_counts, mse_score, poisson_loss_val
