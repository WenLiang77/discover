def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)

    # Check if input matrix is square
    if X.shape[0] != X.shape[1]:
        raise ValueError("Input matrix must be square")

    # Normalize raw counts
    normalizer = StandardScaler()
    normalized_X = normalizer.fit_transform(X)

    # Perform PCA
    pca = PCA(n_components=10, random_state=0)
    reduced_X = pca.fit_transform(normalized_X)

    # Predict count values
    predicted_counts = reduced_X * 10  # Example scaling factor

    # Apply Poisson noise model
    poisson_noise = np.random.poisson(predicted_counts)
    final_counts = predicted_counts + poisson_noise

    # Check if final counts satisfy Poisson constraint
    if np.mean(final_counts <= 0) > 0.03:
        return None

    # Normalize final counts
    final_counts = normalize(final_counts, axis=0, norm='l1')

    return final_counts
