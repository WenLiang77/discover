def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    pca = PCA(n_components=20, random_state=0)
    X_pca = pca.fit_transform(X)

    neighbors = NearestNeighbors(n_neighbors=15, metric='euclidean').fit(X_pca)
    nearest_indices = neighbors.kneighbors()

    def poisson_loss(posterior_counts, observed_counts):
        loss = np.sum((p - observed_counts) ** 2) + np.sum(np.log(p))
        return loss

    def objective_function(posterior_counts):
        posterior_counts = np.clip(posterior_counts, 0, None)
        return poisson_loss(posterior_counts, X[:, 0])

    initial_guesses = np.zeros_like(X)
    bounds = ((0, 1),) * len(initial_guesses)
    constraints = ({'type': 'eq', 'fun': lambda x: np.mean(x)}, {'type': 'eq', 'fun': lambda x: np.mean(1 - x)})

    results = minimize(objective_function, initial_guesses, method='SLSQP', bounds=bounds, constraints=constraints)

    if results.success:
        return results.x
    else:
        raise Exception("Denoising failed")

