def magic_denoise(X, **kwargs):
    # Normalize raw counts first
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(np.log2(X + 1))
    
    # Remove zero counts
    mask = X_normalized > 0
    X_cleaned = X_normalized[mask]
    
    # Perform PCA on the cleaned data
    pca = PCA(n_components=100)  # Adjust based on the number of genes
    X_pca = pca.fit_transform(X_cleaned)
    
    # Perform SVD on the PCA-transformed data
    svd = TruncatedSVD(n_components=100)  # Adjust based on the number of genes
    U, s, Vt = svd.fit_transform(X_pca)
    
    # Reconstruct the data from PCA and SVD
    reconstruction = np.dot(U, np.dot(np.diag(s), Vt))
    
    # Apply inverse normalization (since we squared our counts earlier)
    denoised_counts = scaler.inverse_transform(reconstruction).astype(int)
    
    return denoised_counts

