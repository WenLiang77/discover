Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    n_cells, n_genes = X.shape
    # Normalize raw data using PCA
    pca = PCA(n_components=n_genes)
    scaled_data = pca.fit_transform(X)

    # Apply square root transformation
    sqrt_scaled_data = np.sqrt(scaled_data)

    # Use nearest neighbors for denoising
    knn = NearestNeighbors(n_neighbors=3, metric='euclidean')
    knn.fit(sqrt_scaled_data)
    distances, indices = knn.kneighbors(sqrt_scaled_data)

    # Denoise counts by mixing nearest neighbor means
    mean_counts = []
    for i in range(n_cells):
        neighbors_counts = sqrt_scaled_data[indices[i]]
        mean_counts.append(np.mean(neighbors_counts))

    denoised_data = np.array(mean_counts).reshape((n_cells, 1))
    denoised_data = np.minimum(denoised_data, np.log(10))  # Ensure non-negativity

    # Scale back to original size
    if kwargs.get('pca', False):
        denoised_data = pca.inverse_transform(denoised_data)
    else:
        denoised_data = normalize(denoised_data, axis=1)

    return denoised_data

