def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Calculate log-normalized counts
    log_normalized_counts = lognormalize_counts(X)
    
    # Fit poisson model
    params = fit_poisson_model(log_normalized_counts)

    # Predict denoised counts
    denoised_counts = log_normalized_counts.copy()
    for i in range(denoised_counts.shape[0]):
        # Adjusted count matrix for each cell
        adjusted_counts = np.exp(params + denoised_counts[i])
        # Update log-normalized counts
        log_normalized_counts[i] = np.log(adjusted_counts / denoised_counts[i])

    # Remove negative values
    denoised_counts = np.where(denoised_counts < 0, 0, denoised_counts)

    return denoised_counts
