def magic_denoise(X, beta=0.5, budget_s=400, random_state=None, **kwargs):
    # Normalize raw data
    if random_state is None:
        random_state = np.random.RandomState()
    
    n_cells, n_genes = X.shape
    
    # Calculate variance-stabilizing transformation scaling factor
    var_stab_scaling = np.power(np.mean(X), -beta)
    
    # Apply variance-stabilizing transformation
    X_transformed = np.sqrt(var_stab_scaling) * X
    
    # Apply Poisson normalization
    X_poison_normalized = np.array([poisson.ppf(x) for x in X_transformed.flatten()]).reshape((n_cells, n_genes))
    X_poison_normalized = np.clip(X_poison_normalized, 1e-6, None)
    
    # Apply inverse Poisson transformation (reconstructing counts)
    X_denoised = X_poison_normalized * var_stab_scaling
    
    # Apply mean-centering to get more stable predictions
    X_denoised -= np.mean(X_denoised)
    
    # Ensure outputs are finite and non-negative
    X_denoised = np.maximum(X_denoised, 0.0)
    
    return X_denoised
