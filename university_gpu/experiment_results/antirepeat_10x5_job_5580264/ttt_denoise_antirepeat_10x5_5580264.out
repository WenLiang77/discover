def magic_denoise(X, budget_s=100, random_state=None, knn=5, t=0.05, n_pca=10, solver='lbfgsb', decay=0.1, knn_max=20, n_jobs=-1, **kwargs):
    rng = np.random.default_rng(random_state)

    # Normalize and center the data
    scaler = StandardScaler()
    X = scaler.fit_transform(X)

    # Perform PCA
    pca = PCA(n_components=n_pca)
    X_pca = pca.fit_transform(X)

    # Compute nearest neighbors
    nn = NearestNeighbors(n_neighbors=knn, metric='euclidean')
    distances, indices = nn.kneighbors(X_pca)
    neighborhood_scores = [min(distances[i][j], knn_max) for i in range(X.shape[0]) for j in range(X.shape[0])]
    
    # Denoise based on neighborhood scores
    denoised_counts = []
    for cell_idx in range(X.shape[0]):
        cell_scores = neighborhood_scores[cell_idx] * (1 - t)
        denoised_count = np.sum((X_pca[cell_idx] / cell_scores).clip(min=0))
        denoised_counts.append(denoised_count)

    # Refine denoised counts using Poisson loss
    poisson_loss = lambda x: poisson.pmf(x, np.exp(np.mean(denoised_counts))).sum() / len(denoised_counts)
    result = minimize(poisson_loss, denoised_counts, bounds=[(0, None)]*len(denoised_counts), method=solver)
    final_d
