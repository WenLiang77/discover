def magic_denoise(X, budget_s, random_state=42, knn=10, t=3, n_pca=None, solver='lbfgs', decay=0.01, knn_max=50, n_jobs=-1):
    """
    Magic denoising algorithm for single-cell RNA-seq count data.
    
    Parameters:
    - X: numpy array of shape (n_cells, n_genes) - raw count data
    - budget_s: int - total budget for optimization
    - random_state: int - seed for reproducibility
    - knn: int - number of nearest neighbors for Poisson noise reduction
    - t: float - threshold for filtering low-count genes
    - n_pca: int or None - number of principal components for dimensionality reduction
    - solver: str - optimization solver
    - decay: float - learning rate decay factor for optimizer
    - knn_max: int - maximum number of neighbors to consider
    - n_jobs: int or None - number of jobs for parallel processing
    
    Returns:
    - numpy array of shape (n_cells, n_genes) - denoised count data
    """
    # Step 1: Scale count data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    
