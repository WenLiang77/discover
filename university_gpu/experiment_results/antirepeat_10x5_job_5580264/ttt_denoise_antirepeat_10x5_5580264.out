def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)

    # Normalize the data
    X /= X.sum(axis=1, keepdims=True)

    # Denoise by subtracting the mean
    denoised_X = X - X.mean(axis=0)

    # Apply square root transformation again to stabilize Poisson distribution
    denoised_X = np.sqrt(denoised_X)

    # Ensure positive values (reduces bias)
    denoised_X = np.where(denoised_X < 1e-6, 0.0, denoised_X)

    # Reapply mean normalization
    denoised_X /= denoised_X.mean(axis=0)

    # Ensure the output is finite and non-negative
    denoised_X = np.where(denoised_X <= 0.0, 1e-6, denoised_X)

    # Apply Poisson loss constraints (not included in this script but necessary in practice)
    # This step would typically involve solving a minimization problem based on Poisson loss
    # which is beyond the scope of this script and is not implemented here

    return denoised_X
