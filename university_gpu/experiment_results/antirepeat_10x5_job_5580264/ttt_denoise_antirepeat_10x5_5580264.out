def magic_denoise(X, **kwargs):
    """Denoise raw or log counts, then normalize using square root transform"""
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Remove outliers and low counts
    med = np.median(X)
    X = np.clip(X, a_min=med * 0.1, a_max=None)

    # Normalize using square root transform
    X = np.sqrt(X)

    # Apply Poisson loss constraint
    poisson_loss = lambda x: -(x * np.log(x + 1)).sum()
    poisson_norm = minimize(poisson_loss, X.flatten()).fun

    while poisson_norm < 0.97:
        poisson_loss = lambda x: -(x * np.log(x + 1)).sum()
        poisson_norm = minimize(poisson_loss, X.flatten()).fun

    return X
