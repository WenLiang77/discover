def magic_denoise(X, **kwargs):
    # Normalize the raw counts by subtracting the mean and dividing by the standard deviation
    normalized_X = normalize(X)

    # Center the data around zero
    centered_X = normalized_X - np.mean(normalized_X, axis=0)

    # Apply Principal Component Analysis to reduce dimensionality
    pca = PCA(n_components=min(500, X.shape[1]))
    X_pca = pca.fit_transform(centered_X)

    # Train a nearest neighbor model on the PCA-transformed data
    nn_model = NearestNeighbors(n_neighbors=10, metric='euclidean', p=1, leaf_size=30)
    nn_model.fit(X_pca)

    # Predict the nearest neighbors for each cell
    _, indices = nn_model.kneighbors(X_pca)

    # Estimate the true counts based on the nearest neighbors
    true_counts = np.zeros_like(X)
    for i, neighbors in enumerate(indices):
        neighbor_counts = X[neighbors]
        true_counts[i] = np.sum(np.log2(neighbor_counts + 1))

    # Convert back to log-normal counts and renormalize
    log_normal_counts = np.exp(true_counts)
    normalized_log_normal_counts = log_normal_counts / np.sum(log_normal_counts, axis=1, keepdims=True)

    return normalized_log_normal_counts
