def magic_denoise(X, **kwargs):
    """Denoise scRNA-seq count data using a novel method"""
    # Normalize raw count data
    normalized_count_data = normalize_counts(X)
    
    # Apply square root transform
    transformed_count_data = apply_sqrt_transform(normalized_count_data)
    
    # Initialize the denoised data
    denoised_count_data = transformed_count_data.copy()
    
    # Minimize Poisson loss while satisfying the Poisson constraint
    def objective(params):
        posterior_probs = poisson.pmf(transformed_count_data.ravel(), params).reshape(normalized_count_data.shape)
        poisson_loss_value = compute_poisson_loss(posterior_probs, transformed_count_data.ravel())
        return poisson_loss_value
    
    initial_guess = [np.mean(transformed_count_data)] * transformed_count_data.shape[1]
