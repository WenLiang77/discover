def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize to log-normal distribution
    log_X = np.log(X + 1e-6)
    
    # Fit a Gaussian Mixture Model to the normalized data
    means, covariances = fit_gaussian_mixture_model(log_X)

    # Predict denoised counts
    denoised_counts = reconstruct_counts(log_X, means, covariances)
    
    # Convert back to counts
    denoised_counts = np.exp(denoised_counts) - 1
    
    # Apply Poisson constraints
    denoised_counts = clip_to_non_negative_and_zero(denoised_counts)
    denoised_counts = apply_poisson_constraints(denoised_counts)
    
    return denoised_counts

