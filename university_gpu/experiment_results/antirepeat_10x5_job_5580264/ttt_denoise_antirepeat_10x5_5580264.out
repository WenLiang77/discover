    scaled_X = scaler.fit_transform(X)

    # PCA transformation
    pca = PCA(n_components=50)
    principalComponents = pca.fit_transform(scaled_X)

    # Reconstructing the counts after PCA
    reconstructed_counts = pca.transform(principalComponents)

    # Poisson loss minimization
    initial_guess = np.random.rand(X.shape[1])
    constraints = {'type': 'eq', 'fun': lambda x: x.sum()}
    result = minimize(poisson_loss, initial_guess, args=(reconstructed_counts,), method='BFGS', constraints=constraints)

    # Inverse scaling and applying the Poisson correction
    inv_scaler = StandardScaler().inverse_transform(scaler.transform(X))
    denoised_X = inv_scaler * np.exp(result.x)

    # Check Poisson constraint
    poisson_norm = (0.257575 - result.fun) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint violated. Score ~ {:.4f}".format(poisson_norm))

    return denoised_X
