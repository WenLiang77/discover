def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Normalize raw count data
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Step 2: Apply square root transformation for variance stabilization
    X_normalized = np.sqrt(X_normalized)

    # Step 3: Apply Poisson transformation
    def poisson_loss(y_true, y_pred):
        y_pred = np.clip(y_pred, 1e-6, None)
        return -np.sum(poisson.logpmf(y_true, y_pred))

    def optimize_poisson(y):
        objective = lambda x: poisson_loss(y, np.exp(x))
        initial_guess = np.zeros_like(y)
        result = minimize(objective, initial_guess, bounds=(0.0, None))
        return result.x

    X_poisson = np.apply_along_axis(optimize_poisson, axis=1, arr=X_normalized)

    # Ensure the result remains within [1, inf)
    X_denoised = np.maximum(X_poisson, 1.0)

    return X_denoised
