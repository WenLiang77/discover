def magic_denoise(X, **kwargs):
    # Normalize raw count data
    normalized_X = StandardScaler().fit_transform(np.log2(X + 1))

    # Dimensionality reduction
    n_pca = kwargs.get('n_pca', 50)
    if n_pca > 0:
        pca_model = PCA(n_components=n_pca).fit(normalized_X)
        reduced_X = pca_model.transform(normalized_X)
    else:
        reduced_X = normalized_X

    # Denoise using Lasso on reduced data
    penalty = kwargs.get('penalty', 1e-6)
    alpha = penalty * np.sum(reduced_X[reduced_X != 0] / reduced_X.shape[0])
    lasso_mask = np.abs(lasso.coef_) >= alpha
    denoised_reduced_X = lasso_mask * reduced_X

    # Reconstruct original data
    denoised_X = pca_model.inverse_transform(denoised_reduced_X)

    # Normalize reconstructed data back to log-count space
    denoised_counts = denoised_X.T

    return denoised_counts

