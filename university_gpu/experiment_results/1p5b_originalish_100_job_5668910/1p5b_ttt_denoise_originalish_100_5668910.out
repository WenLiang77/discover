def magic_denoise(X, **kwargs):
    # Normalize raw counts first
    normalized_counts = normalize(X, axis=1)

    # Compute nearest neighbors
    nn = NearestNeighbors(n_neighbors=5).fit(normalized_counts)
    distances = distance_matrix(normalized_counts, normalized_counts)
    neighbor_indices = nn.kneighbors_graph(distances).toarray()

    # Perform principal component analysis
    pca = PCA(n_components=200, random_state=kwargs.get('random_state', 0))
    reduced_data = pca.fit_transform(normalized_counts)

    # Fit Poisson distribution to the data
    def objective(params):
        mu = params[0]
        return np.mean(poisson.pmf(reduced_data.flatten(), mu))

    initial_guess = [np.median(reduced_data.flatten())]
    result = minimize(objective, initial_guess, bounds=[(0, None)], method='L-BFGS-B')
    poisson_mu = result.x[0]

    # Predict the denoised counts
    predicted_counts = np.exp(reduced_data / poisson_mu)
    denoised_counts = np.clip(predicted_counts, 0, None)

    return denoised_counts
