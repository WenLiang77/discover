def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(denoised_X):
        poisson_loss = np.mean(poisson.pmf(X.ravel(), denoised_X.ravel()))
        normalized_mse = np.mean((denoised_X.ravel() - X.ravel())**2)
        return poisson_loss + normalized_mse

    initial_guess = np.zeros_like(X)
    bounds = [(0.0, None)] * X.shape[1]
    constraints = [{'type': 'ineq', 'fun': lambda x: poisson.logpmf(x, X.ravel()).sum()}]

    result = minimize(objective, initial_guess, method='BFGS', bounds=bounds, constraints=constraints, options={'maxiter': 1000})
    denoised_X = result.x.reshape(X.shape)

    # Ensure the output is finite and non-negative
    denoised_X = np.clip(denoised_X, 0.0, None)
    return denoised_X
