    X = np.asarray(X, dtype=float)
    
    # Reverse normalization to stabilize Poisson distribution
    X_stabilized = np.log(X + 1.0e-6)
    X_reversed = np.exp(X_stabilized)
    X_reversed /= np.sum(X_reversed)
    
    # Apply PCA to reduce dimensionality
    pca = PCA(n_components=100, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X_reversed)
    
    # Apply nearest neighbors to estimate the mean of neighboring cells
    nn = NearestNeighbors(n_neighbors=10, metric='euclidean')
    nn.fit(X_pca)
    
    # Estimate the mean expression for each cell
    means = nn.kneighbors_graph().toarray() @ X_pca
    
    # Denoise the raw counts
    denoised_counts = X_reversed.copy()
    for i in range(len(denoised_counts)):
        denoised_counts[i] -= means[i]
    
    # Reapply reverse normalization
    denoised_counts_stabilized = np.log(denoised_counts + 1.0e-6)
    denoised_counts_reversed = np.exp(denoised_counts_stabilized)
    denoised_counts_reversed /= np.sum(denoised_counts_reversed)
    
    # Normalize back to original scale
    denoised_counts_reversed /= np.max(denoised_counts_reversed)
    
    return denoise
