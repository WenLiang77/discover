def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Normalize
    scaler = StandardScaler()
    X_norm = scaler.fit_transform(X)

    # Step 2: PCA
    pca = PCA(n_components=X_norm.shape[1])
    X_pca = pca.fit_transform(X_norm)

    # Step 3: Denoise using Poisson loss
    n_features = X_pca.shape[1]
    initial_guess = np.zeros((n_features,))
    
    def poisson_loss(denoised_data):
        nonlocal X_pca, initial_guess
        residuals = X_pca[:, :] - denoised_data.reshape((-1, 1))
        return np.sum(residuals * poisson.logpdf(residuals))

    result = minimize(poisson_loss, initial_guess, method='Powell')
    denoised_data = result.x.reshape((n_features,))

    # Step 4: Reconstruct
    reconstructed_data = pca.inverse_transform(denoised_data.reshape((-1, 1)))
    denoised_X = scaler.inverse_transform(reconstructed_data)

    return denoised_X

