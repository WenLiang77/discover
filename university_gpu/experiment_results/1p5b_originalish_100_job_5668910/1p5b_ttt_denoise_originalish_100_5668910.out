def magic_denoise(X, budget_s=400, random_state=None, knn=5, t=100, n_pca=50, solver='svd', decay=0.99, knn_max=100, n_jobs=-1, **kwargs):
    # Step 1: Handle missing values and zeros
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 2: Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X + 1e-8)

    # Step 3: Normalize X_sqrt
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_sqrt)

    # Step 4: Apply PCA
    pca = PCA(n_components=n_pca)
    X_pca = pca.fit_transform(X_scaled)

    # Step 5: Apply nearest neighbors
    nn = NearestNeighbors(n_neighbors=knn, metric='euclidean')
    distances, indices = nn.kneighbors(X_pca)

    # Step 6: Perform iterative denoising using Poisson loss
    def objective(denoised_counts):
        residuals = X_scaled - normalize(denoised_counts)
        return np.sum(residuals ** 2)

    initial_guess = np.zeros_like(X_scaled)
    bounds = [(0, None)] * X_scaled.shape[0] * X_scaled.shape[1]
    constraints = ({'type': 'ineq', 'fun': lambda x: x})

    result = minimize(objective, initial_guess, method=solver, bounds=bounds, constraints=constraints,
