def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: PCA for dimensionality reduction
    pca = PCA(n_components=min(X.shape), random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X)

    # Step 2: Apply square root transformation to stabilize Poisson distribution
    X_stab = np.sqrt(X_pca)

    # Step 3: Compute nearest neighbors
    nn = NearestNeighbors(n_neighbors=kwargs.get('knn', 5), metric='euclidean')
    distances, indices = nn.fit_predict(X_stab)

    # Step 4: Minimize Poisson loss subject to Poisson constraint
    def poisson_loss(denoised, observed):
        return sum(np.log(poisson.pdf(observed[i], denoised[i])) for i in range(len(observed)))

    def poisson_constraint(x):
        return sum(poisson.cdf(x[i], x[i]) for i in range(len(x))) - 1

    initial_guess = np.mean(X_stab, axis=0)
    result = minimize(poisson_loss, initial_guess, args=(X_stab,), constraints=[{'type': 'ineq', 'fun': poisson_constraint}])

    denoised = result.x

    # Step 5: Reverse normalization
    denoised = normalize(denoised.reshape(-1, 1)).flatten()

  
