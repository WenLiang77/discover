def magic_denoise(X, **kwargs):
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize counts to mean 0 and std 1
    X = StandardScaler().fit_transform(X)
    
    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)
    
    # Compute pairwise distances between cells
    D = distance_matrix(X)
    
    # Find nearest neighbors
    nn = NearestNeighbors(n_neighbors=1).fit(D)
    indices = nn.kneighbors(X)[1]
    
    # Initialize weights based on nearest neighbors
    weights = np.ones_like(X)
    weights[indices] = 0.5
    
    # Solve the optimization problem to minimize Poisson loss
    res = minimize(lambda x: poisson.pmf(x, np.mean(x)).sum() * np.log(poisson.pmf(x, np.mean(x))), 
                   x0=X, args=(D, weights), method='BFGS', bounds=[(0, None)] * X.shape[1])
    
    # Ensure the result is within bounds
    res.x[res.x < 1] = 0
    
    return res.x
