def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts using the square root transformation
    sqrt_counts = np.sqrt(X)
    sqrt_counts = np.clip(sqrt_counts, 1e-6, None)  # Avoid division by zero
    sqrt_counts = np.log(sqrt_counts)

    # Perform dimensionality reduction using PCA
    pca = PCA(n_components=X.shape[1], random_state=kwargs.get('random_state', 42))
    reduced_counts = pca.fit_transform(sqrt_counts)

    # Reconstruct counts using the principal components
    reconstructed_counts = pca.inverse_transform(reduced_counts)

    # Apply Poisson transformation to the reconstructed counts
    poisson_counts = np.exp(reconstructed_counts)

    # Ensure the counts are finite and non-negative
    poisson_counts = np.clip(poisson_counts, 1e-6, None)

    return poisson_counts
