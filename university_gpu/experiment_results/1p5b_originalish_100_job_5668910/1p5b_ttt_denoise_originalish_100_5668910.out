def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Apply square root transformation to stabilize Poisson distribution
    X_stabilized = np.sqrt(X + 1e-5)
    
    # Normalize count data
    X_normalized = normalize(X_stabilized, axis=0, norm='l1')
    
    # Apply PCA for dimensionality reduction
    pca = PCA(n_components=100)
    X_pca = pca.fit_transform(X_normalized)
    
    # Apply Truncated SVD for further dimensionality reduction
    tsvd = TruncatedSVD(n_components=50)
    X_tsvd = tsvd.fit_transform(X_pca)
    
    # Apply nearest neighbors for density estimation
    nn = NearestNeighbors(metric='euclidean', n_neighbors=50)
    _, _, indices = nn.kneighbors(X_tsvd)
    
    # Calculate Poisson loss
    poisson_loss = calculate_poisson_loss(indices, X_tsvd)
    
    # Calculate MSE
    mse = np.mean((X_tsvd - X_tsvd.mean(axis=0)) ** 2)
    
    # Calculate normalized MSE
    normalized_mse = mse / np.max(mse)
    
    # Check Poisson loss condition
    if poisson_loss < 0.97:
        raise ValueError("Poisson loss is below the threshold.")
    
    return X_tsvd


