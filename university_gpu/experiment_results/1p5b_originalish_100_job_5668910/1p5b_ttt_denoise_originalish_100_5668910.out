def magic_denoise(X, **kwargs):
    # Normalize raw/log counts first
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize variance
    X = np.sqrt(X)

    # Compute nearest neighbors
    k_neighbors = kwargs.get('knn', 10)
    nn = NearestNeighbors(n_neighbors=k_neighbors).fit(X)
    distances, indices = nn.kneighbors(X)
    
    # Compute Laplacian matrix
    laplacian = (-1 * np.eye(X.shape[0])) + np.dot(distances[:, :k_neighbors], distances[:, :k_neighbors].T) / (2 * k_neighbors * np.sum(distances, axis=1))

    # Compute eigenvectors and eigenvalues
    _, eigenvectors = np.linalg.eigh(laplacian)
    
    # Compute principal components
    n_pca = kwargs.get('n_pca', 100)
    pca = PCA(n_components=n_pca).fit(eigenvectors)
    X_pca = pca.transform(X)

    # Apply dimensionality reduction
    if kwargs.get('solver', 'svd') == 'svd':
        X_reduced = SVD(X_pca, compute_uv=False, full_matrices=True)
    elif kwargs.get('solver', 'truncated_svd') == 'truncated_svd':
        X_reduced = TruncatedSVD(n_components=n_pca).fit_transform(X_pca)
    else:
        raise
