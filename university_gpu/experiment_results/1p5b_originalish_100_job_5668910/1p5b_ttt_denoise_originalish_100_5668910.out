def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    norm = np.sqrt(np.sum(X))
    X /= norm

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)

    # Minimize Poisson loss subject to the constraint
    def poisson_loss(denoised):
        return np.mean(poisson.pmf(X, denoised))

    bounds = [(0.0, None)]
    result = minimize(poisson_loss, x0=X.ravel(), method='L-BFGS-B', bounds=bounds)
    denoised_X = result.x.reshape(X.shape)

    # Ensure denoised counts are non-negative
    denoised_X = np.clip(denoised_X, 0.0, None)

    # Reapply square root transformation
    denoised_X = np.square(denoised_X)

    # Normalize again to ensure the sum of each row is 1
    denoised_X /= np.sum(denoised_X, axis=1, keepdims=True)

    return denoised_X
