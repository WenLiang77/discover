        # Compute neighborhood information
        kNN = NearestNeighbors(n_neighbors=5).fit(X)
        distances = kNN.kneighbors_graph().toarray()
        
        # Calculate weights based on nearest neighbors
        weights = np.sum(distances, axis=1) + 1
        
        # Update counts using Poisson loss
        X_new = X * weights
        
        # Normalize counts
        X_new = normalize(X_new, axis=1, norm='l2')
        
        # Apply square root transformation
        X_new = np.sqrt(X_new)
        
        # Apply Poisson loss constraint again
        X_new[X_new < 1] = 0
        
        # Check convergence
        if np.allclose(X, X_new, atol=1e-3):
            break
        X = X_new
    
    # 
