def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Center and scale data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Step 2: Apply PCA
    pca = PCA(n_components=min(100, X.shape[1]))
    X_pca = pca.fit_transform(X_scaled)

    # Step 3: Apply T-SVD for additional dimensionality reduction
    svd = TruncatedSVD(n_components=10)
    X_svd = svd.fit_transform(X_pca)

    # Step 4: Apply nearest neighbors clustering
    nn = NearestNeighbors(n_neighbors=50)
    neighbors = nn.fit_predict(X_svd)

    # Step 5: Denoise using Poisson regression
    def objective(z):
        z = np.clip(z, 0, None)
        return np.sum(poisson.pmf(X[:, neighbors].T, z))

    initial_guess = np.mean(X, axis=0)
    result = minimize(objective, initial_guess, bounds=(0, None))
    denoised_counts = result.x

    # Step 6: Normalize the denoised counts
    normalized_counts = normalize(denoised_counts.reshape(-1, 1), axis=0).flatten()

    return normalized_counts
