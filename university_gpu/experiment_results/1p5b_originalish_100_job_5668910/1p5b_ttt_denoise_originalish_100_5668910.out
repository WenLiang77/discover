def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize count data using square root transformation
    X_normalized = np.sqrt(X)

    # Apply Poisson normalization
    poisson_mean = np.mean(X_normalized)
    poisson_std = np.std(X_normalized)
    X_poisoned = X_normalized / poisson_mean
    X_poisoned = np.clip(X_poisoned, 1e-6, None)

    # Compute the mean Poisson normalized value
    poisson_norm = np.mean(np.log(poisson_mean * X_poisoned))

    # Check Poisson constraint
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint not satisfied")

    # Denoise the data by setting low-count values to zero
    denoised_X = np.where(X_poisoned > 1, X_poisoned, 0)

    return denoised_X
