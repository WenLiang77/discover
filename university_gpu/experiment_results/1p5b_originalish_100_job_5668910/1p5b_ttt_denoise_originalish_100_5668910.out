def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Reversion normalization of raw counts
    X_reverted = np.log(X + 1)

    # Step 2: Denoising using Poisson loss
    def objective(denoised):
        denoised = np.clip(denoised, 0, None)
        poisson_counts = np.sum(poisson.pmf(np.clip(denoised, 0, None), np.arange(1, X.shape[1] + 1)), axis=1)
        return np.mean((denoised - poisson_counts) ** 2)

    initial_guess = np.zeros_like(X_reverted)
    result = minimize(objective, initial_guess, bounds=[(None, None)] * X_reverted.size, constraints={'type': 'ineq', 'fun': lambda x: X_reverted - x})

    if result.success and result.fun > 0.031739:
        denoised = result.x.reshape(X.shape)
        denoised = np.exp(denoised)
        return denoised
    else:
        raise ValueError("Denoising failed")
