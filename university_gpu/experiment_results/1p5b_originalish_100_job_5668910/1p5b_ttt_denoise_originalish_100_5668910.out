def magic_denoise(X, budget_s=400, random_state=None, knn=3, t=0.5, n_pca=0, solver='svd', decay=0.05, knn_max=100, n_jobs=-1):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply dimensionality reduction
    if n_pca > 0:
        X_reduced = PCA(n_components=n_pca).fit_transform(X)
    else:
        X_reduced = X

    # Apply nearest neighbor graph construction
    nn_graph = NearestNeighbors(n_neighbors=knn, metric='euclidean').fit(X_reduced)
    distances, indices = nn_graph.kneighbors(X_reduced)

    # Apply time series filtering
    filtered_distances = np.minimum(distances.T[indices], distances.T[indices].T)
    filtered_X = np.sum(filtered_distances * X, axis=1) / np.sum(filtered_distances, axis=1)

    # Apply square root transformation to stabilize Poisson distribution
    filtered_X = np.sqrt(filtered_X + 1e-6)

    # Apply Poisson loss constraint
    def poisson_loss(x):
        return np.mean(poisson.pmf(x, np.exp(filtered_X)) * x)

    initial_guess = np.array([1] * X.shape[0])
    result = minimize(poisson_loss, initial_guess, method='BFGS')

    if result.fun > 0.031739:
        raise Va
