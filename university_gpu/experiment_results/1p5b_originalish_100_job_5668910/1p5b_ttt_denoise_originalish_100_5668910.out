def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation to stabilize Poisson distribution
    X_transformed = np.sqrt(X + 1e-6)

    # Step 2: Compute nearest neighbors
    nn = NearestNeighbors(n_neighbors=5, metric='euclidean').fit(X_transformed)
    distances, indices = nn.kneighbors(X_transformed)

    # Step 3: Compute weights based on distance
    weights = 1 / (1 + distances ** 2)

    # Step 4: Estimate mean and covariance matrix
    y_mean = np.mean(X_transformed, axis=0)
    y_cov = np.cov(X_transformed.T, rowvar=False)

    # Step 5: Solve for the inverse covariance matrix
    inv_y_cov = np.linalg.inv(y_cov)

    # Step 6: Compute the estimated expression levels
    y_hat = np.dot(inv_y_cov, y_mean * weights[:, np.newaxis])

    # Step 7: Re-transform the denoised data
    denoised_X = np.square(y_hat)

    return denoised_X
