def magic_denoise(X, **kwargs):
    # Normalize raw count data first
    X = normalize(X, axis=1)

    # Apply square root transformation
    X = np.sqrt(X)

    # Perform PCA on normalized data
    pca = PCA(n_components=X.shape[1], random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X)

    # Remove components with low variance
    variances = np.var(X_pca, axis=0)
    threshold = np.mean(variances) * 0.99
    X_pca_filtered = X_pca[:, variances >= threshold]

    # Apply Poisson noise model
    def poisson_loss(posterior_counts):
        return np.sum(poisson.pmf(np.arange(len(posterior_counts)), posterior_counts)) * len(posterior_counts)

    def objective(denoised_counts):
        posterior_counts = np.exp(denoised_counts)
        return poisson_loss(posterior_counts)

    initial_guess = np.zeros_like(X_pca_filtered)
    bounds = [(0, None) for _ in range(X_pca_filtered.shape[0])]
    constraints = [{'type': 'eq', 'fun': lambda x: np.sum(x) - X_pca_filtered.shape[0]}]
    
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, constraints=constraints, options={'maxiter': 1000, 'disp': True})

    if not result.success:
       
