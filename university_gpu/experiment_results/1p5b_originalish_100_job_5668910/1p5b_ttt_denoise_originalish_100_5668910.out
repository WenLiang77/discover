    # Ensure the input is a numpy array
    X = np.array(X)

    # Convert count data to log-normalized space
    X_log = np.log(X + 1)

    # Normalize the log-counts
    X_log /= np.sqrt(np.sum(X_log**2, axis=1))[:, None]

    # Calculate the mean and standard deviation of each gene
