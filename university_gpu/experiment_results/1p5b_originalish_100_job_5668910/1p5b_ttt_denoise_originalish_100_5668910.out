def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transform to stabilize Poisson distribution
    X_sqrt = np.sqrt(X)

    # Normalize the transformed counts
    X_sqrt_norm = normalize(X_sqrt, axis=1)

    # Apply square root inverse transformation back to counts
    X_denormalized = np.square(X_sqrt_norm)

    # Apply Poisson loss to ensure non-negative counts
    denoised_counts = np.clip(X_denormalized, 0.0, None)

    return denoised_counts
