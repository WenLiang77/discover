def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation
    X_sqrt = np.sqrt(X)

    # Normalize using standard scaler
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_sqrt)

    # Perform principal component analysis (PCA)
    pca = PCA(n_components=10)
    X_pca = pca.fit_transform(X_scaled)

    # Predicted counts
    predicted_counts = pca.components_.T @ X_pca

    # Convert back to original scale
    predicted_counts = scaler.inverse_transform(predicted_counts)

    # Apply square root transformation
    predicted_counts_sqrt = np.sqrt(predicted_counts)

    # Apply inverse square root transformation
    predicted_counts = np.where(predicted_counts_sqrt > 0, predicted_counts_sqrt, 0)

    # Apply poisson loss to ensure non-negative counts
    predicted_counts = np.clip(predicted_counts, 0, None)

    return predicted_counts

