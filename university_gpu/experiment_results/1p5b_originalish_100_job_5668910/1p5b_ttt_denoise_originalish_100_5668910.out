def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Center the data around the median
    X_centered = X - np.median(X, axis=0)

    # Step 2: Compute the nearest neighbor distances
    nn_distances = distance_matrix(X_centered, X_centered)

    # Step 3: Construct the adjacency matrix
    nn_matrix = np.exp(-nn_distances / kwargs.get('t', 5))

    # Step 4: Perform SVD on the adjacency matrix
    U, s, Vt = np.linalg.svd(nn_matrix, full_matrices=False)

    # Step 5: Apply PCA to reduce dimensionality
    pca = PCA(n_components=kwargs.get('n_pca', 100))
    X_pca = pca.fit_transform(X_centered)

    # Step 6: Fit a Poisson model to the PCA-transformed data
    X_fit = np.dot(X_pca, Vt.T)
    poisson_loss = minimize(lambda x: -np.sum(x * poisson.pmf(X_fit, x)), x0=np.zeros(len(Vt.T)))

    # Step 7: Backtransform the denoised data
    X_denoised = np.dot(pca.inverse_transform(X_fit), Vt.T) + np.mean(X, axis=0)

    # Step 8: Clip the denoised data to ensure it's non-negative and finite
    X_denoised = np.clip(X_denoised, 0.0, np.inf)

    return X_denoised

