def magic_denoise(X, **kwargs):
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize counts to mean 0 and std 1
    scaler = StandardScaler(with_mean=True, with_std=True)
    scaled_X = scaler.fit_transform(X)
    
    # Apply square root transformation to stabilize Poisson distribution
    scaled_X = np.sqrt(scaled_X)
    
    # Apply Poisson loss constraint to ensure non-negative counts
    scaled_X[scaled_X < 1] = 0
    
    # Compute nearest neighbors to get the nearest gene's average expression
    nn = NearestNeighbors(n_neighbors=1).fit(scaled_X)
    neighbor_distances, neighbor_indices = nn.kneighbors(scaled_X)
    neighbor_averages = scaled_X[neighbor_indices, :].mean(axis=1)
    
    # Denoise by replacing each cell's expression with its nearest gene's average
    denoised_X = scaled_X.copy()
    denoised_X += neighbor_averages.reshape(-1, 1)
    
    # Reapply normalization to ensure the output has the same scale as input
    denoised_X = scaler.inverse_transform(denoised_X)
    
    return denoised_X
