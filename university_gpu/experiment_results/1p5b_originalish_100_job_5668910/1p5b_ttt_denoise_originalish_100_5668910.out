def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X = np.sqrt(X)

    # Step 2: Apply PCA for dimensionality reduction
    pca = PCA(n_components=min(10, X.shape[1]))
    X_pca = pca.fit_transform(X)

    # Step 3: Normalize the PCA-transformed data
    X_normalized = normalize(X_pca, axis=0, norm='l2')

    # Step 4: Apply Poisson loss optimization
    def objective(denoised):
        poisson_loss = poisson.pmf(np.clip(denoised, 1e-10, None), np.exp(X))
        poisson_norm = ((denoised < 1) * poisson_loss).mean()
        return poisson_norm + (poisson_loss / len(X))

    initial_guess = np.zeros_like(X)
    result = minimize(objective, initial_guess, method='Nelder-Mead', options={'disp': False})
    denoised_X = result.x

    # Step 5: Final post-processing to ensure valid results
    denoised_X = np.maximum(denoised_X, 0.0)

    # Convert back to square root and unnormalize
    denoised_X = np.square(denoised_X)
    denoised_X = normalize(denoised_X, axis=0, norm='l2')
    denoised_X = np.maximum(denoised_X, 0.0)

    return d
