def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # PCA for dimensionality reduction
    pca = PCA(n_components=50, random_state=42)
    X_pca = pca.fit_transform(X)

    # Normalize the PCA-transformed data
    X_normalized = normalize(X_pca, axis=0)

    # Standardize the normalized data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_normalized)

    # Apply inverse scaling to get back to original range
    X_inverse_scaled = scaler.inverse_transform(X_scaled)

    # Apply inverse PCA transform to get back to original dimensions
    X_denormalized = pca.inverse_transform(X_inverse_scaled)

    # Ensure output is finite and non-negative
    X_denormalized[X_denormalized < 0] = 0.0

    return X_denormalized
