def magic_denoise(X, **kwargs):
    """
    Denoise single-cell RNA-seq count data.

    Parameters
    ----------
    X : np.ndarray, shape (n_cells, n_genes)
        Raw count data.

    Returns
    -------
    np.ndarray, shape (n_cells, n_genes)
        Denoised count data.
    """

    # Step 1: Normalize raw count data
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Step 2: Apply PCA for dimensionality reduction
    pca = PCA(n_components=50, svd_solver='randomized', random_state=42)
    X_pca = pca.fit_transform(X_normalized)

    # Step 3: Apply LASSO regression to denoise the data
    lasso_params = {
        'alpha': 0.1,
        'max_iter': 1000,
        'tol': 1e-5,
        'warm_start': True
    }
    lasso_model = Minimize(lambda x: np.linalg.norm(x), args=(X_pca,), method='trust-constr', options=lasso_params)

    denoised_data = lasso_model.fun

    # Step 4: Reconstruct the data from the denoised components
    reconstruction = pca.inverse_transform(denoised_data.reshape(-1, 1)).flatten()

    # Step 5: Apply inverse scaling to get back to raw count space
    denoised_counts = scaler.inverse_transform(reconstruction.reshape(1, -1))


