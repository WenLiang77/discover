def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.

    Parameters
    ----------
    X : numpy.ndarray
        Raw count data of shape (n_cells, n_genes).
    
    Returns
    -------
    numpy.ndarray
        Denoised count data of shape (n_cells, n_genes).
    """

    # Step 1: Normalize raw counts
    X_normed = normalize(X, axis=0)

    # Step 2: Apply PCA to reduce dimensionality
    pca = PCA(n_components=100)
    X_pca = pca.fit_transform(X_normed)

    # Step 3: Apply nearest neighbor clustering
    nn = NearestNeighbors(metric='euclidean')
    nn.fit(X_pca)
    neighbors = nn.kneighbors(X_pca, return_distance=False)

    # Step 4: Estimate abundance from nearest neighbors
    abundance_estimates = []
    for i in range(X.shape[0]):
        neighbors_i = neighbors[i]
        neighbors_counts = [X[neighbor] for neighbor in neighbors_i]
        abundance_estimate = np.mean(neighbors_counts)
        abundance_estimates.append(abundance_estimate)

    # Step 5: Scale estimates back to original scale
    scaled_abundance_estimates = abundance_estimates / abundance_estimates.mean()

