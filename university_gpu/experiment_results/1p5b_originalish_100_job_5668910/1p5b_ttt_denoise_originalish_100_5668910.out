def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.

    Args:
        X: numpy array of shape (n_cells, n_genes) - raw count data
        **kwargs: additional keyword arguments

    Returns:
        numpy array of shape (n_cells, n_genes) - denoised counts
