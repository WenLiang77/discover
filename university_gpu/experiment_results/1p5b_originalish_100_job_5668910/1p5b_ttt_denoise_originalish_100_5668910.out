def magic_denoise(X, **kwargs):
    # Denoise raw/log counts first
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)

    # Normalize counts
    X = normalize(X)

    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=10)
    X_pca = pca.fit_transform(X)

    # Fit nearest neighbors model
    nn = NearestNeighbors(n_neighbors=5)
    nn.fit(X_pca)

    # Denoise counts using nearest neighbors approach
    def objective(denoised_counts):
        distances, indices = nn.kneighbors(denoised_counts, return_distance=True)
        penalty = np.sum(distances[:, :5])
        loss = np.mean(poisson(denoised_counts).log() + penalty)
        return loss

    initial_guess = np.ones_like(X_pca) * X_pca.mean()
    bounds = [(0.0, None) for _ in range(len(initial_guess))]
    constraints = {'type': 'ineq', 'fun': lambda x: np.sum(x)}
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, constraints=constraints)

    # Denoise back to original space
    denoised_X = normalize(result.x)
    denoised_X = denoised_X ** 2  # Untransf
