def magic_denoise(X, **kwargs):
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X)

    # Apply Poisson loss constraint to ensure non-negative counts
    X[X < 1] = 0

    # Use Poisson loss minimization to find the optimal count values
    def objective(x):
        nonlocal X, poisson_lambda
        predicted_counts = np.exp(poisson.pmf(np.arange(len(X[0])), poisson_lambda) * X.sum(axis=0)
        loss = np.mean((predicted_counts - X) ** 2)
        return loss

    poisson_lambda = X.sum() / X.shape[0]
    result = minimize(objective, X.flatten(), method='L-BFGS-B', bounds=[(0, None)] * len(X.flatten()))

    denoised_X = result.x.reshape(X.shape)

    return denoised_X
