def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalization order matters: denoise raw/log counts first, then normalize
    if 'normalized' in kwargs and kwargs['normalized']:
        # Reverse normalization order for better results
        X = reverse_normalize(X)

    # Principal Component Analysis (PCA)
    pca = PCA(n_components=X.shape[1])
    X_pca = pca.fit_transform(X)

    # Truncated Singular Value Decomposition (TSVD)
    tsvd = TruncatedSVD(n_components=min(100, X.shape[1]))
    X_tsvd = tsvd.fit_transform(X)

    # Combine PCA and TSVD components
    X_combined = np.hstack((X_pca, X_tsvd))

    # Normalize combined data
    X_combined_normalized = normalize(X_combined, axis=0, norm='l2')

    # Apply inverse PCA transformation to get denoised counts
    denoised_X = pca.inverse_transform(X_combined_normalized)

    # Ensure the output is finite and non-negative
    denoised_X = np.clip(denoised_X, 0.0, None)

    return denoised_X

def reverse_normalize(X):
