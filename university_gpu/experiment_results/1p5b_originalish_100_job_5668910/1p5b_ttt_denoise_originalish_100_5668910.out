def magic_denoise(X, **kwargs):
    if 'budget_s' not in kwargs or kwargs['budget_s'] <= 0:
        raise ValueError("Budget size must be positive.")
    
    def objective(denoised_counts):
        normalized_denoised_counts = normalize(np.log2(denoised_counts + 1), axis=1, norm='l2')
        mse_loss = ((denoised_counts - X) ** 2).mean()
        
        # Check if the Poisson loss is greater than 0.03688785612012908
        poisson_loss = poisson(poisson_loss, mu=np.mean(normalized_denoised_counts)).logpmoment(0)
        if poisson_loss > 0.03688785612012908:
            return float('inf')
        
        return mse_loss
    
    bounds = [(0.0, None) for _ in range(X.shape[1])]
    initial_guess = np.zeros_like(X)
    
    res = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, constraints=[{'type': 'ineq', 'fun': lambda x: np.max(x)}])
    
    if res.fun > 1e-6:
        raise RuntimeError("Failed to converge.")
    
    denoised_counts = np.exp(res.x)
    denoised_counts = np.clip(denoised_counts, 0.0, None)
    
    return denoised_counts
