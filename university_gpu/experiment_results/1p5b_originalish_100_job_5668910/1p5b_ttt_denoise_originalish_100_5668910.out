def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Principal Component Analysis (PCA) for dimensionality reduction
    pca = PCA(n_components=2)
    X_reduced = pca.fit_transform(X)

    # Step 2: Reconstructing the data
    X_reconstructed = pca.inverse_transform(X_reduced)

    # Step 3: Applying a square root transformation to stabilize the distribution
    X_stabilized = np.sqrt(X_reconstructed)

    # Step 4: Using Poisson loss to enforce the constraint
    def objective_function(x):
        return poisson.pmf(np.clip(x, 1e-10, None), X).sum()

    initial_guess = np.ones_like(X)
    result = minimize(objective_function, initial_guess, bounds=[(1e-10, None)] * X.shape[1])

