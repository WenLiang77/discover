def magic_denoise(X, **kwargs):
    """Denoises single-cell RNA-seq count data."""
    
    def poisson_loss(denoised_counts):
        """Compute the Poisson negative log-likelihood."""
        counts = X + denoised_counts
        if np.any(counts <= 0):
            return float('inf')
        return -np.sum(poisson.pmf(counts, counts).log())
    
    def objective_function(denoised_counts):
        """Objective function to minimize for denoising."""
        return poisson_loss(denoised_counts)
    
    def initial_guess():
        """Initial guess for denoising."""
        return np.zeros_like(X)
    
    bounds = [(0.0, None) for _ in range(X.shape[1])]
    
    res = minimize(objective_function, initial_guess(), method='L-BFGS-B', bounds=bounds)
    denoised_counts = res.x
    
    # Apply constraints
    denoised_counts = np.clip(denoised_counts, 0.0, X.max())
    
    # Normalize denoised counts
    denoised_counts = normalize(denoised_counts)
    
    # Convert back to log-counts if necessary
    denoised_counts = np.exp(denoised_counts)
    
    return denoised_counts
