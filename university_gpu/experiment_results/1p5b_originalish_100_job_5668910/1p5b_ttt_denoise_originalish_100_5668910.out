def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalization Order matters: Raw/Log Counts -> Log Counts -> Normalize
    X_log = np.log2(X + 1)  # Log2 transformation to stabilize Poisson distribution
    X_scaled = normalize(X_log, axis=1, norm='l1')  # L1 normalization

    # Denoising using Poisson Negative Log-Likelihood
    p = poisson.pmf(np.arange(1, 100), mean=X_scaled).T
    neg_ll = np.sum(p * X_scaled, axis=1)

    # Minimize negative log-likelihood to get the denoised counts
    result = minimize(neg_ll, X_scaled.flatten(), method='L-BFGS-B', bounds=[(0, None)]*len(X_scaled.flatten()))
    denoised_counts = result.x.reshape(X.shape)

    # Reverting back to original order
    denoised_counts = np.exp(denoised_counts)

    return denoised_counts

