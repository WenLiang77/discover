def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X + 1e-9)

    # Step 2: Perform PCA on the transformed data
    pca = PCA(n_components=10)
    X_pca = pca.fit_transform(X_sqrt)

    # Step 3: Apply thresholding to remove noise
    threshold = np.quantile(X_pca.flatten(), 0.97)
    denoised_X = np.where(X_pca > threshold, X_pca, 0.0)

    # Step 4: Convert back to raw counts
    denoised_X = np.square(denoised_X)
    denoised_X = denoised_X * np.exp(-denoised_X / 2)

    return denoised_X
