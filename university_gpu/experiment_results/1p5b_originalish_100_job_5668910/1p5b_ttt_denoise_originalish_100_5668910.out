def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation
    X_sqrt = np.sqrt(X)

    # Normalize each column
    X_scaled = normalize(X_sqrt, axis=0)

    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=50)
    X_pca = pca.fit_transform(X_scaled)

    # Minimize Poisson loss
    def poisson_loss(params, X):
        return np.sum((params - X)**2)

    initial_params = np.random.rand(X_pca.shape[1])
    result = minimize(poisson_loss, initial_params, args=(X_pca,), method='L-BFGS-B', bounds=[(0, None)]*X_pca.shape[1])

    # Apply inverse square root transformation
    denoised_X = np.exp(result.x)

    return denoised_X
