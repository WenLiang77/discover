def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Revert normalization order
    X = np.log2(X + 1)

    # Apply square root transformation
    X = np.sqrt(X)

    # Normalize using robust methods
    scaler = StandardScaler()
    scaled_X = scaler.fit_transform(X)

    # Denoise using Poisson loss
    def poisson_loss(y_true, y_pred):
        return np.mean(poisson(y_true).logpm1() - y_true * y_pred)

    def objective(x):
        denoised = np.exp(x)
        y_pred = denoised + 1
        loss = poisson_loss(scaled_X, y_pred)
        return loss

    initial_guess = np.zeros_like(X.flatten())
    result = minimize(objective, initial_guess, bounds=(0, None))

    if result.fun > 0.97:
        raise ValueError("The Poisson constraint is not met.")

    denoised = np.exp(result.x)
    denoised = denoised.reshape(X.shape)

    # Normalize back
    normalized_denoised = normalize(denoised)

    return normalized_denoised
