def magic_denoise(X, **kwargs):
    """
    Magic denoising method based on PCA and inverse transformation.
    
    Args:
    X (numpy.ndarray): N x M numpy array of raw count data (N cells, M genes).
    **kwargs: Additional keyword arguments for custom configurations.
    
    Returns:
    numpy.ndarray: N x M numpy array of denoised count data.
    """

    # Step 1: Normalize count data
    X_normalized = normalize(X, axis=1)

    # Step 2: Apply PCA to reduce dimensionality
    pca = PCA(n_components=1, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X_normalized)

    # Step 3: Invert the PCA transformation
    X_inverted = pca.inverse_transform(X_pca)

    # Step 4: Apply reverse transformation to get count data back
    X_denoised = X_inverted * kwargs.get('t', 1.0)

    # Step 5: Apply Poisson distribution to each gene
    X_denoised_poisson = np.minimum(np.ceil(X_denoised), X_denoised * kwargs.get('decay', 0.1))

    # Step 6: Normalize back to log scale
    X_denoised_log = np.log2(X_denoised_poisson + 1e-6)

    # Step 7: Clip values below zero to zero
    X_denoised_log = np.clip(X_denoised_log, 0, None)

    # Step 8: Ensure output is finit
