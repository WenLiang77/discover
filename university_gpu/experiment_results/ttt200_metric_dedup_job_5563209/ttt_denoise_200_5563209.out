def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Perform PCA to reduce dimensionality
    pca = PCA(n_components=0.95, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X)

    # Step 2: Fit linear regression to the PCA-transformed data to get coefficients
    reg = LinearRegression(fit_intercept=False).fit(X_pca, X.flatten())

    # Step 3: Denoise the count data using the fitted model
    denoised_counts = reg.predict(X_pca).reshape(X.shape)

    # Step 4: Apply square root transform to stabilize Poisson distribution
    denoised_counts = np.sqrt(denoised_counts)

    # Step 5: Clip values to ensure they are positive
    denoised_counts = np.maximum(denoised_counts, 0.0)

    return denoised_counts

