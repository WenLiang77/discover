def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Initialize the principal components model
    pca = PCA(n_components=None, random_state=kwargs.get('random_state', 42))
    pca.fit(X)

    # Perform dimensionality reduction
    X_pca = pca.transform(X)

    # Apply the inverse transformation
    X_inv_transformed = pca.inverse_transform(X_pca)

    # Normalize counts
    X_normalized = normalize(X_inv_transformed)

    # Apply square root transformation
    X_sqrt_transposed = np.sqrt(np.transpose(X_normalized))

    # Apply Poisson regularization
    poisson_loss = lambda x: ((x * poisson.pmf(x)) @ X_norm).sum()
    initial_guess = np.zeros_like(X_sqrt_transposed)
    result = minimize(poisson_loss, initial_guess, method='Powell', bounds=((0.0, None),) * X_sqrt_transposed.shape[1])
    X_denoised = result.x * X_sqrt_transposed

    # Clip negative values
    X_denoised[X_denoised < 0] = 0

    return X_denoised

