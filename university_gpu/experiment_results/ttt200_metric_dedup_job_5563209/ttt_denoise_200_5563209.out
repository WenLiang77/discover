def magic_denoise(X, **kwargs):
    """Denoise single-cell RNA-seq count data."""
    
    # Handle missing values, convert to positive integer, and set threshold
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X[X < 1] = 1
    
    # Scale count data
    scaler = StandardScaler()
    scaled_X = scaler.fit_transform(X)
    
    # Principal Component Analysis for dimensionality reduction
    pca = PCA(n_components=min(100, X.shape[1]))
    reduced_X = pca.fit_transform(scaled_X)
    
    # Nearest neighbor graph creation
    neighbors = NearestNeighbors(n_neighbors=5)
    nn_graph = neighbors.fit(reduced_X)
    dist_matrix = distance_matrix(reduced_X, reduced_X, 'euclidean')
    nn_distances = np.clip(dist_matrix, 0, None)
    
    # Denoise count data using optimization with Nearest Neighbors information
    def objective(params):
        # Extract denoised counts
        denoised_counts = params.reshape((X.shape[0], X.shape[1]))
        
        # Denoise count data
        denoised_counts = reduce_sum(denoised_counts, axis=1).reshape(-1, 1) * poisson.pmf(reduce_sum(denoised_counts, axis=1), nn_distances, loc=0)
        denoised_counts = denoised_counts.clip(min=0)
 
