def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    
    # Normalize raw data first
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)
    
    # Apply PCA to reduce dimensions
    pca = PCA(n_components=100)  # Adjust as needed
    X_pca = pca.fit_transform(X_normalized)
    
    # Apply Lasso regression to estimate noise
    lambda_lasso = 0.1
    penalty = 'l1'
    lasso_model = LogisticRegression(penalty=penalty, C=lambda_lasso)
    lasso_model.fit(X_pca, np.zeros_like(X_pca))
    noise_estimate = X_pca * (lambda_lasso / lasso_model.coef_.sum())
    
    # Add noise to the original data
    denoised_data = X_normalized + noise_estimate
    
    # Normalize denoised data back to original scale
    denoised_data = scaler.inverse_transform(denoised_data)
    
    return denoised_data

