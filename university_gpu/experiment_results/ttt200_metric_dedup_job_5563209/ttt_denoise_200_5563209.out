def magic_denoise(X, **kwargs):
    # Normalize raw count data first
    normalized_X = normalize(X, axis=0)

    # Apply square root transformation for variance stabilization
    standardized_X = np.sqrt(normalized_X)

    # Perform Poisson normalization
    poissonscaled_X = standardized_X.clip(min=1e-9) / poisson.pmf(standardized_X)

    # Apply square root transformation back to get count data
    denoised_X = np.sqrt(poissonscaled_X)

    return denoised_X
