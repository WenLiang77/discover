def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)

    # Normalize the count matrix by row
    scaler = StandardScaler(with_mean=False)
    X_scaled = scaler.fit_transform(X)

    # Apply PCA to reduce dimensionality while preserving the variance of the data
    pca = PCA(n_components=0.95)
    X_pca = pca.fit_transform(X_scaled)

    # Compute pairwise distances between cells
    dists = distance_matrix(X_pca, X_pca)

    # Define the objective function to minimize
    def objective(dists, mu, sigma, beta):
        poisson_loss = np.mean(poisson(mu).logprob(dists))
        penalty = beta * np.linalg.norm(mu, ord=1)
        return poisson_loss + penalty

    # Initial guess for mu and sigma
    initial_guess_mu = np.ones((X.shape[0],)) * X.shape[1] // 2
    initial_guess_sigma = np.repeat(1., X.shape[0])

    # Constraints for mu
    constraints = [{'type': 'eq', 'fun': lambda x: x.sum()}]

