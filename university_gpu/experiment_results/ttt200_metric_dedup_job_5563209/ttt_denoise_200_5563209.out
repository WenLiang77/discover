def magic_denoise(X, **kwargs):
    # Normalize counts by square root transformation
    X_normalized = np.sqrt(X + 1e-5)

    # Fit nearest neighbor model on normalized data
    nn_model = NearestNeighbors(n_neighbors=5, metric='euclidean')
    nn_model.fit(X_normalized)

    # Predict neighbors' means (denoised values)
    denoised_X = nn_model.kneighbors_graph().toarray() * X_normalized.T.mean(axis=1).reshape(1, -1)

    # Apply square root transformation again and clip values to [0, inf)
    denoised_X = np.sqrt(denoised_X + 1e-5)
    denoised_X = np.clip(denoised_X, 0.0, np.inf)

    # Ensure the predicted denoised count values are positive
    denoised_X[denoised_X < 0] = 0.0

    # Check the Poisson norm constraint
    poisson_loss = np.sum(poisson.pmf(X_normalized.flatten(), denoised_X.flatten()) * X_normalized.flatten())
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson norm is below the threshold")

    return denoised_X
