def magic_denoise(X, budget_s=None, random_state=None, knn=None, t=None, n_pca=None, solver='bfgs', decay=1e-5, knn_max=20, n_jobs=-1):
    X = np.array(X, dtype=float)

    if random_state is None:
        random_state = np.random.randint(0, 10000)

    # Step 1: Normalize by square root transformation
    X_sqrt = np.sqrt(X + 1e-7)

    # Step 2: Principal Component Analysis (PCA)
    if n_pca is not None:
        pca = PCA(n_components=n_pca).fit(X_sqrt)
        X_pca = pca.transform(X_sqrt)
    else:
        X_pca = X_sqrt.copy()

    # Step 3: KNN denoising
    if knn is None:
        knn = NearestNeighbors(metric='euclidean').fit(X_pca)

    D = distance_matrix(X_pca, X_pca, metric='euclidean')
    A = np.exp(-D / t)
    W = np.where(A == 0, 1e-7, A)
    L = np.diag(np.sum(W, axis=1)) - W

    # Step 4: Solve the system
    b = np.zeros(X_pca.shape[0])
    b[knn.kneighbors().indices[1]] = 1 / t
    x = np.linalg.solve(L, b)

    # Step 5: Back-transform
    denoised_X = np.sqrt(x + 1e-7)

    # Step 6: Apply softmax to get non-negative counts
    max_val = np.max(denoised_X)
