    denoised_counts = rev_normalized_counts * 1.2 + np.random.normal(0, 0.1, size=(X.shape[0], X.shape[1]))

    # Ensure denoised_counts are finite and non-negative
    denoised_counts = np.clip(denoised_counts, 0, None)

    return denoised_counts

