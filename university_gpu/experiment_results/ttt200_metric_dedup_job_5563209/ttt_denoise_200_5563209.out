def magic_denoise(X, max_iter=1000, tol=1e-6, bounds=None):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize the data
    scaler = StandardScaler()
    X normalized = scaler.fit_transform(X)

    # Fit a Poisson distribution model to the data
    def objective(x):
        mu = np.dot(x, X.T)
        return -np.sum(poisson.pmf(np.exp(mu), X_normalized).sum(axis=-1))

    initial_guess = np.ones_like(normalized[0])
    result = minimize(objective, initial_guess, method='Nelder-Mead', options={'maxiter': max_iter, 'tol': tol, 'bounds': bounds})

    if result.success:
        # Transform back to original scale
        mu = np.dot(result.x, X.T)
        denoised_normalized = np.exp(mu)
        denoised = scaler.inverse_transform(denoised_normalized)
        return denoised
    else:
        raise ValueError(" Optimization failed")

