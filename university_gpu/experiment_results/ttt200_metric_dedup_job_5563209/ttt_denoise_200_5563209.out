def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Denoise raw counts first
    X = X + np.diag(np.random.normal(loc=0.0, scale=1e-5, size=X.shape[1]))

    # Normalize counts to mean 1 and standard deviation 1
    X = normalize(X, axis=1, p=1, norm='l1')

    # Apply square root transformation
    X = np.sqrt(X)

    # Fit a logistic model to the normalized counts
    logit_func = lambda y: logit(y)
    neg_log_like = lambda w: sum(-logit_func(w @ X))
    initial_w = np.random.normal(size=X.shape[1])
    result = minimize(neg_log_like, initial_w, bounds=[(None, None)] * X.shape[1])

    # Get the predicted probabilities
    predictions = sigmoid(result.x @ X)

    # Apply square root transformation
    predictions = np.sqrt(predictions)

    return predictions

