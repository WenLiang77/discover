def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Compute the mean across genes
    gene_means = np.mean(X, axis=1)

    # Step 2: Subtract the mean from each cell's data
    X_centered = X - gene_means.reshape(-1, 1)

    # Step 3: Apply square root transformation
    X_sqrt = np.sqrt(X_centered + 1e-6)

    # Step 4: Compute the covariance matrix
    cov_matrix = np.cov(X_sqrt, rowvar=False)

    # Step 5: Estimate the precision matrix
    precision_matrix = np.linalg.inv(cov_matrix)

    # Step 6: Apply the estimated precision matrix
    denoised_data = np.dot(precision_matrix, X_sqrt)

    # Step 7: Back-transform to original units
    denoised_data *= np.sqrt(2 * np.pi) / np.sqrt(np.diag(precision_matrix)) + 1

    return denoised_data

