def magic_denoise(X, **kwargs):
    # Normalize raw counts first
    X normalized = normalize(X, axis=1)

    # Reduce dimensionality using Principal Component Analysis
    pca = PCA(n_components='mle', random_state=kwargs.get('random_state'))
    X_reduced = pca.fit_transform(normalized)

    # Recreate counts from reduced coordinates
    X_recreated = normalize(pca.inverse_transform(X_reduced), axis=1)

    # Apply nearest neighbor correction
    nn = NearestNeighbors(10, 'brute')
    distances, indices = nn.kneighbors(X_recreated, return_distance=True)
    nearest_neighbors_counts = np.bincount(indices, weights=normalized[np.arange(len(X))], minlength=X.shape[1])
    X_corrected = nearest_neighbors_counts * normalized.reshape(-1, 1)

    # Apply Poisson loss regularization
    poisson_loss = 1e-3 * np.mean(poisson.pmf(X_corrected.ravel(), np.mean(normalized.ravel())))
    if poisson_loss < 0.031739:
        raise ValueError("Poisson loss < 0.031739, rejecting solution.")

    # Rescale to ensure non-negative values and finite
    X_denoised = np.clip(np.round(X_corrected), 0.0, None)

    return X_denoised
