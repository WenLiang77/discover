def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    X_norm = normalize(X, axis=0, norm='l1')

    # Apply nearest neighbor imputation
    nn = NearestNeighbors(n_neighbors=5, metric='euclidean').fit(X_norm)
    neighbors = nn.kneighbors(X_norm, return_distance=True)[0]
    
    for i, cell_idx in enumerate(neighbors):
        for j in range(len(cell_idx)):
            X[i] = np.where(X[i] == 0, X[cell_idx[j]], X[i])

    # Apply principal component analysis
    pca = PCA(n_components=10).fit(X)
    X = pca.transform(X)

    # Minimize Poisson loss
    def poisson_loss(denoised):
        normalized_counts = np.clip(denoised, 1e-8, None)
        normalized_log_counts = np.log(normalized_counts)
        return poisson.pmf(normalized_log_counts, X).mean()

    initial_guess = X.ravel()
    bounds = [(1e-8, None) for _ in range(X.size)]
    result = minimize(poisson_loss, initial_guess, bounds=bounds, method='Nelder-Mead')
    denoised_X = result.x.reshape(X.shape)

    return denoised_X
