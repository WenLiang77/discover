def magic_denoise(X, budget_s=2000, random_state=0, knn=5, t=1, n_pca=50, solver='lbfgs', decay=0.01, knn_max=30, n_jobs=-1):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

