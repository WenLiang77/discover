def magic_denoise(X, budget_s=400, random_state=None, knn=30, t=50, n_pca=200, solver='lsqr', decay=None, knn_max=50, n_jobs=-1):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Step 1: Standardize count data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    
    # Step 2: Perform dimensionality reduction using PCA
    pca = PCA(n_components=n_pca, random_state=random_state)
    X_reduced = pca.fit_transform(X_scaled)
    
    # Step 3: Learn nearest neighbors graph
    neighbors = NearestNeighbors(k=knn, metric='euclidean', n_jobs=n_jobs).fit(X_reduced)
    
    # Step 4: Estimate background count values
    background_counts = estimate_background_count(neighbors, X_reduced, knn_max)
    
    # Step 5: Apply poisson loss correction
    denoised_counts = apply_poisson_loss_correction(background_counts, X_scaled, neighbors, t=t, solver=solver, decay=decay)
    
    # Normalize denoised counts
    normalized_counts = normalize(denoised_counts)
    
    return normalized_counts

