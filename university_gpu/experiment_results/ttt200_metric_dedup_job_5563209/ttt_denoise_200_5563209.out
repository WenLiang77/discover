def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    scaler = StandardScaler(with_mean=False)
    X_scaled = scaler.fit_transform(X)

    # Apply square root transformation to stabilize Poisson distribution
    X_stabilized = np.sqrt(X_scaled)

    # Estimate the inverse of the Poisson distribution mean
    inv_poisson_mean = np.reciprocal(poisson.ppf(0.031739))

    # Denoise the stabilized values
    denoised_values = inv_poisson_mean * X_stabilized

    # Normalize denoised values to ensure they are non-negative
    denoised_values = np.clip(denoised_values, a_min=0.0)

    return denoised_values
