def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    
    # Apply square root transformation
    X = np.sqrt(X + 1e-6)
    
    # Apply normalization in log-space
    X_log = np.log(X + 1e-6)
    
    # Define objective function to minimize
    def objective(denoised_counts):
        normalized_counts = np.exp(denoised_counts) - 1e-6
        mse = np.mean((normalized_counts - X_log) ** 2)
        
        poisson_probs = poisson.pmf(X_log, denoised_counts)
        poisson_norm = np.mean(poisson_probs)
        
        return mse + (0.257575 - poisson_norm) * (0.257575 - 0.031739) * (1 - poisson_norm)
    
    # Initial guess (uniform distribution between min and max log-counts)
    initial_guess = np.linspace(np.min(X_log), np.max(X_log), num=X.shape[1])
    
    # Run optimization
    result = minimize(objective, initial_guess, bounds=(X_log.min(), X_log.max()), method='L-BFGS-B')
    
    denoised_counts = result.x
    
    return denoised_counts

