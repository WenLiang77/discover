def magic_denoise(X, **kwargs):
    """
    Denoise single-cell RNA-seq count data.

    Args:
        X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
    
    Returns:
        numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    # Normalize raw/Log-count data
    normalized_data = normalize_data(X)
    
    # Apply SVD denoising
    denoised_data = svd_denoise(normalized_data)
    
    # Apply Poisson regularization
    poisson_loss = poisson(denoised_data).logpmf(normalized_data).sum()
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    
    # Check Poisson constraint
    if poisson_norm < 0.97:
        raise ValueError("POISSON CONSTRAINT NOT MET")
    
    return denoised_data

