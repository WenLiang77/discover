def magic_denoise(X, epsilon=1e-6, max_iter=1000, tol=1e-5, **kwargs):
    assert X.ndim == 2, "Input matrix X must be a 2D numpy array"
    assert np.allclose(np.min(X), 0.), "Input matrix X cannot have any negative counts"
    
    N, M = X.shape
    
    # Define the objective function to minimize (negative log likelihood)
    def objective(params):
        lambda_val = params[0]
        beta = params[1:]
        
        log_likelihood = 0.0
        
        # Compute the expected counts using the logistic model
        log_probabilities = expit(-lambda_val * X @ beta)
        expected_counts = X.T @ log_probabilities
        
        # Calculate the log-likelihood contribution of each gene
        for i in range(M):
            observed_counts_i = X[:, i].flatten()
            poisson_loss_i = poisson.logpmf(observed_counts_i, expected_counts[i])
            
            # Add the Poisson loss term to the total log-likelihood
            log_likelihood += poisson_loss_i
        
        # Return the negative log-likelihood
        return -log_likelihood
    
