def magic_denoise(X, **kwargs):
    # Initialize parameters
    n_cells, n_genes = X.shape
    
    # Normalize raw counts
    # Reversed normalization order is preferred as it improves Poisson performance
    X_reversed = X.T
    
    # Apply square root transformation to stabilize Poisson distribution
    X_stabilized = np.sqrt(X_reversed)
    
    # Minimize negative log-likelihood of Poisson distribution
    def neg_log_likelihood(params, y):
        mu = params
        return -np.sum(poisson(y, mu))
    
    initial_guess = X_stabilized.mean(axis=0)
    bounds = [(0, None) for _ in range(n_genes)]
    
    result = minimize(neg_log_likelihood, initial_guess, args=(X_stabilized), bounds=bounds, method='L-BFGS-B')
    
    # Clip negative values to zero
    denoised_counts = np.clip(result.x, 0, None)
    
    # Convert back to original form (reversed and squared)
    denoised_counts = denoised_counts / np.sqrt(X_reversed).T
    
    # Normalization to avoid large values
    denoised_counts = normalize(denoised_counts, norm='l1', axis=1)
    
    return denoised_counts
