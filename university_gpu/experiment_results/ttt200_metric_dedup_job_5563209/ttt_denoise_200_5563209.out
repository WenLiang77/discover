def magic_denoise(X, **kwargs):
    # Normalization: Apply square root transform to stabilize the distribution
    sqrt_transformed = np.sqrt(np.clip(X, 0, None))
    
    # Denoising by subtracting mean and clipping to avoid NaN and infinite values
    denoised_sqrt = sqrt_transformed - np.mean(sqrt_transformed)
    denoised_sqrt = np.clip(denoised_sqrt, 0, None)
    
    # Convert back to original scale
    denoised_X = np.square(denoised_sqrt)
    
    # Check Poisson constraint
    if not np.all(poisson(0).logpmf(denoised_X) >= 0):
        raise ValueError("Denoised values violate the Poisson constraint.")
    
    return denoised_X

