def magic_denoise(X, **kwargs):
    # Initialize the PCA
    pca = PCA(n_components=X.shape[1], svd_solver='auto')
    transformed_data = pca.fit_transform(X)

    # Perform t-SVD
    tsvd = TruncatedSVD(n_components=1)
    tsvd_data = tsvd.fit_transform(transformed_data)

    # Apply standard scaling
    scaler = StandardScaler()
    scaled_data = scaler.fit_transform(tsvd_data)

    # Apply nearest neighbor search
    knn = NearestNeighbors(n_neighbors=10)
    _, indices = knn.kneighbors(scaled_data, metric='euclidean')

    # Calculate the mean of nearest neighbors
    means = [np.mean(X[i, j]) for i, j in enumerate(indices)]

    # Calculate the difference between each cell's count and its nearest neighbor's count
    diff = X - means

    # Compute Poisson loss
    poisson_loss = sum(poisson.pmf(diff[i], exp=-diff[i]) for i in range(X.shape[0]))

    # Check Poisson loss criteria
    if poisson_loss < 0.97:
        return np.array([])  # Return empty array if Poisson loss is below threshold

    # Reshape back to original space
    recovered_data = pca.inverse_transform(tsvd.inverse_transform(scaler.inverse_transform(diff)))
    recovered_data = np.maximum(recovered_data, 0.0)
