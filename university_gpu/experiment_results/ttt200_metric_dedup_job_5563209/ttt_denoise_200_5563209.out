def magic_denoise(X, **kwargs):
    """
    Magic denoises count data by initializing the variance as the square root of 
    the sum of the observed means squared.
    
    Parameters:
        X (numpy.ndarray): The input count data matrix.
        **kwargs: Additional keyword arguments.
        
    Returns:
        numpy.ndarray: The denoised count data matrix.
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize data first
    X_normalized = _normalize_data(X)
    
    # Initialize variance based on the sum of observed means squared
    mean_squared_values = np.mean(X_normalized, axis=0)
    initial_variance = np.sqrt(np.sum(mean_squared_values**2))
    
    # Define objective function
    def objective_function(params):
        return np.sum(((X_normalized @ params) - X)**2) + 0.5 * initial_variance * params.T @ params
    
    # Initial guess (uniform distribution over [0, 1])
    params = np.random.rand(X.shape[1])
    
    # Perform optimization
    result = minimize(objective_function, params, method='Powell', maxiter=100, tol=1e-6)
    
    if not result.success:
        raise 
