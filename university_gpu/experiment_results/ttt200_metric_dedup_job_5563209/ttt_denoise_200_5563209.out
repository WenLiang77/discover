Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X + 1e-6)

    # Fit Poisson model and get residuals
    mu = np.mean(X_sqrt)
    poisson_resids = X_sqrt - poisson(mu).rvs(size=X.shape)

    # Normalize residuals using standardScaler
    scaler = StandardScaler()
    scaled_resids = scaler.fit_transform(poisson_resids.reshape(-1, 1)).reshape(X.shape)

    # Apply inverse-square root transformation to rescale back to original scale
    denoised = scaled_resids ** 2

    # Clip denoised data to ensure non-negativity
    denoised[denoised < 0] = 0

    return denoised

