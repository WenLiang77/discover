def magic_denoise(X, budget_s=None, random_state=None, knn=10, t=0.1, n_pca=0, solver='exact', decay=0.0, knn_max=None, n_jobs=-1):
    if budget_s is None:
        budget_s = int(np.log2(len(X)) + 2)

    if random_state is None:
        random_state = np.random.randint(0, 2**31)

    # Normalize count data
    scaler = StandardScaler()
    scaled_X = scaler.fit_transform(X).clip(min=0.0, max=np.inf)

    # Apply principal components analysis (PCA)
    if n_pca > 0:
        pca = PCA(n_components=n_pca)
        scaled_X = pca.fit_transform(scaled_X)

    # Build nearest neighbor graph
    nbrs = NearestNeighbors(n_neighbors=knn, metric='euclidean').fit(scaled_X)
    dists, idxs = nbrs.kneighbors(scaled_X, return_distance=True)

    # Perform denoising
    n_cells, n_genes = scaled_X.shape
