def magic_denoise(X, **kwargs):
    """Denoise raw count data."""
    
    # Ensure X is a numpy array with the correct dtype
    X = np.asarray(X, dtype=float)
    
    # Handle NaN, positive infinity, negative infinity, and zero values
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize log-counts
    normalized_X = np.log2(X + 1e-6)  # Adding a small constant to avoid log(0)
    
