def magic_denoise(X, **kwargs):
    def _estimate_variance(data):
        """Estimate the variance of each gene."""
        variances = np.var(data, axis=0)
        return variances

    def _estimate_mean(data):
        """Estimate the mean of each gene."""
        means = np.mean(data, axis=0)
        return means

    def _predict_expression(means, variances, covar, observed_counts):
        """Predict expression levels using Gaussian mixture model."""
        covars_inv = np.linalg.inv(covar)
        posteriors = np.zeros_like(observed_counts)
        for i in range(observed_counts.shape[0]):
            for j in range(observed_counts.shape[1]):
                posterior = np.exp((-observed_counts[i, j] / 2) * (covars_inv @ (means[j] - observed_counts[i, j])))
                post_sum = np.sum([np.exp((-x / 2) * (covars_inv @ (means[k] - x))) for k in range(observed_counts.shape[1])])
                posteriors[i, j] = posterior / post_sum
        return posteriors

    def _update_covariance(posteriors, observed_counts, means):
        """Update the covariance matrix based on posteriors."""
        numerator = np.zeros((observed_counts.shape[1], observed_counts.shape[1]))
    
