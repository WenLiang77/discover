def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize the data
    scaler = StandardScaler()
    scaled_data = scaler.fit_transform(X)

    # Apply PCA and reduce dimensions
    pca = PCA(n_components=10)  # Adjust the number of components based on the dataset size
    principal_components = pca.fit_transform(scaled_data)

    # Apply nearest neighbors
    nn = NearestNeighbors(n_neighbors=5)
    neighbors = nn.fit(principal_components)

    # Predicted counts using nearest neighbors
    predicted_counts = []
    for i in range(len(neighbors)):
        idx = neighbors kneighbors[i][1]
        neighbors_count = scaled_data[idx]
        predicted_counts.append(np.sum(neighbors_count))

    # Normalize the predicted counts
    normalized_predicted_counts = normalize(predicted_counts.reshape(-1, 1), axis=0).flatten()

    # Apply inverse transformation
    final_counts = scaler.inverse_transform(normalized_predicted_counts)

    return final_counts

