def magic_denoise(X, **kwargs):
    if 'budget' in kwargs:
        print("Warning: Budget parameter ignored in magic_denoise.")
    
    # Normalize X
    X_mean = np.mean(X, axis=1).reshape(-1, 1)
    X_std = np.std(X, axis=1).reshape(-1, 1)
    X_scaled = (X - X_mean) / X_std
    
    # Apply PCA to reduce dimensionality (optional, depending on the data size and complexity)
    pca = PCA(n_components=None)
    X_pca = pca.fit_transform(X_scaled)
    
    # Apply T-SVD to further reduce dimensionality
    tsvd = TruncatedSVD(n_components=100)
    X_tsvd = tsvd.fit_transform(X_pca)
    
    # Scale the transformed data
    X_scaled_tsvd = normalize(X_tsvd)
    
    # Apply inverse scaling
    X_reconstructed = X_scaled_tsvd * X_std + X_mean
    
    return X_reconstructed
