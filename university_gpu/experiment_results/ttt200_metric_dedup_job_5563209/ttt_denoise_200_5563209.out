def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply PCA to reduce dimensionality (optional)
    pca = PCA(n_components=10)
    X = pca.fit_transform(X)

    # Apply standardization to normalize
    scaler = StandardScaler()
    X = scaler.fit_transform(X)

    # Train nearest neighbors model
    knn = NearestNeighbors(n_neighbors=5)
    knn.fit(X)

    # Perform denoising using a variant of MAGIC
    denoised_data = np.zeros_like(X)
    for i, x in enumerate(X):
        nn_indices = knn.kneighbors([x], return_distance=False)[0]
        mean_neighborhood = X[nn_indices].mean(axis=0)
        denoised_data[i] = mean_neighborhood

    # Apply inverse transformation back to log-normalized space
    denoised_data = np.exp(denoised_data)
    return denoised_data

