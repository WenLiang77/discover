def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Standardize the data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Apply PCA to reduce dimensions
    pca = PCA(n_components=min(50, X.shape[1]))
    X_pca = pca.fit_transform(X_scaled)

    # Fit a Gaussian process model
    from sklearn.gaussian_process import GaussianProcessRegressor
    gpr = GaussianProcessRegressor()
    gpr.fit(X_pca, X_scaled)

    # Predicted means for each cell gene pair after transformation
    pred_means = gpr.predict(X_pca)

    # Transform predicted means back to original units (log-counts)
    denoised_counts = np.exp(pred_means)

    return denoised_counts.astype(int)  # Ensure output is integer

# Example usage
