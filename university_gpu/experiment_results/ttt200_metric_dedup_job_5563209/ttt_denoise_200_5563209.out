def magic_denoise(X, **kwargs):
    # Step 1: Normalize raw count data
    X = StandardScaler().fit_transform(np.log2(X + 1))
    
    # Step 2: Perform principal component analysis
    pca = PCA(n_components=50)
    X_reduced = pca.fit_transform(X)
    
    # Step 3: Train a nearest neighbors model on the reduced data
    nn_model = NearestNeighbors(n_neighbors=50)
    nn_model.fit(X_reduced)
    
    # Step 4: Denoise each cell by fitting a poisson distribution to its nearest neighbors
    denoised_counts = []
    for i in range(X.shape[0]):
        # Get the closest neighbors
        distances, indices = nn_model.kneighbors([X_reduced[i]])
        neighbors_counts = X_reduced[indices].sum(axis=0)
        
        # Estimate the true count of gene i
        true_count = poisson.mean(neighbors_counts)
        
        # Ensure the true count is positive
        if true_count <= 0:
            true_count = 1
        
        # Add the denoised count to the list
        denoised_counts.append(true_count)
    
    # Step 5: Convert the denoised counts back to integer counts
    denoised_X = np.array(denoised_counts).reshape(X.shape)
    denoised_X = np.maximum(denoised_X, 0)
    
   
