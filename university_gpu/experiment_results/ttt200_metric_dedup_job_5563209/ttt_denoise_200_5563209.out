def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Revert normalization
    X_reverted = X * np.sqrt(X.sum(axis=1, keepdims=True))

    # Apply the Gaussian prior to denoise
    sigma = np.std(X_reverted)
    X_noisy = X_reverted + sigma * np.random.normal(size=X.shape)

    # Use Poisson model for denoising
    X_denoised = np.clip(np.exp(-X_noisy), 0, None)

    # Clip and scale back to the original scale
    X_denoised = X_denoised * np.sqrt(sigma) * np.mean(X_reverted, axis=1, keepdims=True)

    return X_denoised

