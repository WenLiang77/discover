    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X + 1)

    # Standardize the normalized data
    X_std = normalize(X_sqrt, axis=0, copy=False)

    # Apply dimensionality reduction
    pca = PCA(n_components=n_pca).fit(X_std)

    X_reduced = pca.transform(X_std)

    # Fit nearest neighbors
    nbrs = NearestNeighbors(k=knn, metric="euclidean").fit(X_reduced)

    def cost(params):
        # Calculate the Poisson loss
        return np.mean(poisson.pmf(np.exp(-params[0] * X_reduced), params[0]))

    initial_guess = [1.0]
    bounds = [(1e-6, None)]  # Ensure we don't have zero probability

    result = minimize(cost, initial_guess, bounds=bounds, method=solver, args=(knn_max,), tol=1e-6, options={'maxiter': 1000})

    if result.fun > 0.97:
        print("The Poisson constraint was not met. Skipping...")
     
