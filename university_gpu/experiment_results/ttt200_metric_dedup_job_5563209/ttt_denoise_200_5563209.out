def magic_denoise(X, **kwargs):
    # Normalize raw counts first, then apply noise reduction techniques
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Initialize PCA with the desired number of components
    pca = PCA(n_components=min(100, X.shape[1]))
    X_pca = pca.fit_transform(X)

    # Apply a Gaussian filter to reduce noise
    from scipy.ndimage.filters import gaussian_filter
    sigma = np.sqrt(np.var(X_pca))
    X_filtered = gaussian_filter(X_pca, sigma=sigma)

    # Apply Poisson normalization
    mean_exp = np.mean(X_filtered, axis=1)[:, np.newaxis]
    X_denoised = np.exp(-(X_filtered / mean_exp))

    # Convert back to log-transformed space if needed
    # X_denoised_log = np.log2(X_denoised)

    return X_denoised
