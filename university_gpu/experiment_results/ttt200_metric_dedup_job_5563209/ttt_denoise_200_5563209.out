def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation for Poisson likelihood
    X = np.sqrt(X)

    # Normalize counts to have mean 0, std 1
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Compute pairwise distances between cells
    dist = distance_matrix(X_normalized)

    # Find nearest neighbors
    kNN = NearestNeighbors(n_neighbors=5, metric='precomputed').fit(dist)
    nn_indices = kNN.kneighbors(return_distance=False)[0]

    # Initialize weights matrix
    weights = np.ones_like(X_normalized)

    # Iterate through genes
    for gene in range(X_normalized.shape[1]):
        # Calculate the Poisson rate based on nearest neighbors
        neighbor_rates = np.array([X_normalized[i, gene] for i in nn_indices[:, gene]])
        lambda_ = np.mean(neighbor_rates)

        # Compute the optimal weight
        cost = lambda_ * np.exp(-lambda_) - np.sum(lambda_ * X_normalized[:, gene])
        grad = lambda_ * np.exp(-lambda_) - X_normalized[:, gene]
        weights[:, gene] = minimize(cost, x0=lambda_, jac=grad).x
