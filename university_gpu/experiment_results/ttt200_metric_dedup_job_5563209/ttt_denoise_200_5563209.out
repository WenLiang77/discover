def magic_denoise(X, budget_s=400, random_state=None, knn=5, t=1, n_pca=2, solver='lbfgs', decay=1e-4, knn_max=None, n_jobs=-1):
    # Normalize raw data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Apply PCA
    pca = PCA(n_components=n_pca, svd_solver=solver, random_state=random_state)
    X_pca = pca.transform(X_scaled)

    # Calculate distances using kNN
    nn = NearestNeighbors(n_neighbors=knn, metric='euclidean')
    dists, _ = nn.kneighbors(X_pca)

    # Calculate weights based on nearest neighbors
    weights = np.exp(-dists**t)

    # Initialize the optimization problem
    def objective(x):
        denoised_X = X_pca * x[:, None]
        normalized_denoised_X = normalize(denoised_X, axis=1)
        poisson_loss = poisson(normalized_denoised_X.flatten()).logp(X_pca.flatten())
        mse = np.mean((normalized_denoised_X.flatten() - X_pca.flatten())**2)
