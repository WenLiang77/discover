Generated code preview:
def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.

    Parameters:
    - X: numpy array of shape (n_cells, n_genes) - raw count data
    
    Returns:
    - numpy array of same shape - denoised counts
    """

    # Ensure X is float and positive
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)

    # Normalize count data
    X = normalize(X, axis=1, norm='l1')

    # Apply square root transform to stabilize Poisson distribution
    X = np.sqrt(X)

    # Apply Poisson noise model
    poisson_model = lambda x: poisson.pmf(x, 1).flatten()
    constraints = ({'type': 'ineq', 'fun': lambda x: poisson_model(x)})

    # Minimize poisson loss with constraints
    result = minimize(lambda x: (x * poisson_model(x)).sum(), X.flatten(), method='SLSQP', bounds=(0, None), constraints=constraints)

    # Denoise counts
    denoised_counts = result.x.reshape(X.shape)

    # Reapply square root transform and denormalize
    denoised_counts = np.square(denoised_counts)
    denoised_counts = np.sqrt(denoised_counts)
    denoised_counts = normalize(denoised_counts, axis=1, norm='l1')

    return denoised_counts
