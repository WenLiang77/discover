def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm.
    
    Args:
        X (numpy.ndarray): Input raw count data (shape: (n_cells, n_genes))
        
    Returns:
        numpy.ndarray: Denoised count data (shape: (n_cells, n_genes))
    """
    # Normalize count data
    X = np.maximum(X, 0.0)
    X = np.log(X + 1)

    # PCA step
    pca = PCA(n_components=0.95, random_state=kwargs.get('random_state', None))
    X_pca = pca.fit_transform(X)

    # Reconstruction step
    cov_matrix = X_pca.T.dot(X_pca) / len(X_pca)
    eighvals, eighvecs = np.linalg.eig(cov_matrix)
    eigenvals_sorted_idx = np.argsort(eighvals)[::-1]
    eigenvectors_selected = eighvecs[:, eigenvals_sorted_idx]
    reconstructed_data = pca.inverse_transform(eigenvalues_selected @ eighvecs_selected.T)

    # Inverse transform log-normalized data back to counts
    denoised_counts = np.exp(reconstructed_data) - 1

    # Apply Poisson noise constraint
    penalty = lambda x: poisson.pmf(x, np.mean(denoised_counts)) - denoised_counts
    initial_guess = np.random.randn(len(denoised_counts))
    result = minimize(penalty, initial_guess)
    denoised_counts_constrained = result.x.astype(int)

    
