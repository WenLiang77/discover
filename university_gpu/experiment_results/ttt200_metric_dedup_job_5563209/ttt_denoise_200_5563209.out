def magic_denoise(X, **kwargs):
    X_normed = magic_normalize(X)
    n_cells, n_genes = X_normed.shape
    
    # Principal Component Analysis (PCA)
    pca = PCA(n_components=min(n_cells, n_genes))
    X_pca = pca.fit_transform(X_normed)
    
    # Nearest Neighbors
    knn = NearestNeighbors(metric='euclidean', n_neighbors=10)
    knn.fit(X_pca)
    distances, indices = knn.kneighbors(X_pca)
    
    # Denoise by minimizing Poisson loss
    objective = lambda x: poisson.pmf(x, 1 + distances).sum() - len(x)
    initial_guess = np.ones(n_cells) / n_cells
    result = minimize(objective, initial_guess, bounds=(0, 1), method='L-BFGS-B')
    
    # Inverse transformation
    denoised_X = result.x * (1 + np.exp(pca.components_))[:, None]
    denoised_X = normalize(denoised_X, axis=0)
    
    return denoised_X
