def magic_denoise(X, **kwargs):
    assert 'budget_s' in kwargs, 'Please provide budget_s'
    assert 'random_state' in kwargs, 'Please provide random_state'

    n_cells, n_genes = X.shape
    np.random.seed(kwargs['random_state'])

    # Step 1: Apply square root transformation on the count matrix
    X = np.sqrt(X)

    # Step 2: Denoise the data using a Gaussian process regressor
    # This step will depend on the specific denoising technique chosen
    # For simplicity, we'll use a dummy regression model here
    # Replace this with your actual denoising method
    denoised_data = np.mean(X, axis=0, keepdims=True)

    # Step 3: Apply square root inverse transformation to get the final denoised data
    denoised_data = np.sqrt(denoised_data)

    return denoised_data
