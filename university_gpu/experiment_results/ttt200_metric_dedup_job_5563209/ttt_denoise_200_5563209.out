def magic_denoise(X, **kwargs):
    """
    Performs denoising on scRNA-seq count data using a novel approach.

    Args:
        X (numpy.ndarray): Raw or log-transformed count data of shape (n_cells, n_genes).
        **kwargs: Additional keyword arguments for the algorithm.

    Returns:
        numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    # Normalize the data
    scaler = StandardScaler()
    normalized_data = scaler.fit_transform(X)

    # Reduce dimensionality if necessary
    pca = PCA(n_components=100, random_state=42)
    reduced_data = pca.fit_transform(normalized_data)

    # Apply a thresholding strategy
    threshold = 0.03
    denoised_data = np.clip(reduced_data, a_min=-threshold, a_max=None)

    # Transform back to the original scale
    final_denoised_data = scaler.inverse_transform(denoised_data)

    # Apply a square root transformation
    final_denoised_data = np.sqrt(final_denoised_data)

    return final_denoised_data

