def magic_denoise(X, budget_s=1000, random_state=42):
    rng = np.random.RandomState(random_state)

    # Apply square root transformation
    X = np.sqrt(X)

    # Denoise the counts with Poisson regularization
    def objective(denoised_counts):
        nonlocal rng, budget_s
        # Simulate reads based on denoised counts
        simulated_reads = rng.poisson(denoised_counts + 1)
        
        # Calculate Poisson loss
        loss = sum(poisson.pmf(simulated_reads, observed).sum() for observed in X)
        return loss
    
    # Initial guess
    initial_guess = np.ones_like(X)

    # Define bounds
    bounds = [(0, None)] * X.shape[1]

    # Constraints
    constraints = [
        {'type': 'eq', 'fun': lambda x: np.sum(x)},
        {'type': 'ineq', 'fun': lambda x: np.mean(x)}
    ]

    # Optimize
    result = minimize(objective, initial_guess, method='COBYLA', bounds=bounds, constraints=constraints,
                       options={'maxiter': budget_s, 'disp': False})

    denoised_counts = result.x

    # Reverse square root transformation and apply normalization
    denoised_counts = np.square(denoised_counts)

    denoised_counts = normalize(denoised_counts, axis=0)

