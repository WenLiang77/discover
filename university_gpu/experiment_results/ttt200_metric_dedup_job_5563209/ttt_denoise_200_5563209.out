    svd = TruncatedSVD(n_components=n_pca, random_state=random_state)
    U, s, VT = svd.fit_transform(X)

    # Step 3: Non-Negative Matrix Factorization (NNMF)
    nnmf = Minimization(svd.components_ @ np.diag(1/s), X, method=solver,
                         jac=lambda x: np.linalg.norm(x.reshape(-1) - X.ravel()),
                         bounds=[(0, None)]*X.shape[1],
                         tol=decay,
                         options={'maxiter': 500})
    W = nnmf.x.reshape(X.shape)

    # Step 4: Reconstructing the denoised matrix
    denoised_X = PCA(n_components=n_pca).inverse_transform(W)

    # Step 5: Applying thresholding and square root transformation
    denoised_X[np.abs(denoised_X) < t] = 0
    denoised_X = np.sqrt(denoised_X)

    
