def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw count data
    norm_factor = np.sum(X > 0, axis=1).astype(float)
    X_normalized = X / norm_factor[:, None]

    # Compute the principal components
    u, s, vh = svds(X_normalized, k=min(50, np.shape(X_normalized)[1]))

    # Apply PCA
    Z = np.dot(u[:, :50], vh[:50, :])

    # Reconstruct the dataset
    Y = np.dot(Z, u[:, :50].T) * norm_factor[:, None]

    return Y

