def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Estimate the mean of the observed data
    mu_obs = X.mean(axis=0)

    # Step 2: Perform principal component analysis on the noise-free data
    pca = PCA(n_components='mle', svd_solver='randomized').fit(X)
    W = pca.components_
    Z = pca.transform(X)

    # Step 3: Solve for the posterior distribution of the counts
    def log_lik(z):
        z = np.clip(z, 0, None)
        return -NLL(z) + NLL(mu_obs)

    def NLL(z):
        return -(1/2) * (z - X @ W.T).T @ (z - X @ W.T)

    initial_guess = np.zeros_like(X)
    result = minimize(log_lik, initial_guess, bounds=[(0, None)]*X.shape[1])
    z_posterior = result.x

    # Step 4: Scale and apply the posterior distribution
    denoised_X = W @ z_posterior

    return denoised_X

