def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.

    Parameters
    ----------
    X : numpy.ndarray, shape (n_cells, n_genes)
        Raw count data with cells as rows and genes as columns.

    Returns
    -------
    numpy.ndarray, shape (n_cells, n_genes)
        Denoised count data.
    """

    X = np.asarray(X, dtype=float)

    # Normalize data first (assuming 'log' normalization)
    if isinstance(X[0][0], float) and np.all(np.isfinite(X)):
        X = np.log2(X + 1)  # Logarithm base 2
    else:
        raise ValueError("Data must be numeric with positive values.")

    # Perform dimensionality reduction using PCA (TruncatedSVD here)
    svd = TruncatedSVD(n_components=min(500, X.shape[0]), random_state=kwargs.get('random_state', 42))
    U, S, Vt = svd.fit_transform(X), svd.explained_variance_ratio_, svd.components_
    
    # Apply inverse transformation back to original dimensions
