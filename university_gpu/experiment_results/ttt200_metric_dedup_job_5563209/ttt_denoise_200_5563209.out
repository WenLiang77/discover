def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    n_cells, n_genes = X.shape

    # Normalize raw data to achieve variance-stabilizing transformation
    Xnorm = normalize(X, axis=1)

    # Perform dimensionality reduction to reduce noise
    pca = PCA(n_components=20, random_state=42)
    Xnorm_pca = pca.fit_transform(Xnorm)

    # Fit a Poisson model to identify genes with low non-zero values
    pois_pred = np.zeros((n_cells, n_genes))
    for gene in range(n_genes):
        pois_model = poisson.fit(Xnorm[:, gene])
        pois_pred[:, gene] = pois_model.pmf(Xnorm_pca[:, gene])

    # Apply Poisson thresholding to keep low non-zero values
    pois_threshold = np.max(pois_pred[pois_pred > 0]) * 10
    Xdenoised = np.where(Xnorm_pca > pois_threshold, Xnorm_pca, 0)

    return Xdenoised
