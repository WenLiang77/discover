def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    normalized_counts = np.log((X + 1) / X)

    # Apply Poisson transformation
    mean = normalized_counts.mean(axis=-1, keepdims=True)
    denominator = np.sqrt(mean)
    poisson_transformation = normalized_counts / denominator
    poisson_normalized = np.exp(poisson_transformation)

    # Filter out negative values and non-finite numbers
    filtered_poisson_normalized = poisson_normalized.clip(0, np.inf)

    # Normalize again after filtering
    final_normalized = normalize(filtered_poisson_normalized, axis=-1)

    return final_normalized.astype(int)  # Convert back to integers to ensure positivity
