def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(posterior_counts):
        poisson_loss = np.sum(poisson.pmf(X, posterior_counts))
        poisson_norm = ((0.257575 - poisson_loss) / (0.257575 - 0.031739))
        return poisson_norm + poisson_loss

    initial_guess = np.mean(X, axis=0).flatten()
    constraints = {'type': 'ineq', 'fun': lambda x: x}
    bounds = [(0.0, None)] * X.shape[1]
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, constraints=[constraints])

    return result.x.reshape(X.shape)
