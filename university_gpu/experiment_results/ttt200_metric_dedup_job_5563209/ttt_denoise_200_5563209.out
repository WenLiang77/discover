def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for scRNA-seq count data.
    
    Parameters:
    - X: numpy array of shape (n_cells, n_genes), raw count data
    - kwargs: optional keyword arguments
    
    Returns:
    - numpy array of shape (n_cells, n_genes), denoised counts
    """

    def poisson_loss(y_true, y_pred):
        # Clip values below zero to avoid NaN
        y_clip = np.clip(y_pred, a_min=0.0)
        return np.sum(poisson(y_true[y_true > 0]).pmf(y_true[y_true > 0]) * y_true[y_true > 0] - y_clip[y_true > 0])

    def objective(denoised_data):
        denoised_data = np.array(denoised_data).reshape(-1, 1)  # Reshape for compatibility with distance_matrix
        squared_errors = distance_matrix(denoised_data, X, p=1)
        squared_errors = squared_errors[:, :].T  # Ensure the matrix is square
        mse = np.mean(squared_errors)  # Mean squared error
        poisson_loss_value = poisson_loss(np.exp(denoised_data), X)
        
        # Apply Poisson constraint
        poisson_constraint = (0.257575 - poisson_loss_value) / (0.257575 - 0.031739)
        return mse + poisson_constraint

