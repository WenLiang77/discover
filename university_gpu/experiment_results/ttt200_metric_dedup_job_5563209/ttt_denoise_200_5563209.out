def magic_denoise(X, k=10, pca_n_components=20, seed=None, max_iter=50000, tol=1e-4):
    """Denoise single-cell RNA-seq count data using a combination of PCA, nearest neighbors, and Poisson regression."""
    
    # Set the random seed for reproducibility
    if seed is not None:
        np.random.seed(seed)
    
    # Perform PCA to reduce dimensionality
