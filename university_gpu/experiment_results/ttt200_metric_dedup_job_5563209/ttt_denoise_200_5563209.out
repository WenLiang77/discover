def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts first to ensure log-normality
    scaler = StandardScaler()
    X_norm = scaler.fit_transform(X)

    # Apply square root transformation
    X_sqrt = np.sqrt(X_norm)

    # Use nearest neighbor method to denoise
    knn = NearestNeighbors(n_neighbors=5, algorithm='auto')
    knn_fit = knn.fit(X_sqrt)
    distances, indices = knn_fit.kneighbors(X_sqrt)

    # Calculate the average of the nearest neighbors for each cell
    neighbors_mean = np.mean(X_sqrt[indices], axis=1)

    # Set the value to 0 if its mean is less than 1 to push towards zero
    neighbors_mean[neighbors_mean < 1] = 0.0

    # Combine the mean with the original sqrt transformed data
    denoised_X = np.sqrt(neighbors_mean)

    # Final normalization
    denoised_X = scaler.inverse_transform(denoised_X)

    # Check the Poisson constraint
    poisson_norm = (0.257575 - denoised_X.sum()) / (0.257575 - 0.031739)
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint violated")

    return denoised_X
