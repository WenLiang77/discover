def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize log-counts
    X_log = np.log2(X + 1)
    mean_log = np.mean(X_log, axis=1, keepdims=True)
    X_scaled_log = (X_log - mean_log) / std_log
    
    # Compute the mean and std across genes
    gene_means = np.mean(X_scaled_log, axis=0, keepdims=True)
    gene_stds = np.std(X_scaled_log, axis=0, keepdims=True)
    
    # Apply the inverse normalization
    X_renormalized = (X_scaled_log - gene_means) * gene_stds + gene_means
    
    # Apply Poisson transformation and normalization
    poisson_norm = np.exp(np.sum(poisson.pmf(X_renormalized)))
    
    if poisson_norm < 0.97:
        raise ValueError("Poission norm less than 0.97")
    
    denoised_X = X_renormalized
    
    return denoised_X
