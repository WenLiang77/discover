def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply PCA for dimensionality reduction
    pca = PCA(n_components=X.shape[1], random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X)
    
    # Step 2: Apply Truncated SVD for further dimensionality reduction
    svd = TruncatedSVD(n_components=X_pca.shape[1] // 2, random_state=kwargs.get('random_state', 42))
    X_truncated = svd.fit_transform(X_pca)

    # Step 3: Normalize the truncated SVD transformed data
