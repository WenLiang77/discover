def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalization: take square root of the counts
    norm_factor = np.sqrt(np.sum(X))
    X /= norm_factor

    # Poisson loss minimization
    def objective(x):
        """Objective function for minimizing Poisson negative log-likelihood."""
        # Normalize x back to original range
        x = np.sqrt(x) * norm_factor
        # Compute Poisson negative log-likelihood
        neg_log_likelihood = np.mean(poisson.pmf(X, x))
        return neg_log_likelihood

    # Initial guess for x
    initial_guess = np.log(X + 1e-6)  # avoid zeros which could lead to errors

    # Constraints for the Poisson likelihood
    constraints = [
        {'type': 'ineq', 'fun': lambda x: x},
        {'type': 'ineq', 'fun': lambda x: x - 1}
    ]

    # Bounds for x
    bounds = [(0.0, None)] * X.shape[1]

    result = minimize(objective, initial_guess, method='SLSQP', constraints=constraints, bounds=bounds)

