def magic_denoise(X, **kwargs):
    # Ensure X is a numpy array
    X = np.asarray(X, dtype=float)

    # Remove NaN, inf, negative values, and non-positive values
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Standardize the data
    X_scaled = StandardScaler().fit_transform(X)

    # Apply PCA to reduce dimensionality while preserving most variance
    pca = PCA(n_components=min(50, X_scaled.shape[1]), whiten=True).fit(X_scaled)

    # Project data onto the principal components
    X_reduced = pca.transform(X_scaled)

    # Reconstruct the data using the principal components
    X_reconstructed = pca.inverse_transform(X_reduced)

    # Denoise the reconstructed data by fitting a poisson model to each gene and correcting for observed data
    denoised_X = np.zeros_like(X_scaled)
    for i in range(X_scaled.shape[1]):
        observed_counts = X_scaled[:, i]
        model = poisson.pmf(observed_counts, mu=pca.components_[i].mean())
        corrected_counts = observed_counts * model
        denoised_X[:, i] = corrected_counts

    return denoised_X
