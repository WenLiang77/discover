def magic_denoise(X, **kwargs):
    if 'budget_s' in kwargs:
        budget_s = kwargs['budget_s']
    else:
        budget_s = 400  # default budget

    start_time = time.time()
    
    # Normalization of count data
    X_scaled = (X + 1) / (X.max() + 1)

    # Apply square root transformation
    X_transformed = np.sqrt(X_scaled)
    
    # Fit model on transformed data
    model = poisson.fit(np.log(X_transformed))
    
    # Predict and denoise counts
    denoised_counts = np.exp(model.predict(np.log(X_transformed)))

    # Normalize the denoised counts back to [0, 1]
    denoised_counts = (denoised_counts / denoised_counts.sum(axis=1, keepdims=True)).clip(min=0, max=1)
    
    end_time = time.time()
    elapsed_time = end_time - start_time
    
    if elapsed_time > budget_s:
        print(f"Budget exceeded after {elapsed_time:.2f} seconds")
        return denoised_counts
    else:
        return denoised_counts
