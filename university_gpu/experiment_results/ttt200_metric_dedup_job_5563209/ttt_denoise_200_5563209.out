def magic_denoise(X, **kwargs):
    # Normalize the data with square root transformation
    X = np.sqrt(X)

    # Apply a median filter to reduce noise
    from scipy.signal import medfilt
    X = medfilt(X, kernel_size=(5, 5))

    # Apply PCA for dimensionality reduction
    pca = PCA(n_components=1)
    X = pca.fit_transform(X)

    # Apply inverse normalization using sqrt
    X = X**2

    # Apply a threshold to remove very small values
    X[X < 0.1] = 0

    # Return the denoised data
    return X
