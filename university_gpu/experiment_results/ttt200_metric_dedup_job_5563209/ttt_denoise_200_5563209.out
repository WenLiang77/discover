def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Square root transformation stabilizes Poisson distributions
    sqrt_X = np.sqrt(X + 1e-6)  # prevent division by zero
    
    # Apply a simple Poisson-like penalty to encourage non-zero values near zero
    penalty = np.clip(sqrt_X * sqrt_X, 1e-6, None)
    
    # Solve the minimization problem using Poisson's loss
    def objective(penalty):
        return np.sum((penalty ** (-0.5)) / np.exp(-penalty))
    
    initial_guess = np.ones_like(sqrt_X)  # Start with uniform distribution
    result = minimize(objective, initial_guess, method='BFGS')
    
    # Recover the original counts by taking the square root of the minimized value
    denoised_sqrt_X = result.x
    denoised_X = denoised_sqrt_X ** 2
    
    # Handle very small values that might turn into zero when squared
    denoised_X[denoised_X < 0] = 0.0
    
    return denoised_X
