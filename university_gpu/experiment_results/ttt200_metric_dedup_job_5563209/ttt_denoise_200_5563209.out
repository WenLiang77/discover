def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Principal Component Analysis (PCA)
    pca = PCA(n_components=10)
    X_transformed = pca.fit_transform(X)

    # Scale transformed data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_transformed)

    # Fit Nearest Neighbors (KNN)
    knn = NearestNeighbors(n_neighbors=10)
    distances, _ = knn.kneighbors(X_scaled)

    # Calculate nearest neighbor similarity
    similarities = 1 / (1 + distances[range(len(distances)), knn.query_indices])

    # Calculate Poisson mean (average similarity)
    poisson_mean = np.mean(similarities)

    # Apply Poisson noise
    X_noisy = X_scaled * similarities

    # Normalize the noisy data
    X_normalized = normalize(X_noisy, axis=1)

    return X_normalized
