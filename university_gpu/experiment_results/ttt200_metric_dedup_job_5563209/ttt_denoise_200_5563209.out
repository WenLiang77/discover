def magic_denoise(X, **kwargs):
    """Denoise the raw count data using HuberRegressor."""
    
    if 'epsilon' not in kwargs:
        kwargs['epsilon'] = 1.35  # Default value for epsilon
    
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    huber_regressor = HuberRegressor(epsilon=kwargs['epsilon'], max_iter=1000)
    huber_regressor.fit(X, np.log1p(X))
    
    denoised_X = np.exp(huber_regressor.predict(X))
    
    # Apply Poisson normalization to ensure positive counts and stable scaling
    denoised_X = denoised_X.clip(min=0.0)
    
    # Calculate MSE and apply Poisson loss for evaluation
    mse = np.mean((denoised_X - np.log1p(denoised_X))**2)
    poisson_loss = np.sum(np.abs(denoised_X - np.random.poisson(denoised_X)))
    
    if poisson_loss < 0.97:
        return None  # Reject if Poisson loss is less than the baseline
    
    # Normalize the result
    min_val = denoised_X.min()
    norm_factor = (denoised_X.max() - min_val) + 1e-8
    denoised_X = (denoised_X - min_val) / norm_factor
    
    # Ensure the output is finite and non-negative
    denoised_X[np.isinf(denoised_X)] = np.inf
    denoised_X[np.isnan(denoised_X)]
