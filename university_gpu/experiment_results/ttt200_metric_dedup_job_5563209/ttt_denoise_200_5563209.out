def magic_denoise(X, **kwargs):
    # Normalize raw counts first
    X_scaled = normalize(X, axis=0)

    # Fit a Poisson model on the normalized data
    mean = np.mean(X_scaled, axis=0)
    sigma = np.sqrt(mean) * 1.1  # adjust sigma slightly to prevent underflow
    poisson_dist = scipy.stats.poisson(mu=mean)

    # Predict the number of reads for each cell
    X_pred = poisson_dist.rvs(size=X_scaled.shape)

    # Ensure predicted values are non-negative
    X_pred[X_pred < 0] = 0

    # Re-scale the predictions to match the original count space
    X_pred = X_scaled * X_pred / np.sum(X_scaled * X_pred)

    # Apply the reverse transformation to the predictions
    X_denoised = inverse_transform(X_pred, X, kwargs.get('knn_max', 1))

    return X_denoised

