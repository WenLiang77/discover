def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Denoising process steps:
    # 1. Normalize the counts
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # 2. Perform PCA on the normalized counts
    pca = PCA(n_components=X_scaled.shape[1], svd_solver='full')
    X_pca = pca.fit_transform(X_scaled)

    # 3. Apply Poisson transformation (not actually transforming but normalizing to Poisson distribution)
    X_poissified = np.exp(X_pca)

    # 4. Back-transform to counts using inverse transformation
    X_denoised = scaler.inverse_transform(X_poissified)

    return X_denoised
