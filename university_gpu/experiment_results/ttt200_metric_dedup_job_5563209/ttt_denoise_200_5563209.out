def magic_denoise(X, budget_s=None, random_state=None, knn=None, t=None, n_pca=None, solver='lbfgs', decay=None, knn_max=None, n_jobs=-1):
    X = np.asarray(X, dtype=float)

    if budget_s is None:
        budget_s = 0.00001

    if random_state is None:
        random_state = 42

    if knn is None:
        knn = 20

    if t is None:
        t = 1.0

    if n_pca is None:
        n_pca = 100

    if solver == 'lbfgs':
        bounds = [(0, None)] * len(X.flatten())

        def objective(denoised):
            denoised = np.array(denoised).reshape(X.shape)
            return np.sum((denoised - X)**2) + budget_s * poisson_loss(np.log(denoised), np.log(X))

        initial_guess = np.ones_like(X.flatten())
        result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds, options={'maxiter': 200})

        denoised = result.x.reshape(X.shape)

        poisson_loss_result = poisson_loss(np.log(denoised), np.log(X))
        if poisson_loss_result > 0.031739:
            raise ValueError("The output does not satisfy the Poisson constraint.")

        return denoised
    
    else:
        raise ValueError("Unsupported solver.")
