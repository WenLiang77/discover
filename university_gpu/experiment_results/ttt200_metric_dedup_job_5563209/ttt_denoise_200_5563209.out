def magic_denoise(X, **kwargs):
    # Normalize counts
    X_normalized = normalize(X)
    
    # Apply principal component analysis (PCA) for dimensionality reduction
    pca = PCA(n_components=0.95)
    X_reduced = pca.fit_transform(X_normalized)
    
    # Perform kNN-based imputation
    nn = NearestNeighbors(n_neighbors=5)
    X_nn_imputed = nn.fit_predict(X_reduced)
    
    # Reconstruct the original count matrix
    X_denoised = pca.inverse_transform(X_nn_imputed)
    
    # Ensure counts are finite, non-negative, and normalized
    X_denoised[X_denoised < 0] = 0
    X_denoised[X_denoised == 0] = 0.001
    
    # Verify Poisson constraint
    poisson_loss = np.sum(np.log(np.clip(X_nn_imputed, 1e-8, None)))
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
    
    if poisson_norm < 0.97:
        raise ValueError("The Poisson constraint was not met. Please try again.")
    
    return X_denoised
