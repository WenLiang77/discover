def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Normalize counts
    normalized_X = normalize(X, axis=1)

    # Step 2: Fit nearest neighbors
    nn = NearestNeighbors(n_neighbors=10, metric='euclidean', algorithm='brute').fit(normalized_X)
    nn_distances, nn_indices = nn.kneighbors(normalized_X)

    # Step 3: Estimate intensity using Nearest Neighbors
    denoised_counts = np.zeros_like(X)
    for i in range(X.shape[0]):
        neighbor_distances = nn_distances[i]
        neighbor_indices = nn_indices[i]
        
        neighbors_intensity = X[neighbor_indices]
        weights = 1 / neighbor_distances
        
        estimated_intensity = np.dot(weights, neighbors_intensity)
        denoised_counts[i] = np.clip(estimated_intensity, 0, None)

    # Step 4: Apply square root transformation to stabilize Poisson distribution
    denoised_counts = np.sqrt(denoised_counts)
    
    return denoised_counts

