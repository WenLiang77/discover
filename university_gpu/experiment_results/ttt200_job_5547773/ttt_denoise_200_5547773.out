def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalization step
    mean_expr = np.mean(X, axis=1, keepdims=True)
    std_expr = np.std(X, axis=1, keepdims=True)
    normalized_X = (X - mean_expr) / std_expr
    
    # Denoising step
    denoised_X = np.clip(normalized_X, 0.0, None)
    
    # Poisson loss calculation
    poisson_loss = np.sum(denoised_X * np.log(denoised_X + 1), axis=1)
    
    # Check Poisson loss
    if poisson_loss.min() < 0.031739:
        raise ValueError("Poisson loss is less than the magic baseline threshold.")
    
    return denoised_X
