def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation to stabilize Poisson distribution
    X = np.sqrt(X + 1e-8)

    # Initialize Poisson distribution with normalized mean
    mu = np.mean(X)
    poisson_dist = norm(loc=mu, scale=np.sqrt(mu))

    # Estimate lambda based on the Poisson distribution
    lambda_estimated = poisson_dist.cdf(np.max(X)) * mu

    # Apply Poisson loss to denoise
    denoised_X = np.exp(lambda_estimated) / (lambda_estimated + 1e-8)

    # Normalize denoised counts back to original scale
    denoised_X = np.exp(denoised_X) - 1

    return denoised_X
