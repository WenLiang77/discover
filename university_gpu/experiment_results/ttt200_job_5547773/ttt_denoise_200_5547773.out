def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(denoised):
        # Ensure denoised values are positive
        denoised = np.maximum(denoised, 0.0)
        
        # Apply square root transformation to stabilize Poisson distribution
        stabilized_denoised = np.sqrt(denoised)
        
        # Calculate Poisson negative log-likelihood
        poisson_loss = poisson.logpmf(stabilized_denoised).sum()
        
        return poisson_loss

    initial_guess = X.copy()

    bounds = [(0.0, None) for _ in range(X.shape[0])]
    
    result = minimize(objective, initial_guess, bounds=bounds, method='L-BFGS-B', options={'disp': False})

    denoised_X = result.x
    
    # Normalize the denoised data to maintain the mean count per gene
    means = np.mean(denoised_X, axis=0, keepdims=True)
    denoised_X /= means
    
    # Check Poisson constraint
    poisson_norm = (0.257575 - result.fun) / (0.257575 - 0.031739)
    
    if poisson_norm < 0.97:
        raise ValueError("Poisson constraint not satisfied")

    return denoised_X
