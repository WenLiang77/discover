def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X + 1e-9)

    # Step 2: Compute the mean across genes per cell
    gene_means = np.mean(X_sqrt, axis=1, keepdims=True)

    # Step 3: Scale down the counts by the gene means
    scaled_counts = X_sqrt / gene_means

    # Step 4: Apply the MAGIC algorithm
    denoised_X = scaled_counts * np.exp(np.random.normal(loc=0.0, scale=1.0, size=scaled_counts.shape))

    # Step 5: Clip the denoised counts to be between 0 and 1
    denoised_X = np.clip(denoised_X, 0.0, 1.0)

    return denoised_X
