def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize count data
    total_counts = np.sum(X, axis=1, keepdims=True)
    normalized_counts = X / total_counts
    
    # Apply square root transformation to stabilize variance
    stabilized_counts = np.sqrt(normalized_counts)
    
    # Compute Poisson probability mass function (PMF)
    poisson_pmf = poisson.pmf(stabilized_counts)
    
    # Apply inverse Poisson distribution to obtain denoised counts
    denoised_counts = np.random.poisson(poisson_pmf)
    
    # Clip denoised counts to non-negative integers
    denoised_counts = np.clip(denoised_counts.astype(int), 0, None)
    
    return denoised_counts
