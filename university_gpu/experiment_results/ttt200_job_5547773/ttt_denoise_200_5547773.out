def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    
    # Normalization
    if 'normalize' in kwargs and kwargs['normalize'] == 'log':
        X = np.log1p(X + 1e-8)
    elif 'normalize' in kwargs and kwargs['normalize'] == 'sqrt':
        X = np.sqrt(X)
    elif 'normalize' in kwargs and kwargs['normalize'] == 'standardize':
        scaler = StandardScaler()
        X = scaler.fit_transform(X)
    elif 'normalize' in kwargs and kwargs['normalize'] == 'minmax':
        scaler = MinMaxScaler()
        X = scaler.fit_transform(X)
    else:
        raise ValueError("Invalid normalization method")
    
    # Denoising
    mu = X.mean(axis=0)
    sigma = X.std(axis=0)
    Z = (X - mu) / sigma
    
    # Apply magic transformation
    magic_factor = 1.5
    Z = magic_factor * Z
    
    # Reconstruct the denoised data
    X_denoised = Z * sigma + mu
    
    # Post-processing
    X_denoised = np.clip(X_denoised, 0.0, None)
    
    return X_denoised
