Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts per cell
    counts_per_cell = X.sum(axis=1)
    X /= counts_per_cell[:, None]

    # Apply square root transformation to stabilize variance
    X = np.sqrt(X + 1e-6)

    # Denoise by subtracting mean and scaling
    mu = X.mean()
    std_dev = X.std()
    X -= mu
    X /= std_dev

    # Revert square root transformation
    X *= std_dev

    # Apply normalization to keep counts non-negative
    X = np.maximum(0.0, X)

    return X
