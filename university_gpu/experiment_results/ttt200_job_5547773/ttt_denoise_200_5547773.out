def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Apply square root transformation for Poisson loss
    X_transformed = np.sqrt(X)

    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=50, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X_transformed)

    # Apply inverse square root transformation to recover the log scale
    X_recovered = pca.inverse_transform(X_pca) ** 2

    # Apply reverse normalization
    X_renormalized = X_recovered * np.exp(-0.5)

    # Filter out noise and ensure non-negativity
    X_filtered = np.maximum(X_renormalized, 0.0)

    # Evaluate Poisson loss
    poisson_loss = poisson.logpmf(np.clip(X_filtered, 1e-3, None), mu=np.clip(X_filtered, 1e-3, None)).mean()

    if poisson_loss < 0.97:
        raise ValueError("Poisson loss is below the threshold")

    return X_filtered
