        return np.mean((p * X) ** 2)
    
    # Perform the minimization
    result = minimize_scalar(objective, bounds=bounds, method='bounded')
    
    # Get the optimized factor
    factor = result.x
    
    # Apply the factor to reverse the square root transformation
    X_denonased = np.sqrt(factor) * X
    
    # Ensure the output is finite and non-negative
    X_denonased = np.maximum(0.0, X_denonased)
    
    return X_denonased
