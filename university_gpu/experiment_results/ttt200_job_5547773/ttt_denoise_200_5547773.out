def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    sqrt_transformed = np.sqrt(X)

    # Step 2: Normalize the transformed data
    normalized_sqrt = sqrt_transformed / np.max(sqrt_transformed)

    # Step 3: Reapply the square root transformation
    denoised_X = normalized_sqrt ** 2

    # Ensure the output is finite and non-negative
    denoised_X = np.clip(denoised_X, 0.0, None)

    return denoised_X
