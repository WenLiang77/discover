Generated code preview:
def magic_denoise(X, **kwargs):
    """
    Magic denoising algorithm for single-cell RNA-seq count data.
    
    Args:
        X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
        
    Returns:
        numpy.ndarray: Denoised count data of shape (n_cells, n_genes).
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization
    X /= np.sum(X)

    # Square root transformation
    X = np.sqrt(X)

    # Apply Gaussian noise
    noise = np.random.normal(0, 1, size=X.shape)
    denoised_X = X + noise

    # Ensure non-negativity
    denoised_X = np.clip(denoised_X, 0.0, None)

    # Reapply square root transformation
    denoised_X = np.sqrt(denoised_X)

    # Apply reverse normalization again
    denoised_X *= np.sum(X) / np.sum(denoised_X)

    return denoised_X
