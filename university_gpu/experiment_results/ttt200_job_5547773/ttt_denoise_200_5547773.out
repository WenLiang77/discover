def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(poisson_loss):
        denoised = X * np.exp(-poisson_loss)
        mse = np.mean((denoised - X) ** 2)
        poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)
        return mse + poisson_loss * poisson_norm

    bounds = (0.0, None)  # Ensure poisson loss is positive
    result = minimize_scalar(objective, bounds=bounds, method='bounded', options={'maxiter': 100})

    if result.success and result.fun < 1e-6:
        return result.x[0] * np.exp(result.fun)
    else:
        raise ValueError("Denoising failed")
