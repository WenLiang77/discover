Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize X to have mean 0 and std 1
    mean = X.mean(axis=1).reshape(-1, 1)
    std = X.std(axis=1).reshape(-1, 1)
    X_norm = (X - mean) / std

    # Apply square root transformation
    X_sqrt = np.sqrt(X_norm + 1e-8)

    # Calculate Poisson normalized scores
    poisson_scores = []
    for i in range(X.shape[1]):
        poisson_score = poisson.logpmf(X_sqrt[:, i], np.exp(X_sqrt[:, i]))
        poisson_scores.append(poisson_score)
    poisson_scores = np.array(poisson_scores)

    # Apply Poisson constraint to ensure at least one count per gene
    poisson_mask = poisson_scores > 0
    X_denoised = X * poisson_mask

    # Normalize the denoised data back to the original scale
    X_denoised /= std
    X_denoised += mean

    return X_denoised

