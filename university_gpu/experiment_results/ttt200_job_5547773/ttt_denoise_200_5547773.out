    normalized_counts = np.sqrt(X)

    # Apply a Poisson threshold to filter out very low counts
    poisson_threshold = 0.05 * np.mean(normalized_counts)
    denoised_counts = np.where(normalized_counts > poisson_threshold, normalized_counts, 0.0)

    return denoised_counts
