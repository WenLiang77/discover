def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Apply square root transformation
    X_sqrt = np.sqrt(X_normalized)

    # Estimate noise variance
    noise_variance = np.mean(X_sqrt**2)

    # Denoise by clipping values above noise threshold
    denoised = np.clip(X_sqrt, 0.0, np.sqrt(noise_variance))

    # Convert back to original scale
    denoised_original_scale = scaler.inverse_transform(denoised)

    # Clip back to non-negative
    denoised = np.maximum(denoised_original_scale, 0.0)

    return denoised
