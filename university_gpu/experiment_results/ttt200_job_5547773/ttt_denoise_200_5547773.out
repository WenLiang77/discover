def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Fit a linear model to predict counts from normalized counts
    model = LinearRegression().fit(X_normalized, X)

    # Predict denoised counts
    denoised_counts = model.predict(X_normalized)

    # Apply square root transform for variance stabilizing
    denoised_counts_sqrt = np.sqrt(denoised_counts)

    # Clip values to ensure they are finite and non-negative
    denoised_counts_sqrt = np.clip(denoised_counts_sqrt, 0.0, None)

    # Optionally apply thresholding
    denoised_counts_sqrt[denoised_counts_sqrt < 1.0] = 0.0

    # Scale back to original range
    denoised_counts = scaler.inverse_transform(denoised_counts_sqrt)

    return denoised_counts
