def magic_denoise(X, **kwargs):
    # Step 1: Reverse normalization
    X /= np.sum(X, axis=1, keepdims=True)
    X *= np.sqrt(np.sum(X, axis=1, keepdims=True))

    # Step 2: Denoise using LassoCV with cross-validation
    model = Pipeline([
        ('scaler', StandardScaler()),
        ('pca', PCA(n_components=1)),
        ('lasso', LassoCV(cv=5))
    ])
    model.fit(X, np.log1p(X))
    denoised_X = model.predict(X)

    # Step 3: Ensure denoised counts are finite and non-negative
    denoised_X = np.maximum(denoised_X, 0.0)

    return denoised_X
