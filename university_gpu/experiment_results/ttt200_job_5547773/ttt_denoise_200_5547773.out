def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Normalize the raw counts
    scaler = StandardScaler()
    normalized_X = scaler.fit_transform(X)

    # Step 2: Apply square root transformation
    sqrt_transformation = np.sqrt(normalized_X)
    
    # Step 3: Apply Poisson distribution constraints
    poisson_constraint = 0.97
    mu = np.mean(sqrt_transformation)
    sigma = np.std(sqrt_transformation)
    poisson_loss = np.sum((sqrt_transformation - mu)**2) / sigma**2
    if poisson_loss > (1 - poisson_constraint)**2:
        sqrt_transformation = np.minimum(sqrt_transformation, mu + (1 - poisson_constraint)*sigma)
    
    # Step 4: Convert back to raw counts
    denoised_X = np.square(scaler.inverse_transform(sqrt_transformation))

    # Ensure the output is finite and non-negative
    denoised_X[denoised_X < 0] = 0
    denoised_X = np.clip(denoised_X, a_min=0, a_max=None)

    return denoised_X
