def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Principal Component Analysis (PCA) for dimensionality reduction
    pca = PCA(n_components=100, random_state=kwargs.get('random_state', 42))
    X_pca = pca.fit_transform(X_scaled)

    # Ridge Regression for denoising
    ridge_reg = RidgeCV(alphas=np.logspace(-3, 3, 100), fit_intercept=False, random_state=kwargs.get('random_state', 42))
    ridge_reg.fit(X_pca, np.log(X + 1e-6))  # Adding small constant to avoid log(0)

    # Predicted denoised counts
    predicted_denoised_counts = np.exp(ridge_reg.predict(X_pca))

    # Apply inverse transformation to recover counts
    denoised_counts = scaler.inverse_transform(predicted_denoised_counts)

    # Ensure denoised counts are finite and non-negative
    denoised_counts = np.clip(denoised_counts, 0.0, None)

    return denoised_counts
