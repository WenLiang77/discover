def magic_denoise(X, **kwargs):
    # Normalize the data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Apply PCA
    pca = PCA(n_components=10)
    X_pca = pca.fit_transform(X_scaled)

    # Apply Gaussian noise model to each gene
    sigma = 0.1 * np.std(X_pca, axis=0)
    noise = np.random.normal(0, sigma, size=X_pca.shape)
    denoised_X = X_pca + noise

    # Revert PCA and scaling
    denoised_X_reverted = scaler.inverse_transform(denoised_X)
    denoised_X = denoised_X_reverted.clip(min=0)

    return denoised_X
