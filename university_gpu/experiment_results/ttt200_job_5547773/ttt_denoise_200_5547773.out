def magic_denoise(X, **kwargs):
    """
    Magic denoiser for scRNA-seq count data.
    
    Parameters:
        X (numpy.ndarray): Raw count data of shape (n_cells, n_genes).
        **kwargs: Additional keyword arguments.
        
    Returns:
        numpy.ndarray: Denoised count data of the same shape as X.
    """
    # Step 1: Normalize raw counts by total number of reads per cell
    total_reads_per_cell = np.sum(X, axis=1, keepdims=True)
    normalized_counts = X / total_reads_per_cell
    
    # Step 2: Apply square root transformation
    transformed_counts = np.sqrt(normalized_counts)
    
    # Step 3: Compute the mean and standard deviation of the transformed counts
    mu_transformed = np.mean(transformed_counts)
    sigma_transformed = np.std(transformed_counts)
    
    # Step 4: Apply a correction factor to stabilize Poisson likelihood
    correction_factor = 1.0 + (sigma_transformed**2) / mu_transformed
    corrected_counts = transformed_counts * correction_factor
    
    # Step 5: Apply the inverse square root transformation
    inv_sqrt_correction = 1.0 / np.sqrt(correction_factor)
    denoised_counts = inv_sqrt_correction * corrected_counts
    
    # Step 6:
