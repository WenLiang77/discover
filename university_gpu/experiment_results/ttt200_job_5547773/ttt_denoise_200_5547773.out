def magic_denoise(X, budget_s=400, random_state=None, knn=None, t=None, n_pca=0, solver='lbfgsb', decay=0.01, knn_max=None, n_jobs=-1):
    if random_state is not None:
        np.random.seed(random_state)

    # Initialize denoised data
    denoised = X.copy()

    # Define bounds for the optimization
    bounds = [(0.0, None)] * denoised.shape[1]

    def objective_function(params):
        denoised = X.copy()
        denoised *= params
        denoised = reverse_log_transform(denoised)
        denoised = np.maximum(denoised, 0.0)
        return mse_score(denoised, X)

    result = minimize_scalar(objective_function, bounds=bounds, method='bounded')

    if result.success:
        denoised = result.x
        denoised = reverse_log_transform(denoised)
        denoised = np.maximum(denoised, 0.0)
        return denoised
    else:
        raise ValueError("Failed to find a solution.")
