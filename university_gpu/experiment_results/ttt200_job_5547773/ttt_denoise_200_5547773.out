def magic_denoise(X, **kwargs):
    # Normalize raw counts first
    X_normalized = np.log2(1 + X)

    # Apply square root transformation
    X_sqrt = np.sqrt(X_normalized)

    # Ensure all values are positive
    X_positive = np.maximum(X_sqrt, 0.0)

    # Calculate the mean and variance of the positive values
    mu_pos = np.mean(X_positive)
    var_pos = np.var(X_positive)

    # Generate a sample from the normal distribution centered at the mean with variance equal to the variance of the positive values
    noise_samples = norm.rvs(loc=mu_pos, scale=np.sqrt(var_pos), size=X.shape)

    # Add the noise samples to the normalized positive values
    denoised_X = X_positive + noise_samples

    # Ensure the denoised counts are finite and non-negative
    denoised_X = np.maximum(denoised_X, 0.0)

    return denoised_X
