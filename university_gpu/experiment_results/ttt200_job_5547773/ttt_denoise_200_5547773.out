def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transform
    X = square_root_transform(X)

    # Step 2: Normalize data using log-normalization
    X_lognorm = log_normalize(X, axis=1)

    # Step 3: Apply PCA for dimensionality reduction
    pca = PCA(n_components=100, random_state=0)
    X_reduced = pca.fit_transform(X_lognorm)

    # Step 4: Train a logistic regression model to estimate the noise distribution
    lr = LogisticRegression(solver='lbfgs', max_iter=1000, random_state=0)
    lr.fit(X_reduced, np.zeros_like(X_reduced))

    # Step 5: Predict the noise for each cell
    noise_estimates = lr.predict_proba(X_reduced)[:, 1]

    # Step 6: Reconstruct the data after removing noise
    X_denoised = X_lognorm * (1 - noise_estimates)

    # Step 7: Apply square root transform back to get final denoised counts
    X_denoised = square_root_transform(X_denoised)

    # Step 8: Normalize again using log-normalization
    X_denoised = log_normalize(X_denoised, axis=1)

    return X_denoised
