def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Denoise raw counts first
    denoised_counts = denoise_raw_counts(X, **kwargs)

    # Normalize the denoised counts
    normalized_denoised_counts = normalize_denoised_counts(denoised_counts, **kwargs)

    return normalized_denoised_counts

def denoise_raw_counts(X, **kwargs):
    # Example denoising method: apply Gaussian noise removal
    std_dev = np.std(X, axis=0)
    noise_std_dev = 0.1 * std_dev
    denoised_counts = X + np.random.normal(0, noise_std_dev, X.shape)
    return denoised_counts

def normalize_denoised_counts(X, **kwargs):
    scaler = StandardScaler()
    normalized_denoised_counts = scaler.fit_transform(X)
    return normalized_denoised_counts
