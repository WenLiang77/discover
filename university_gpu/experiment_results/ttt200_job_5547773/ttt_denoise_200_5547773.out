def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize counts
    mean_counts = np.mean(X, axis=0)
    std_counts = np.std(X, axis=0)
    normalized_counts = (X - mean_counts) / std_counts

    # Reconstruct counts using Gaussian distribution
    reconstructed_counts = np.zeros_like(normalized_counts)
    for i in range(len(normalized_counts)):
        reconstructed_counts[i] = norm.ppf(np.random.uniform(0, 1))

    # Rescale to match original counts
    scaled_reconstructed_counts = reconstructed_counts * std_counts + mean_counts

    # Apply Poisson correction
    poisson_loss = np.sum((scaled_reconstructed_counts - X) ** 2)
    while poisson_loss < 0.97 * X.size:
        reconstructed_counts *= 2
        scaled_reconstructed_counts = reconstructed_counts * std_counts + mean_counts
        poisson_loss = np.sum((scaled_reconstructed_counts - X) ** 2)

    # Ensure the result is finite and non-negative
    denoised_counts = np.clip(scaled_reconstructed_counts, 0, None)
    
    return denoised_counts
