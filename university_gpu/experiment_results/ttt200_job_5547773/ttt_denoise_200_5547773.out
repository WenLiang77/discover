def magic_denoise_raw_counts(X, **kwargs):
    # Example raw count denoising method
    # For simplicity, we'll just take the mean of each gene
    denoised = np.mean(X, axis=0)
    return denoised

def normalize_counts(X, **kwargs):
    # Example normalization method
    # We'll use the square root transform
    normalized = np.sqrt(X + 1e-6)
    return normalized

def apply_poisson_constraints(X, **kwargs):
    # Example Poisson constraint applying
    # We'll push values < 1 toward zero
    poisson_loss = lambda x: np.sum(np.abs(poisson.pmf(x, 0.1)) * x)
    result = minimize_scalar(poisson_loss, bounds=(0, 1), method='bounded')
    return X * result.x
