def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize to log-normal distribution
    X_lognorm = np.log(np.exp(X) + 1)

    # Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X_lognorm)

    # Apply Gaussian noise model
    mu, sigma = norm.fit(X_sqrt)
    gaussian_noise = np.random.normal(mu, sigma, size=X_sqrt.shape)

    # Reconstruct the denoised counts
    denoised_X = X_sqrt + gaussian_noise

    # Ensure all values are finite and non-negative
    denoised_X = np.clip(denoised_X, 0.0, None)

    # Apply Poisson constraint
    poisson_loss = poisson(pressure=denoised_X).logpmf(X_sqrt)
    poisson_norm = (0.257575 - poisson_loss) / (0.257575 - 0.031739)

    if poisson_norm < 0.97:
        raise ValueError("Poisson loss is below the threshold")

    return denoised_X

