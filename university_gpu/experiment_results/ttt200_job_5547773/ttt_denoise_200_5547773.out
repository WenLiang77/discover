def magic_denoise(X, budget_s=None, random_state=None, knn=None, t=None, n_pca=None, solver='lbfgs', decay=0.01, knn_max=None, n_jobs=None):
    if budget_s is None:
        budget_s = 400.0  # Time budget in seconds

    if random_state is None:
        random_state = np.random.default_rng()

    if knn is None:
        knn = 3

    if t is None:
        t = 100

    if n_pca is None:
        n_pca = 10

    if solver == 'lbfgs':
        bounds = [(0, None)] * X.shape[0]

        def objective(x):
            denoised_counts = X + x.reshape(1, -1)
            denoised_counts = np.clip(denoised_counts, 0, None)
            poisson_norm = (0.257575 - calculate_poisson_loss(denoised_counts, X)) / (0.257575 - 0.031739)
            mse = calculate_poisson_loss(denoised_counts, X)
            reward = mse
            return reward - poisson_norm

        result = minimize_scalar(objective, bounds=bounds, method='bounded', options={'maxiter': 1000})
        
        return result.x

