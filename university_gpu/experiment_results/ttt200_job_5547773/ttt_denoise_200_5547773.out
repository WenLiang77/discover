def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X)
    
    # Perform PCA to reduce dimensionality before denoising
    from sklearn.decomposition import PCA
    pca = PCA(n_components=100)  # Adjust the number of components based on your dataset
    X_reduced = pca.fit_transform(X_sqrt)
    
    # Perform denoising on the reduced space
    # You can use any denoising technique here, e.g., LDA, SVD, etc.
    # For simplicity, let's assume we are using LDA
    from sklearn.discriminant_analysis import LinearDiscriminantAnalysis
    lda = LinearDiscriminantAnalysis(solver='eigen')
    X_denoised = lda.fit_transform(X_reduced)
    
    # Revert the square root transformation to get back to the original scale
    X_denoised_sqrt = X_denoised ** 2
    
    # Ensure the output is finite and non-negative
    X_denoised_sqrt[X_denoised_sqrt < 0] = 0.0
    
    return X_denoised_sqrt
