def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Perform SVD on X to get U, s, Vt
    U, s, Vt = svds(X, k=min(100, X.shape[1]))

    # Compute the pseudo-inverse of Vt
    Vt_inv = np.linalg.pinv(Vt)

    # Compute the noise matrix
    noise_matrix = np.dot(U.T, Vt_inv)

    # Apply the noise matrix to X to remove noise
    denoised_X = X - noise_matrix

    # Normalize the denoised data
    scaler = StandardScaler()
    denoised_X = scaler.fit_transform(denoised_X)

    return denoised_X

