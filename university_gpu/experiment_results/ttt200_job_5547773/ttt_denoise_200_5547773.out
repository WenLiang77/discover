def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalization order: raw count data -> log counts -> square root -> normalized
    log_counts = np.log1p(X)
    sqrt_log_counts = np.sqrt(log_counts)
    normalized_log_counts = np.maximum(sqrt_log_counts, 1e-6)

    # Apply Poisson normalization
    poisson_loss = (-normalized_log_counts + np.exp(-normalized_log_counts)).mean()
    while poisson_loss > 0.037:
        normalized_log_counts -= np.exp(-normalized_log_counts)
        poisson_loss = (-normalized_log_counts + np.exp(-normalized_log_counts)).mean()

    denoised_counts = np.exp(normalized_log_counts)

    return denoised_counts
