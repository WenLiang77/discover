    X_sqrt = np.sqrt(X_scaled)

    # Denoise by setting small values close to zero
    X_denoised = np.where(X_sqrt < 1.0, 0.0, X_sqrt)

    # Normalize back to log scale
    X_log = np.log(X_denoised + 1.0)

