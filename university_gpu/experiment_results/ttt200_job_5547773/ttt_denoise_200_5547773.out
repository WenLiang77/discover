def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Reverse normalization
    X /= np.sum(X, axis=1, keepdims=True)
    X *= np.sqrt(np.sum(X, axis=1, keepdims=True))

    # Step 2: Apply a more sophisticated denoising technique
    X[X < 0.001] = 0.0
    X[X > 1.0] = 1.0

    # Step 3: Apply Poisson normalization
    X *= np.exp(-X)

    # Step 4: Ensure the result is finite and non-negative
    X[np.isinf(X)] = 0.0
    X[np.isnan(X)] = 0.0

    # Ensure the result is within the valid range [0, 1]
    X = np.clip(X, 0.0, 1.0)

    return X
