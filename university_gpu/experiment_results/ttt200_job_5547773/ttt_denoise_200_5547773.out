def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)
    
    # Normalize log-counts
    log_counts = np.log2(X + 1)
    mean_log_count = np.mean(log_counts, axis=0)
    normalized_log_counts = log_counts - mean_log_count
    
    # Apply square root transformation
    sqrt_normalized_log_counts = np.sqrt(normalized_log_counts)
    
    # Calculate Poisson negative log-likelihood
    poisson_loss = np.sum(poisson.pmf(sqrt_normalized_log_counts, np.exp(mean_log_count)))
    
    # Ensure Poisson loss meets the threshold
    if poisson_loss < 0.97:
        raise ValueError("Poisson loss is below the threshold. Consider using a different approach.")
    
    # Invert the square root transformation
    inverted_sqrt_normalized_log_counts = np.square(sqrt_normalized_log_counts)
    
    # Re-add the offset
    denoised_counts = inverted_sqrt_normalized_log_counts * (2 ** mean_log_count) - 1
    
    # Ensure denoised counts are non-negative
    denoised_counts = np.clip(denoised_counts, 0.0, None)
    
    return denoised_counts

