def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(x):
        denoised_X = x * X
        poisson_loss = np.mean(np.abs(denoised_X - X))
        return poisson_loss

    result = minimize_scalar(objective, bounds=(0, 1), method='bounded')
    denoised_X = result.x * X

    # Ensure denoised_X is finite and non-negative
    denoised_X = np.where(denoised_X > 0, denoised_X, 0)

    # Check Poisson loss condition
    poisson_loss = np.mean(np.abs(denoised_X - X))
    if poisson_loss < 0.97:
        raise ValueError("Poisson loss is less than 0.97, solution rejected")

    return denoised_X
