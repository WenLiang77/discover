def magic_denoise(X, **kwargs):
    X = csr_matrix(X)
    
    # Normalize count data by taking the square root of each cell
    X_sqrt = np.sqrt(X.data)
    
    # Compute the initial prediction by taking the mean of the sqrt values
    y_pred_initial = X_sqrt.mean(axis=1).reshape(-1, 1)
    
    # Define the objective function
    def objective_function(params):
        y_pred = params.reshape(X.shape[0], X.shape[1])
        
        # Apply the square root transformation
        y_pred_sqrt = np.sqrt(y_pred)
        
        # Compute the Poisson loss
        loss_poisson = poisson_loss(X_sqrt.data, y_pred_sqrt.data)
        
        # Compute the MSE in log-normalized space
        loss_mse = mse_normalized(X_sqrt.data, y_pred_sqrt.data)
        
        return loss_poisson + loss_mse
    
    # Initial guess for the prediction
    initial_guess = y_pred_initial.flatten()
    
    # Perform optimization
    result = minimize(objective_function, initial_guess, method='BFGS')
    
    # Convert the result back to a numpy array
    y_pred_optimized = result.x.reshape(X.shape[0], X.shape[1])
    
    return y_pred_optimized
