def magic_denoise(X, **kwargs):
    # Normalize raw counts
    X_scaled = StandardScaler().fit_transform(X)

    # Apply PCA to reduce dimensionality
    pca = PCA(n_components=X_scaled.shape[1] // 2, random_state=42)
    X_reduced = pca.fit_transform(X_scaled)

    # Train a logistic regression model to predict the noise
    clf = LogisticRegressionCV(cv=5, penalty='l1', random_state=42)
    clf.fit(X_reduced, np.zeros_like(X_scaled))

    # Predict the noise components
    noise_components = clf.predict_proba(X_reduced)[:, 1]

    # Apply the noise components to the scaled counts
    denoised_counts = X_scaled + noise_components * np.mean(X_scaled)

    # Ensure the denoised counts are non-negative
    denoised_counts = np.clip(denoised_counts, 0.0, None)

    return denoised_counts
