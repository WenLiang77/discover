def magic_denoise(X, budget_s, random_state, knn, t, n_pca, solver, decay, knn_max, n_jobs):
    # Normalize raw counts
    X_scaled = StandardScaler().fit_transform(X)

    # Apply PCA for dimensionality reduction
    if n_pca > 0:
        pca = PCA(n_components=n_pca, random_state=random_state)
        X_pca = pca.fit_transform(X_scaled)
    else:
        X_pca = X_scaled

    # Train Gaussian mixture model for Poisson distribution fitting
    from sklearn.mixture import GaussianMixture
    gmm = GaussianMixture(n_components=n_pca, random_state=random_state)
    gmm.fit(X_pca)

    # Predict Poisson means
    poisson_means = gmm.means_

    # Reverse transformation to Poisson
    X_poisson = np.exp(poisson_means)

    # Apply thresholding
    threshold = np.quantile(X_poisson.ravel(), 1 - (budget_s / 100))
    X_poisson[X_poisson < threshold] = 0.0

    # Reapply PCA if necessary
    if n_pca > 0:
        X_reconstructed = pca.inverse_transform(X_poisson)
    else:
        X_reconstructed = X_poisson

    # Convert back to log-normal space
    X_denoised = np.log1p(X_reconstructed)

    # Ensure denoised data is finite and non-negative
    X_denoised = np.clip(X_denoised, 0, None
