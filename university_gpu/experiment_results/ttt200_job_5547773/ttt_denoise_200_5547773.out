import numpy as np
from scipy.optimize import minimize
from scipy.stats import poisson

def evaluate_mse(X_true, X_pred):
    mse = np.mean((X_true - X_pred) ** 2)
    return mse

def evaluate_poisson(X_true, X_pred):
    # Normalize both sets of counts
    X_true_norm = X_true / np.sum(X_true, axis=1, keepdims=True)
    X_pred_norm = X_pred / np.sum(X_pred, axis=1, keepdims=True)

    # Ensure the predicted counts are non-negative
    X_pred_norm[X_pred_norm < 0] = 0

    # Calculate the Poisson loss
    poisson_loss = np.sum(poisson.logpmf(X_true_norm.flatten(), X_pred_norm.flatten()))
    return poisson_loss

