def magic_denoise(X, **kwargs):
    # Remove NaN and inf values
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)

    # Ensure the matrix is square and positive definite
    if not np.allclose(X.T @ X, X @ X):
        raise ValueError("Input matrix must be square and positive definite")

    # Center the data
    X_centered = X - np.mean(X, axis=0)

    # Calculate the covariance matrix
    cov_matrix = X_centered.T @ X_centered

    # Compute the eigenvalues and eigenvectors of the covariance matrix
    eigenvalues, eigenvectors = np.linalg.eig(cov_matrix)

    # Sort eigenvalues and corresponding eigenvectors in descending order
    sorted_indices = np.argsort(eigenvalues)[::-1]
    sorted_eigenvalues = eigenvalues[sorted_indices]
    sorted_eigenvectors = eigenvectors[:, sorted_indices]

    # Construct the principal component matrix
    pca_matrix = sorted_eigenvectors[:, :kwargs.get('n_pca', 1)]

    # Apply PCA transformation
    X_pca = X_centered @ pca_matrix

    # Reconstruct the centered data using the reconstructed PCA matrix
    X_reconstructed_centered = X_pca @ sorted_eigenvectors.T

    # Uncenter the data
    X_reconstructed = X_reconstructed_centered + np
