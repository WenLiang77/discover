def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize raw counts
    X /= np.sum(X, axis=1, keepdims=True)

    # Apply square root transformation
    X = np.sqrt(X)

    # Fit Poisson distribution to each cell's expression
    mu = X.mean(axis=1, keepdims=True)
    poisson_dist = poisson(mu)
    X_denoised = poisson_dist.rvs(size=X.shape)

    # Ensure the denoised counts are finite and non-negative
    X_denoised = np.clip(X_denoised, 0, None)

    return X_denoised
