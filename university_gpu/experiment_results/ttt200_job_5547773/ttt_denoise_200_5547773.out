def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective(denoised):
        denoised_log = np.log(denoised + 1e-6)
        mse = np.mean((denoised_log - np.log(X + 1e-6)) ** 2)
        poisson_loss = np.sum(-denoised * np.exp(denoised_log))
        return mse + poisson_loss

    bounds = [(0.0, None) for _ in range(X.shape[1])]
    initial_guess = np.zeros_like(X)
    
    result = minimize(objective, initial_guess, method='L-BFGS-B', bounds=bounds)
    denoised_X = np.clip(result.x, 0.0, None)

    return denoised_X
