def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reversely normalize the count data
    normalized_count = np.log(X + 1)

    # Compute the mean of each gene across cells
    gene_means = np.mean(normalized_count, axis=0)

    # Center and scale the normalized count data
    centered_scaled_counts = normalized_count - gene_means[np.newaxis, :]
    scaled_variance = np.sum(centered_scaled_counts**2, axis=0)

    # Apply the MAGIC transformation
    magic_coefficient = (np.sqrt(np.sum(scaled_variance)) / np.sqrt(len(X))) ** 2
    denoised_counts = centered_scaled_counts * magic_coefficient

    # Ensure denoised counts are finite and non-negative
    denoised_counts = np.clip(denoised_counts, 0.0, None)

    # Convert back to raw counts
    denoised_counts = np.exp(denoised_counts)

    # Normalize back to log-normal space
    denoised_counts = np.minimum(denoised_counts, 2 ** 31 - 1)

    return denoised_counts
