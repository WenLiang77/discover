def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Apply square root transformation
    X_sqrt = np.sqrt(X)

    # Step 2: Normalize the transformed data
    X_sqrt /= np.max(X_sqrt)

    # Step 3: Ensure non-negative values
    X_sqrt[X_sqrt < 0] = 0

    # Step 4: Reapply square root transformation to get back to original scale
    denoised_X = np.square(X_sqrt)

    # Ensure the output is finite and non-negative
    denoised_X[denoised_X != denoised_X] = 0
    denoised_X[denoised_X < 0] = 0

    return denoised_X
