def magic_denoise(X, **kwargs):
    # Denoise raw counts first
    X = np.log2(X + 1)  # Apply logarithm to avoid zeros
    
    # Normalize the data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    
    # Apply poisson noise model to the normalized data
    denoised_counts = np.zeros_like(X_scaled)
    for i in range(len(X)):
        for j in range(len(X[i])):
            if X_scaled[i][j] > 0:
                expected = X_scaled[i][j]
                observed = X[i][j]
                poisson_prob = poisson.pmf(observed, expected)
                denoised_counts[i][j] = observed * poisson_prob
    
    return denoised_counts
