    X = np.maximum(X, 0.0)

    # Step 1: Normalize raw data using square root transform
    X_norm = np.sqrt(X)

    # Step 2: Apply Gaussian noise removal
    noise_level = np.std(X_norm)
    X_noise_removed = X_norm + noise_level * np.random.randn(*X_norm.shape)

    # Step 3: Apply Poisson distribution fitting and correction
    mean_log_counts = np.mean(np.log10(X_noise_removed))
    poisson_params = norm.fit(np.log10(X_noise_removed))
    poisson_mean = poisson.ppf(poisson_params[0], loc=mean_log_counts)
    corrected_counts = np.power(10, poisson_mean)

    # Step 4: Ensure output is finite and non-negative
    corrected_counts = np.clip(corrected_counts, a_min=0.0, a_max=None)

    return corrected_counts
