def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    n_cells, n_genes = X.shape
    # Apply square root transformation to stabilize Poisson distribution
    X_sqrt = np.sqrt(X)

    # Perform PCA to reduce dimensionality
    pca = PCA(n_components=min(50, n_genes))
    X_pca = pca.fit_transform(X_sqrt)

    # Cluster cells to identify potential outliers
    kmeans = KMeans(n_clusters=3, random_state=0)
    cell_labels = kmeans.fit_predict(X_pca)

    # Define the objective function for minimization
    def objective(params):
        # Add noise to the cluster centers
        centroids = params.reshape(-1, 50)
        noise = np.random.normal(loc=0, scale=1, size=centroids.shape)
        noisy_centroids = centroids + noise
        # Update the transformed counts based on the noisy cluster centers
        transformed_counts = np.dot(X_pca, noisy_centroids.T)
        # Calculate Poisson loss
        poisson_loss = np.sum(transformed_counts - X_sqrt)
        # Calculate MSE in log-normalized space
        log_mse = np.mean((transformed_counts - X_sqrt)**2)
        return poisson_loss
