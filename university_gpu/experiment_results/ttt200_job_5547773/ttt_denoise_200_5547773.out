def magic_denoise(X, **kwargs):
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize using square root transform for Poisson distribution
    sqrt_X = np.sqrt(X)

    # Fit Poisson model
    lambda_val = sqrt_X.mean(axis=1).reshape(-1, 1)
    poisson_model = poisson.fit(lambda_val.ravel())

    # Predict count data
    predicted_counts = poisson_model.rvs(size=sqrt_X.shape)

    # Square root transform back
    denoised_X = np.sqrt(predicted_counts)

    # Ensure non-negative and finite
    denoised_X = np.clip(denoised_X, 0.0, None)

    return denoised_X
