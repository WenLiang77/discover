def magic_denoise(X, **kwargs):
    X = np.array(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Step 1: Reverse normalization
    X /= np.sum(X, axis=1, keepdims=True)
    X *= np.sqrt(np.sum(X, axis=1, keepdims=True))

    # Step 2: Denoise using a more sophisticated approach
    denoised_X = np.zeros_like(X)
    for i in range(X.shape[0]):
        row_sum = np.sum(X[i])
        if row_sum > 0:
            denoised_X[i] = np.clip(X[i] / row_sum * 0.01, 0.0, None)
        else:
            denoised_X[i] = 0.0

    return denoised_X
