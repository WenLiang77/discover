def magic_denoise(X, **kwargs):
    """
    Magic Denoising Algorithm for scRNA-seq Count Data
    """
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    def objective_function(x):
        nonlocal X
        normalized_X = np.log1p(np.clip(X, 1e-6, None))
        mse = np.mean((normalized_X - x)**2)
        return mse

    initial_guess = np.median(X) * np.ones_like(X)
    constraints = [{'type': 'ineq', 'fun': lambda x: np.sum(x)})
    bounds = [(None, None)] * X.shape[1]

    result = minimize(objective_function, initial_guess, method='SLSQP', bounds=bounds, constraints=constraints)

    if result.fun > 0.037:
        raise ValueError("Poisson loss did not meet the threshold")

    denoised_X = np.exp(result.x) - 1
    return denoised_X
