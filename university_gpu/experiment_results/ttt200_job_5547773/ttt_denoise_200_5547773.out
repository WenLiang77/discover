def magic_denoise(X, **kwargs):
    # Normalize count data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    # Apply principal component analysis (PCA)
    pca = PCA(n_components=50)
    X_pca = pca.fit_transform(X_scaled)

    # Fit a linear regression model to the PCA components
    model = LinearRegression(fit_intercept=False)
    model.fit(X_pca, np.log1p(X))

    # Predicted counts after denoising
    predicted_counts = model.predict(X_pca) + 1

    # Reverse the transformation back to raw count space
    predicted_counts_unscaled = scaler.inverse_transform(predicted_counts.reshape(-1, 1)).flatten()

    return predicted_counts_unscaled
