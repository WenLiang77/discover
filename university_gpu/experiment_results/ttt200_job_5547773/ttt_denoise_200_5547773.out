def magic_denoise(X, budget_s=2, random_state=None, knn=20, t=1.0, n_pca=10, solver='auto', decay=0.99, knn_max=100, n_jobs=-1):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    if budget_s == 'auto':
        budget_s = int(np.sqrt(X.shape[0]))

    scaler = StandardScaler(with_mean=False, with_std=True).fit(X)
    X_scaled = scaler.transform(X)

    model = Ridge(alpha=decay, solver=solver, random_state=random_state, n_jobs=n_jobs)
    model.fit(X_scaled, np.log1p(X))

    # Predict and apply exponential transformation
    denoised_X = np.exp(model.predict(X_scaled))
    
    # Apply thresholding to handle low non-zero values
    denoised_X = np.clip(denoised_X, 0.0, None)

    # Reverse normalization
    denoised_X = denoised_X * scaler.scale_
    denoised_X += scaler.mean_

    # Check Poisson constraints
    poisson_loss = poisson(penalty=denoised_X, mean=X).logpmf(X).sum()
    if poisson_loss > 0.031739:
        raise ValueError("Poisson loss exceeds the magic baseline.")

    return denoised_X

