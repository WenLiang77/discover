def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Normalize by the square root of total counts
    total_counts = np.sum(X)
    if total_counts == 0:
        return np.zeros_like(X)
    
    normalized_counts = X / np.sqrt(total_counts)
    
    # Apply a Gaussian noise model
    noise = np.random.normal(0, 1, X.shape)
    denoised_counts = normalized_counts * np.exp(noise)
    
    # Ensure denoised counts are non-negative
    denoised_counts = np.maximum(denoised_counts, 0.0)
    
    # Apply a square root transform to stabilize Poisson distribution
    denoised_counts = np.sqrt(denoised_counts)
    
    # Reapply the original normalization
    denoised_counts = denoised_counts / np.sqrt(total_counts)
    
    # Clip to ensure values are between 0 and 1 (for Poisson likelihood)
    denoised_counts = np.clip(denoised_counts, 0.0, 1.0)
    
    return denoised_counts
