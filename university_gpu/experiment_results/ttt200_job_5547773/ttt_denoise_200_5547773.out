def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Reverse normalization
    X /= np.sum(X)

    # Apply square root transformation
    X = np.sqrt(X)

    # Normalize to log-normal distribution
    X = np.log(X + 1e-6)

    # Clip values to ensure they remain positive
    X = np.clip(X, a_min=0.0, a_max=None)

    # Use linear regression to fit a model to the data
    scaler = StandardScaler()
    normalized_data = scaler.fit_transform(X.reshape(-1, 1)).reshape(X.shape)
    model = LinearRegression().fit(normalized_data, X.flatten())
    denoised_data = model.predict(normalized_data).reshape(X.shape)

    # Ensure the denoised data is finite and non-negative
    denoised_data = np.clip(denoised_data, a_min=0.0, a_max=None)

    return denoised_data
