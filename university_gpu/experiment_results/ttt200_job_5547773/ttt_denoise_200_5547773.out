Generated code preview:
def magic_denoise(X, **kwargs):
    X = np.asarray(X, dtype=float)
    X = np.nan_to_num(X, nan=0.0, posinf=0.0, neginf=0.0)
    X = np.maximum(X, 0.0)

    # Initial guess for denoised data
    initial_guess = np.mean(X)

    # Define the objective function for minimizing MSE in log-normalized space
    def objective_function(x):
        normalized_counts = x / np.mean(x)
        mse = np.mean((normalized_counts - np.log(normalized_counts))**2)
        return mse

    # Perform optimization
    result = minimize(objective_function, initial_guess)

    # Check if the solution satisfies the Poisson constraint
    if result.fun > 0.037002:
        return None  # Solution does not satisfy the Poisson constraint

    # Return denoised counts
    denoised_counts = result.x * np.mean(X)
    return denoised_counts.astype(np.int64)
