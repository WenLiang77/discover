import numpy as np
from scipy.stats import norm
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from scipy.spatial.distance import cdist
from scipy.optimize import minimize_scalar

# Define the custom objective function
def custom_objective(params, X, y):
    # Unpack parameters
    alpha, beta = params
    
    # Predicted values
    predicted = alpha * np.log(y + 1) + beta
    
    # Calculate mean squared error and Poisson loss
    mse = np.mean((y - predicted) ** 2)
    poisson_loss = np.sum((y - predicted) * np.exp(-predicted))
    
    # Return the sum of MSE and Poisson loss
    return mse + poisson_loss

# Define the initial guess for parameters
initial_guess = [1.0, 0.0]

# Define the bounds for parameters
bounds = [(0.0, None), (0.0, None)]

# Perform the minimization
result = minimize_scalar(custom_objective, args=(X, y), method='bounded', bounds=bounds)

# Extract the optimized parameters
alpha_opt, beta_opt = result.x

# Predict the denoised counts
denoised_counts = alpha_opt * np.log(y + 1) + beta_opt

# Ensure denoised counts are finite and non-negative
denoised_counts[denoised_counts < 0] = 0

return denoised_counts
