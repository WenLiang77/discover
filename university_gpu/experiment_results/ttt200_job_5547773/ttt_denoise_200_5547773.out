def magic_denoise(X, **kwargs):
    # Normalize raw data
    scaler = StandardScaler()
    X_normalized = scaler.fit_transform(X)

    # Initialize weights
    weights = np.ones_like(X_normalized, dtype=float)

    # Define objective function
    def objective_function(weights):
        # Calculate predicted expression
        predicted_expression = np.dot(X_normalized, weights)

        # Compute mean squared error and Poisson loss
        mse = np.mean((predicted_expression - X)**2)
        poisson_loss = poisson.logpmf(X, predicted_expression).sum()

        return mse + poisson_loss

    # Define constraints
    constraints = [
        {'type': 'ineq', 'fun': lambda x: 0.97 * (x - 0.257575)}
    ]

    # Optimize weights
    result = minimize(objective_function, weights, method='SLSQP', bounds=(0, None), constraints=constraints, options={'maxiter': 1000})

    if result.success:
        denoised_X = np.dot(X_normalized, result.x)
        denoised_X = scaler.inverse_transform(denoised_X)
    else:
        denoised_X = X

    return denoised_X

